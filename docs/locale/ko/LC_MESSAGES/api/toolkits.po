#: cefweaver.ui.toolkits.pywin32.Win32Browser:33 of
msgid "The client width in logical pixels."
msgstr "논리 픽셀 단위의 클라이언트 너비."

#: cefweaver.ui.toolkits.pywin32.Win32Browser:35 of
msgid "The client height in logical pixels."
msgstr "논리 픽셀 단위의 클라이언트 높이."

#: cefweaver.ui.toolkits.pywin32.Win32Browser:37 of
msgid "``(width, height)`` of the client area in device pixels."
msgstr "장치 픽셀 단위의 클라이언트 영역 ``(width, height)``."

#: cefweaver.ui.toolkits.pywin32.Win32Browser:39 of
msgid "The DPI of the window divided by 96."
msgstr "창의 DPI를 96으로 나눈 값."

#: cefweaver.ui.toolkits.pywin32.Win32Browser:41 of
msgid "``(width, height)`` of the primary screen in pixels."
