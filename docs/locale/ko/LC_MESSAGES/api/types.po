msgstr "components/update_client/update_client_errors.h의 update_client::Error 값에 대응합니다."

#: cefweaver.types.ComponentUpdateError.NONE:1 cefweaver.types.ErrorCode.NONE:1 of
msgid "No error."
msgstr "오류 없음."

#: cefweaver.types.ComponentUpdateError.UPDATE_IN_PROGRESS:1 of
msgid "An update is already in progress for this component."
msgstr "이 구성 요소의 업데이트가 이미 진행 중입니다."

#: cefweaver.types.ComponentUpdateError.UPDATE_CANCELED:1 of
msgid "The update was canceled."
msgstr "업데이트가 취소되었습니다."

#: cefweaver.types.ComponentUpdateError.RETRY_LATER:1 of
msgid "The update should be retried later."
msgstr "업데이트를 나중에 다시 시도해야 합니다."

#: cefweaver.types.ComponentUpdateError.SERVICE_ERROR:1 of
msgid "A service error occurred."
msgstr "서비스 오류가 발생했습니다."

#: cefweaver.types.ComponentUpdateError.UPDATE_CHECK_ERROR:1 of
msgid "An error occurred during the update check."
msgstr "업데이트 확인 중 오류가 발생했습니다."

#: cefweaver.types.ComponentUpdateError.CRX_NOT_FOUND:1 of
msgid "The component was not found."
msgstr "구성 요소를 찾을 수 없습니다."

#: cefweaver.types.ComponentUpdateError.INVALID_ARGUMENT:1 of
msgid "An invalid argument was provided."
msgstr "유효하지 않은 인자가 제공되었습니다."

#: cefweaver.types.ComponentUpdateError.BAD_CRX_DATA_CALLBACK:1 of
msgid "Bad CRX data callback."
msgstr "잘못된 CRX 데이터 콜백."

#: cefweaver.types.enums.ComponentUpdatePriority:1 of
msgid "Component update priority."
msgstr "구성 요소 업데이트 우선순위."

#: cefweaver.types.enums.ComponentUpdatePriority:3 of
msgid "Maps to component_updater::OnDemandUpdater::Priority."
msgstr "component_updater::OnDemandUpdater::Priority에 대응합니다."

#: cefweaver.types.ComponentUpdatePriority.BACKGROUND:1 of
msgid "Background priority."
msgstr "백그라운드 우선순위."

#: cefweaver.types.ComponentUpdatePriority.BACKGROUND:3 of
msgid "Update requests may be queued."
msgstr "업데이트 요청이 대기열에 들어갈 수 있습니다."

#: cefweaver.types.ComponentUpdatePriority.FOREGROUND:1 of
msgid "Foreground priority."
msgstr "포그라운드 우선순위."

#: cefweaver.types.ComponentUpdatePriority.FOREGROUND:3 of
msgid "Update requests are processed immediately."
msgstr "업데이트 요청이 즉시 처리됩니다."

#: cefweaver.types.enums.CompositionUnderlineStyle:1 of
msgid "Composition underline style."
msgstr "조합 밑줄 스타일."

#: cefweaver.types.enums.ContentSettingTypes:1 of
msgid "Supported content setting types."
msgstr "지원되는 콘텐츠 설정 타입."

#: cefweaver.types.enums.ContentSettingTypes:3 of
msgid ""
"Some types are platform-specific or only supported with Chrome style. Should be kept in sync with"
" Chromium's ContentSettingsType type."
msgstr "일부 타입은 플랫폼에 따라 다르거나 Chrome 스타일에서만 지원됩니다. Chromium의 ContentSettingsType 타입과 동기화된 상태로 유지되어야 합니다."

#: cefweaver.types.ContentSettingTypes.COOKIES:1 of
msgid "This setting governs whether cookies are enabled by the user in the provided context."
msgstr "이 설정은 주어진 컨텍스트에서 사용자가 쿠키를 사용하도록 설정했는지 여부를 결정합니다."

#: cefweaver.types.ContentSettingTypes.COOKIES:3 of
msgid ""
"However, it may be overridden by other settings. This enum should NOT be read directly to "
"determine whether cookies are enabled; the client should instead rely on the CookieSettings API."
msgstr ""
"그러나 다른 설정에 의해 재정의될 수 있습니다. 쿠키가 사용 설정되었는지 판단하기 위해 이 열거형을 직접 읽어서는 안 되며, 클라이언트는 대신 CookieSettings "
"API를 사용해야 합니다."

#: cefweaver.types.ContentSettingTypes.POPUPS:1 of
msgid "This setting governs both popups and unwanted redirects like tab-unders and framebusting."
msgstr "이 설정은 팝업과 tab-under, framebusting 같은 원치 않는 리디렉션을 모두 관리합니다."

#: cefweaver.types.ContentSettingTypes.MIDI_SYSEX:1 of
msgid "Advanced device-specific functions on MIDI devices."
msgstr "MIDI 장치의 고급 장치별 기능."

#: cefweaver.types.ContentSettingTypes.MIDI_SYSEX:3 of
msgid ""
"MIDI-SysEx communications can be used for changing the MIDI device's persistent state such as "
"firmware."
msgstr "MIDI-SysEx 통신은 펌웨어 같은 MIDI 장치의 영구 상태를 변경하는 데 사용될 수 있습니다."

#: cefweaver.types.ContentSettingTypes.ADS_DATA:1 of
msgid ""
"Website setting which stores metadata for the subresource filter to aid in decisions for whether "
"or not to show the UI."
msgstr "UI를 표시할지 결정하는 데 도움을 주도록 하위 리소스 필터의 메타데이터를 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.MIDI:1 of
msgid "MIDI stands for Musical Instrument Digital Interface."
msgstr "MIDI는 Musical Instrument Digital Interface의 약자입니다."

#: cefweaver.types.ContentSettingTypes.MIDI:3 of
msgid ""
"It is a standard that allows electronic musical instruments, computers, and other devices to "
"communicate with each other."
msgstr "전자 악기, 컴퓨터 및 기타 장치가 서로 통신할 수 있게 하는 표준입니다."

#: cefweaver.types.ContentSettingTypes.PASSWORD_PROTECTION:1 of
msgid "This content setting type is for caching password protection service's verdicts of each origin."
msgstr "이 콘텐츠 설정 타입은 각 origin에 대한 암호 보호 서비스의 판정을 캐시하기 위한 것입니다."

#: cefweaver.types.ContentSettingTypes.MEDIA_ENGAGEMENT:1 of
msgid "Website setting which stores engagement data for media related to a specific origin."
msgstr "특정 origin과 관련된 미디어의 참여 데이터를 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.SOUND:1 of
msgid "Content setting which stores whether or not the site can play audible sound."
msgstr "사이트가 들리는 소리를 재생할 수 있는지 여부를 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.SOUND:3 of
msgid "This will not block playback but instead the user will not hear it."
msgstr "이 설정은 재생을 막지 않고 사용자가 소리를 듣지 못하게 합니다."

#: cefweaver.types.ContentSettingTypes.CLIENT_HINTS:1 of
msgid ""
"Website setting which stores the list of client hints that the origin requested the browser to "
"remember."
msgstr "origin이 브라우저에 기억하도록 요청한 client hint의 목록을 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.CLIENT_HINTS:3 of
msgid ""
"The browser is expected to send all client hints in the HTTP request headers for every resource "
"requested from that origin."
msgstr "브라우저는 해당 origin에 요청하는 모든 리소스의 HTTP 요청 헤더에 모든 client hint를 보내야 합니다."

#: cefweaver.types.ContentSettingTypes.SENSORS:1 of
msgid ""
"Generic Sensor API covering ambient-light-sensor, accelerometer, gyroscope and magnetometer are "
"all mapped to a single content_settings_type."
msgstr ""
"ambient-light-sensor, accelerometer, gyroscope, magnetometer를 포함하는 Generic Sensor API는 모두 하나의 "
"content_settings_type에 대응합니다."

#: cefweaver.types.ContentSettingTypes.SENSORS:3 of
msgid ""
"Setting for the Generic Sensor API covering ambient-light-sensor, accelerometer, gyroscope and "
"magnetometer. These are all mapped to a single ContentSettingsType."
msgstr ""
"ambient-light-sensor, accelerometer, gyroscope, magnetometer를 포함하는 Generic Sensor API의 설정. 이들은 모두"
" 하나의 ContentSettingsType에 대응합니다."

#: cefweaver.types.ContentSettingTypes.DEPRECATED_ACCESSIBILITY_EVENTS:1 of
msgid ""
"Content setting which stores whether or not the user has granted the site permission to respond "
"to accessibility events, which can be used to provide a custom accessibility experience."
msgstr "사용자가 사이트에 접근성 이벤트에 응답할 권한을 부여했는지 여부를 저장하는 콘텐츠 설정으로, 사용자 지정 접근성 환경을 제공하는 데 사용될 수 있습니다."

#: cefweaver.types.ContentSettingTypes.DEPRECATED_ACCESSIBILITY_EVENTS:3 of
msgid ""
"Requires explicit user consent because some users may not want sites to know they're using "
"assistive technology. Deprecated in M131."
msgstr "일부 사용자는 사이트가 자신이 보조 기술을 사용한다는 것을 알기를 원하지 않을 수 있으므로 사용자의 명시적 동의가 필요합니다. M131에서 사용 중단되었습니다."

#: cefweaver.types.ContentSettingTypes.PAYMENT_HANDLER:1 of
msgid "Used to store whether to allow a website to install a payment handler."
msgstr "웹사이트가 결제 핸들러를 설치하도록 허용할지 여부를 저장하는 데 사용됩니다."

#: cefweaver.types.ContentSettingTypes.USB_GUARD:1 of
msgid "Content setting which stores whether to allow sites to ask for permission to access USB devices."
msgstr "사이트가 USB 장치에 접근할 권한을 요청하도록 허용할지 여부를 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.USB_GUARD:3 of
msgid "If this is allowed specific device permissions are stored under USB_CHOOSER_DATA."
msgstr "이 설정이 허용되면 특정 장치 권한은 USB_CHOOSER_DATA 아래에 저장됩니다."

#: cefweaver.types.ContentSettingTypes.BACKGROUND_FETCH:1
#: cefweaver.types.ContentSettingTypes.PERIODIC_BACKGROUND_SYNC:1 of
msgid "Nothing is stored in this setting at present."
msgstr "현재 이 설정에는 아무것도 저장되지 않습니다."

#: cefweaver.types.ContentSettingTypes.BACKGROUND_FETCH:3 of
msgid ""
"Please refer to BackgroundFetchPermissionContext for details on how this permission is "
"ascertained."
msgstr "이 권한이 확인되는 방식에 대한 자세한 내용은 BackgroundFetchPermissionContext를 참조하십시오."

#: cefweaver.types.ContentSettingTypes.INTENT_PICKER_DISPLAY:1 of
msgid ""
"Website setting which stores the amount of times the user has dismissed intent picker UI without "
"explicitly choosing an option."
msgstr "사용자가 옵션을 명시적으로 선택하지 않고 intent picker UI를 닫은 횟수를 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.IDLE_DETECTION:1 of
msgid "Used to store whether to allow a website to detect user active/idle state."
msgstr "웹사이트가 사용자의 활성/유휴 상태를 감지하도록 허용할지 여부를 저장하는 데 사용됩니다."

#: cefweaver.types.ContentSettingTypes.SERIAL_GUARD:1 of
msgid "Content settings for access to serial ports."
msgstr "직렬 포트 접근에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.SERIAL_GUARD:3 of
msgid ""
"The \"guard\" content setting stores whether to allow sites to ask for permission to access a "
"port. The permissions granted to access particular ports are stored in the \"chooser data\" "
"website setting."
msgstr ""
"\"guard\" 콘텐츠 설정은 사이트가 포트에 접근할 권한을 요청하도록 허용할지 여부를 저장합니다. 특정 포트에 접근하도록 부여된 권한은 \"chooser data\" "
"웹사이트 설정에 저장됩니다."

#: cefweaver.types.ContentSettingTypes.PERIODIC_BACKGROUND_SYNC:3 of
msgid ""
"Please refer to PeriodicBackgroundSyncPermissionContext for details on how this permission is "
"ascertained. This content setting is not registered because it does not require access to any "
"existing providers."
msgstr ""
"이 권한이 확인되는 방식에 대한 자세한 내용은 PeriodicBackgroundSyncPermissionContext를 참조하십시오. 이 콘텐츠 설정은 기존 provider에"
" 대한 접근이 필요하지 않으므로 등록되지 않습니다."

#: cefweaver.types.ContentSettingTypes.BLUETOOTH_SCANNING:1 of
msgid ""
"Content setting which stores whether to allow sites to ask for permission to do Bluetooth "
"scanning."
msgstr "사이트가 Bluetooth 스캔 권한을 요청하도록 허용할지 여부를 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.HID_GUARD:1 of
msgid "Content settings for access to HID devices."
msgstr "HID 장치 접근에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.HID_GUARD:3 of
msgid ""
"The \"guard\" content setting stores whether to allow sites to ask for permission to access a "
"device. The permissions granted to access particular devices are stored in the \"chooser data\" "
"website setting."
msgstr ""
"\"guard\" 콘텐츠 설정은 사이트가 장치에 접근할 권한을 요청하도록 허용할지 여부를 저장합니다. 특정 장치에 접근하도록 부여된 권한은 \"chooser data\" "
"웹사이트 설정에 저장됩니다."

#: cefweaver.types.ContentSettingTypes.WAKE_LOCK_SCREEN:1 of
msgid "Wake Lock API, which has two lock types: screen and system locks."
msgstr "화면 잠금과 시스템 잠금의 두 가지 잠금 타입을 가진 Wake Lock API."

#: cefweaver.types.ContentSettingTypes.WAKE_LOCK_SCREEN:3 of
msgid ""
"Currently, screen locks do not need any additional permission, and system locks are always denied"
" while the right UI is worked out."
msgstr "현재 화면 잠금에는 추가 권한이 필요하지 않으며, 시스템 잠금은 적절한 UI가 마련될 때까지 항상 거부됩니다."

#: cefweaver.types.ContentSettingTypes.LEGACY_COOKIE_ACCESS:1 of
msgid "Legacy SameSite cookie behavior."
msgstr "레거시 SameSite 쿠키 동작."

#: cefweaver.types.ContentSettingTypes.LEGACY_COOKIE_ACCESS:3 of
msgid ""
"This disables SameSite=Lax-by-default, SameSite=None requires Secure, and Schemeful Same-Site, "
"forcing the legacy behavior wherein 1) cookies that don't specify SameSite are treated as "
"SameSite=None, 2) SameSite=None cookies are not required to be Secure, and 3) schemeful same-site"
" is not active."
msgstr ""
"이 설정은 SameSite=Lax-by-default, SameSite=None requires Secure, Schemeful Same-Site를 비활성화하여 다음의 레거시"
" 동작을 강제합니다. 1) SameSite를 지정하지 않은 쿠키는 SameSite=None으로 취급되고, 2) SameSite=None 쿠키가 Secure일 필요가 없으며, "
"3) schemeful same-site가 활성화되지 않습니다."

#: cefweaver.types.ContentSettingTypes.LEGACY_COOKIE_ACCESS:8 of
msgid ""
"This will also be used to revert to legacy behavior when future changes in cookie handling are "
"introduced."
msgstr "또한 쿠키 처리에 향후 변경이 도입될 때 레거시 동작으로 되돌리는 데에도 사용됩니다."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_WRITE_GUARD:1 of
msgid ""
"Content settings which stores whether to allow sites to ask for permission to save changes to an "
"original file selected by the user through the File System Access API."
msgstr "사이트가 File System Access API를 통해 사용자가 선택한 원본 파일에 변경 사항을 저장할 권한을 요청하도록 허용할지 여부를 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.NFC:1 of
msgid "Used to store whether to allow a website to exchange data with NFC devices."
msgstr "웹사이트가 NFC 장치와 데이터를 교환하도록 허용할지 여부를 저장하는 데 사용됩니다."

#: cefweaver.types.ContentSettingTypes.BLUETOOTH_CHOOSER_DATA:1 of
msgid "Website setting to store permissions granted to access particular Bluetooth devices."
msgstr "특정 Bluetooth 장치에 접근하도록 부여된 권한을 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.CLIPBOARD_READ_WRITE:1 of
msgid ""
"Full access to the system clipboard (sanitized read without user gesture, and unsanitized read "
"and write with user gesture)."
msgstr "시스템 클립보드에 대한 전체 접근(사용자 제스처 없는 정제된 읽기, 사용자 제스처가 있는 정제되지 않은 읽기와 쓰기)."

#: cefweaver.types.ContentSettingTypes.CLIPBOARD_SANITIZED_WRITE:1 of
msgid ""
"This is special-cased in the permissions layer to always allow, and as such doesn't have "
"associated prefs data."
msgstr "권한 계층에서 항상 허용하도록 특별 처리되므로 연결된 prefs 데이터가 없습니다."

#: cefweaver.types.ContentSettingTypes.SAFE_BROWSING_URL_CHECK_DATA:1 of
msgid ""
"This content setting type is for caching safe browsing real time url check's verdicts of each "
"origin."
msgstr "이 콘텐츠 설정 타입은 각 origin에 대한 safe browsing 실시간 url 확인의 판정을 캐시하기 위한 것입니다."

#: cefweaver.types.ContentSettingTypes.VR:1 of
msgid "Used to store whether a site is allowed to request AR or VR sessions with the WebXr Device API."
msgstr "사이트가 WebXr Device API로 AR 또는 VR 세션을 요청할 수 있는지 여부를 저장하는 데 사용됩니다."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_READ_GUARD:1 of
msgid ""
"Content setting which stores whether to allow site to open and read files and directories "
"selected through the File System Access API."
msgstr "사이트가 File System Access API를 통해 선택된 파일과 디렉터리를 열고 읽도록 허용할지 여부를 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.STORAGE_ACCESS:1 of
msgid "Access to first party storage in a third-party context."
msgstr "서드 파티 컨텍스트에서 퍼스트 파티 저장소에 접근."

#: cefweaver.types.ContentSettingTypes.STORAGE_ACCESS:3 of
msgid ""
"Exceptions are scoped to the combination of requesting/top-level origin, and are managed through "
"the Storage Access API. For the time being, this content setting exists in parallel to third-"
"party cookie rules stored in COOKIES."
msgstr ""
"예외는 요청 origin과 최상위 origin의 조합으로 범위가 정해지며 Storage Access API를 통해 관리됩니다. 당분간 이 콘텐츠 설정은 쿠키에 저장된 서드 "
"파티 쿠키 규칙과 별도로 존재합니다."

#: cefweaver.types.ContentSettingTypes.CAMERA_PAN_TILT_ZOOM:1 of
msgid "Content setting which stores whether to allow a site to control camera movements."
msgstr "사이트가 카메라 움직임을 제어하도록 허용할지 여부를 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.CAMERA_PAN_TILT_ZOOM:3 of
msgid "It does not give access to camera."
msgstr "카메라에 대한 접근 권한을 주지는 않습니다."

#: cefweaver.types.ContentSettingTypes.WINDOW_MANAGEMENT:1 of
msgid "Content setting for Screen Enumeration and Screen Detail functionality."
msgstr "Screen Enumeration과 Screen Detail 기능에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.WINDOW_MANAGEMENT:3 of
msgid ""
"Permits access to detailed multi-screen information, like size and position. Permits placing "
"fullscreen and windowed content on specific screens. See also: https://w3c.github.io/window-"
"placement"
msgstr ""
"크기와 위치 같은 상세한 다중 화면 정보에 대한 접근을 허용합니다. 전체 화면 콘텐츠와 창 콘텐츠를 특정 화면에 배치하는 것을 허용합니다. 다음도 참조하십시오: "
"https://w3c.github.io/window-placement"

#: cefweaver.types.ContentSettingTypes.INSECURE_PRIVATE_NETWORK_DEPRECATED:1 of
msgid "Stores whether to allow insecure websites to make private network requests."
msgstr "안전하지 않은 웹사이트가 사설 네트워크 요청을 하도록 허용할지 여부를 저장합니다."

#: cefweaver.types.ContentSettingTypes.INSECURE_PRIVATE_NETWORK_DEPRECATED:3 of
msgid "See also: https://wicg.github.io/cors-rfc1918 Set through enterprise policies only."
msgstr "다음도 참조하십시오: https://wicg.github.io/cors-rfc1918 엔터프라이즈 정책으로만 설정됩니다."

#: cefweaver.types.ContentSettingTypes.LOCAL_FONTS:1 of
msgid ""
"Content setting which stores whether or not a site can access low-level locally installed font "
"data using the Local Fonts Access API."
msgstr "사이트가 Local Fonts Access API를 사용하여 로컬에 설치된 글꼴의 저수준 데이터에 접근할 수 있는지 여부를 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.PERMISSION_AUTOREVOCATION_DATA:1 of
msgid "Stores per-origin state for permission auto-revocation (for all permission types)."
msgstr "권한 자동 해지(모든 권한 타입 대상)를 위한 origin별 상태를 저장합니다."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_LAST_PICKED_DIRECTORY:1 of
msgid ""
"Stores per-origin state of the most recently selected directory for the use by the File System "
"Access API."
msgstr "File System Access API에서 사용하도록 가장 최근에 선택한 디렉터리의 origin별 상태를 저장합니다."

#: cefweaver.types.ContentSettingTypes.DISPLAY_CAPTURE:1 of
msgid "Controls access to the getDisplayMedia API."
msgstr "getDisplayMedia API에 대한 접근을 제어합니다."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_ACCESS_CHOOSER_DATA:1 of
msgid ""
"Website setting to store permissions metadata granted to paths on the local file system via the "
"File System Access API."
msgstr "File System Access API를 통해 로컬 파일 시스템의 경로에 부여된 권한의 메타데이터를 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_ACCESS_CHOOSER_DATA:3 of
msgid ""
"``file_system_write_guard`` is the corresponding \"guard\" setting. The stored data represents "
"valid permission only if ``file_system_access_extended_permission`` is enabled via user opt-in. "
"Otherwise, they represent \"recently granted but revoked permission\", which are used to restore "
"the permission."
msgstr ""
"``file_system_write_guard``\\ 는 이에 대응하는 \"guard\" 설정입니다. 저장된 데이터는 사용자가 동의하여 "
"``file_system_access_extended_permission``\\ 이 활성화된 경우에만 유효한 권한을 나타냅니다. 그렇지 않으면 권한을 복원하는 데 사용되는 "
"\"최근에 부여되었으나 해지된 권한\"을 나타냅니다."

#: cefweaver.types.ContentSettingTypes.FEDERATED_IDENTITY_SHARING:1 of
msgid ""
"Stores a grant that allows a relying party to send a request for identity information to "
"specified identity providers, potentially through any anti-tracking measures that would otherwise"
" prevent it."
msgstr ""
"신뢰 당사자가 지정된 ID 공급자에게 ID 정보 요청을 보낼 수 있도록 허용하는 권한 부여를 저장하며, 이는 그렇지 않았다면 요청을 막았을 추적 방지 조치를 통과할 수도 "
"있습니다."

#: cefweaver.types.ContentSettingTypes.FEDERATED_IDENTITY_SHARING:3 of
msgid "This setting is associated with the relying party's origin."
msgstr "이 설정은 신뢰 당사자의 origin과 연결됩니다."

#: cefweaver.types.ContentSettingTypes.JAVASCRIPT_JIT:1 of
msgid "Whether to use the v8 optimized JIT for running JavaScript on the page."
msgstr "페이지에서 JavaScript를 실행하는 데 v8 최적화 JIT를 사용할지 여부."

#: cefweaver.types.ContentSettingTypes.HTTP_ALLOWED:1 of
msgid "Content setting which stores user decisions to allow loading a site over HTTP."
msgstr "HTTP를 통한 사이트 로드를 허용하는 사용자 결정을 저장하는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.HTTP_ALLOWED:3 of
msgid ""
"Entries are added by hostname when a user bypasses the HTTPS-First Mode interstitial warning when"
" a site does not support HTTPS. Allowed hosts are exact hostname matches -- subdomains of a host "
"on the allowlist must be separately allowlisted."
msgstr ""
"사이트가 HTTPS를 지원하지 않을 때 사용자가 HTTPS-First Mode 중간 경고를 우회하면 호스트 이름별로 항목이 추가됩니다. 허용된 호스트는 호스트 이름이 정확히 "
"일치하는 것입니다. 허용 목록에 있는 호스트의 하위 도메인은 별도로 허용 목록에 추가해야 합니다."

#: cefweaver.types.ContentSettingTypes.FORMFILL_METADATA:1 of
msgid "Stores metadata related to form fill, such as e.g."
msgstr "양식 채우기와 관련된 메타데이터를 저장합니다. 예를 들어"

#: cefweaver.types.ContentSettingTypes.FORMFILL_METADATA:3 of
msgid "whether user data was autofilled on a specific website."
msgstr "특정 웹사이트에서 사용자 데이터가 자동으로 채워졌는지 여부."

#: cefweaver.types.ContentSettingTypes.DEPRECATED_FEDERATED_IDENTITY_ACTIVE_SESSION:1 of
msgid ""
"Setting to indicate that there is an active federated sign-in session between a specified relying"
" party and a specified identity provider for a specified account."
msgstr "지정된 신뢰 당사자와 지정된 ID 공급자 사이에 지정된 계정에 대한 활성 연합 로그인 세션이 있음을 나타내는 설정."

#: cefweaver.types.ContentSettingTypes.DEPRECATED_FEDERATED_IDENTITY_ACTIVE_SESSION:3 of
msgid ""
"When this is present it allows access to session management capabilities between the sites. This "
"setting is associated with the relying party's origin. Obsolete on Nov 2023."
msgstr "이 설정이 있으면 사이트 간 세션 관리 기능에 접근할 수 있습니다. 이 설정은 신뢰 당사자의 origin과 연결됩니다. 2023년 11월에 폐기되었습니다."

#: cefweaver.types.ContentSettingTypes.AUTO_DARK_WEB_CONTENT:1 of
msgid "Setting to indicate whether Chrome should automatically apply darkening to web content."
msgstr "Chrome이 웹 콘텐츠에 자동으로 어둡게 하기를 적용할지 여부를 나타내는 설정."

#: cefweaver.types.ContentSettingTypes.REQUEST_DESKTOP_SITE:1 of
msgid ""
"Setting to indicate whether Chrome should request the desktop view of a site instead of the "
"mobile one."
msgstr "Chrome이 사이트의 모바일 버전 대신 데스크톱 버전을 요청할지 여부를 나타내는 설정."

#: cefweaver.types.ContentSettingTypes.FEDERATED_IDENTITY_API:1 of
msgid "Setting to indicate whether browser should allow signing into a website via the browser FedCM API."
msgstr "브라우저가 브라우저 FedCM API를 통해 웹사이트에 로그인하는 것을 허용할지 여부를 나타내는 설정."

#: cefweaver.types.ContentSettingTypes.NOTIFICATION_INTERACTIONS:1 of
msgid "Stores notification interactions per origin for the past 90 days."
msgstr "지난 90일 동안의 origin별 알림 상호작용을 저장합니다."

#: cefweaver.types.ContentSettingTypes.NOTIFICATION_INTERACTIONS:3 of
msgid ""
"Interactions per origin are pre-aggregated over seven-day windows: A notification interaction or "
"display is assigned to the last Monday midnight in local time."
msgstr "origin별 상호작용은 7일 단위 창으로 미리 집계됩니다. 알림 상호작용이나 표시는 현지 시간 기준 직전 월요일 자정에 할당됩니다."

#: cefweaver.types.ContentSettingTypes.REDUCED_ACCEPT_LANGUAGE:1 of
msgid ""
"Website setting which stores the last reduced accept language negotiated for a given origin, to "
"be used on future visits to the origin."
msgstr "주어진 origin에 대해 협상된 마지막 축약된 accept language를 저장하여 이후 해당 origin 방문 시 사용하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.NOTIFICATION_PERMISSION_REVIEW:1 of
msgid ""
"Website setting which is used for NotificationPermissionReviewService to store origin blocklist "
"from review notification permissions feature."
msgstr "알림 권한 검토 기능의 origin 차단 목록을 저장하기 위해 NotificationPermissionReviewService에서 사용하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.FEDERATED_IDENTITY_IDENTITY_PROVIDER_SIGNIN_STATUS:1 of
msgid ""
"Website setting which stores whether the browser has observed the user signing into an identity-"
"provider based on observing the IdP-SignIn-Status HTTP header."
msgstr "IdP-SignIn-Status HTTP 헤더를 관찰하여 브라우저가 사용자가 ID 공급자에 로그인한 것을 관찰했는지 여부를 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.REVOKED_UNUSED_SITE_PERMISSIONS:1 of
msgid ""
"Website setting which is used for RevokedPermissionsService to store revoked permissions of "
"unused sites from unused site permissions feature."
msgstr "사용하지 않는 사이트 권한 기능에서 사용하지 않는 사이트의 해지된 권한을 저장하기 위해 RevokedPermissionsService에서 사용하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.TOP_LEVEL_STORAGE_ACCESS:1 of
msgid "Similar to STORAGE_ACCESS, but applicable at the page-level rather than being specific to a frame."
msgstr "STORAGE_ACCESS와 비슷하지만 frame에 한정되지 않고 페이지 수준에서 적용됩니다."

#: cefweaver.types.ContentSettingTypes.FEDERATED_IDENTITY_AUTO_REAUTHN_PERMISSION:1 of
msgid "Setting to indicate whether user has opted in to allowing auto re-authn via the FedCM API."
msgstr "사용자가 FedCM API를 통한 자동 재인증 허용에 동의했는지 여부를 나타내는 설정."

#: cefweaver.types.ContentSettingTypes.FEDERATED_IDENTITY_IDENTITY_PROVIDER_REGISTRATION:1 of
msgid ""
"Website setting which stores whether the user has explicitly registered a website as an identity-"
"provider."
msgstr "사용자가 웹사이트를 ID 공급자로 명시적으로 등록했는지 여부를 저장하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.ANTI_ABUSE:1 of
msgid "Content setting which is used to indicate whether anti-abuse functionality should be enabled."
msgstr "악용 방지 기능을 활성화할지 여부를 나타내는 데 사용되는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.HTTPS_ENFORCED:1 of
msgid "Used to indicate whether HTTPS-First Mode is enabled on the hostname."
msgstr "호스트 이름에서 HTTPS-First Mode가 활성화되어 있는지 여부를 나타내는 데 사용됩니다."

#: cefweaver.types.ContentSettingTypes.ALL_SCREEN_CAPTURE:1 of
msgid "Setting for enabling the ``getAllScreensMedia`` API."
msgstr "``getAllScreensMedia`` API를 활성화하기 위한 설정."

#: cefweaver.types.ContentSettingTypes.ALL_SCREEN_CAPTURE:3 of
msgid "Spec link: https://github.com/screen-share/capture-all-screens"
msgstr "사양 링크: https://github.com/screen-share/capture-all-screens"

#: cefweaver.types.ContentSettingTypes.COOKIE_CONTROLS_METADATA:1 of
msgid "Stores per origin metadata for cookie controls."
msgstr "쿠키 제어를 위한 origin별 메타데이터를 저장합니다."

#: cefweaver.types.ContentSettingTypes.AUTO_PICTURE_IN_PICTURE:1 of
msgid ""
"Content setting used to indicate whether entering picture-in-picture automatically should be "
"enabled."
msgstr "화상 속 화상(picture-in-picture)에 자동으로 진입하는 것을 활성화할지 여부를 나타내는 데 사용되는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_ACCESS_EXTENDED_PERMISSION:1 of
msgid ""
"Whether user has opted into keeping file/directory permissions persistent between visits for a "
"given origin."
msgstr "사용자가 주어진 origin에 대해 방문 간에 파일/디렉터리 권한을 유지하는 것에 동의했는지 여부."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_ACCESS_EXTENDED_PERMISSION:3 of
msgid ""
"When enabled, permission metadata stored under ``file_system_access_chooser_data`` can auto-grant"
" incoming permission request."
msgstr "활성화되면 ``file_system_access_chooser_data``\\ 에 저장된 권한 메타데이터가 들어오는 권한 요청을 자동으로 허용할 수 있습니다."

#: cefweaver.types.ContentSettingTypes.FILE_SYSTEM_ACCESS_RESTORE_PERMISSION:1 of
msgid ""
"Whether the FSA Persistent Permissions restore prompt is eligible to be shown to the user, for a "
"given origin."
msgstr "주어진 origin에 대해 FSA Persistent Permissions 복원 프롬프트를 사용자에게 표시할 수 있는지 여부."

#: cefweaver.types.ContentSettingTypes.CAPTURED_SURFACE_CONTROL:1 of
msgid "Whether an application capturing another tab, may scroll and zoom the captured tab."
msgstr "다른 탭을 캡처하는 애플리케이션이 캡처된 탭을 스크롤하고 확대/축소할 수 있는지 여부."

#: cefweaver.types.ContentSettingTypes.SMART_CARD_GUARD:1 of
msgid "Content setting for access to smart card readers."
msgstr "스마트 카드 리더 접근에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.SMART_CARD_GUARD:3 of
msgid "The \"guard\" content setting stores whether to allow sites to access the Smart Card API."
msgstr "\"guard\" 콘텐츠 설정은 사이트가 Smart Card API에 접근하도록 허용할지 여부를 저장합니다."

#: cefweaver.types.ContentSettingTypes.WEB_PRINTING:1 of
msgid "Content settings for access to printers for the Web Printing API."
msgstr "Web Printing API용 프린터 접근에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.AUTOMATIC_FULLSCREEN:1 of
msgid "Content setting used to indicate whether entering HTML Fullscreen automatically (i.e."
msgstr "HTML Fullscreen에 자동으로 진입하는 것(즉,"

#: cefweaver.types.ContentSettingTypes.AUTOMATIC_FULLSCREEN:3 of
msgid "without transient activation) should be enabled."
msgstr "일시적 활성화 없이)을 활성화할지 여부를 나타내는 데 사용되는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.SUB_APP_INSTALLATION_PROMPTS:1 of
msgid ""
"Content settings used to indicate that a web app is allowed to prompt the user for the "
"installation of sub apps."
msgstr "웹 앱이 사용자에게 하위 앱 설치를 요청할 수 있음을 나타내는 데 사용되는 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.SPEAKER_SELECTION:1 of
msgid "Whether an application can enumerate audio output device."
msgstr "애플리케이션이 오디오 출력 장치를 열거할 수 있는지 여부."

#: cefweaver.types.ContentSettingTypes.DIRECT_SOCKETS:1 of
msgid "Content settings for access to the Direct Sockets API."
msgstr "Direct Sockets API 접근에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.KEYBOARD_LOCK:1 of
msgid ""
"Keyboard Lock API allows a site to capture keyboard inputs that would otherwise be handled by the"
" OS or the browser."
msgstr "Keyboard Lock API를 사용하면 사이트가 그렇지 않았다면 OS나 브라우저가 처리했을 키보드 입력을 캡처할 수 있습니다."

#: cefweaver.types.ContentSettingTypes.POINTER_LOCK:1 of
msgid "Pointer Lock API allows a site to hide the cursor and have exclusive access to mouse inputs."
msgstr "Pointer Lock API를 사용하면 사이트가 커서를 숨기고 마우스 입력을 독점적으로 사용할 수 있습니다."

#: cefweaver.types.ContentSettingTypes.REVOKED_ABUSIVE_NOTIFICATION_PERMISSIONS:1 of
msgid ""
"Website setting which is used for RevokedPermissionsService to store auto-revoked notification "
"permissions from abusive sites."
msgstr "악용하는 사이트에서 자동으로 해지된 알림 권한을 저장하기 위해 RevokedPermissionsService에서 사용하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.DISPLAY_MEDIA_SYSTEM_AUDIO:1 of
msgid ""
"With this permission, when the application calls ``getDisplayMedia()``, a system audio track can "
"be returned without showing the display media selection picker."
msgstr "이 권한이 있으면 애플리케이션이 ``getDisplayMedia()``\\ 를 호출할 때 디스플레이 미디어 선택 창을 표시하지 않고 시스템 오디오 트랙을 반환할 수 있습니다."

#: cefweaver.types.ContentSettingTypes.DISPLAY_MEDIA_SYSTEM_AUDIO:3 of
msgid ""
"The application can explicitly specify ``systemAudio: 'exclude'`` or ``video: true`` to still "
"show the display media selection picker if needed. Please note that the setting only works for "
"WebUI."
msgstr ""
"애플리케이션은 필요한 경우 디스플레이 미디어 선택 창을 계속 표시하도록 ``systemAudio: 'exclude'`` 또는 ``video: true``\\ 를 명시적으로 "
"지정할 수 있습니다. 이 설정은 WebUI에서만 동작합니다."

#: cefweaver.types.ContentSettingTypes.JAVASCRIPT_OPTIMIZER:1 of
msgid "Whether to use the higher-tier v8 optimizers for running JavaScript on the page."
msgstr "페이지에서 JavaScript를 실행하는 데 상위 단계 v8 최적화기를 사용할지 여부."

#: cefweaver.types.ContentSettingTypes.STORAGE_ACCESS_HEADER_ORIGIN_TRIAL:1 of
msgid ""
"Content Setting for the Storage Access Headers persistent origin trial that allows origins to opt"
" into the storage access header behavior."
msgstr "origin이 storage access header 동작에 동의할 수 있게 하는 Storage Access Headers 영구 origin trial의 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.STORAGE_ACCESS_HEADER_ORIGIN_TRIAL:3 of
msgid ""
"Should be scoped to ``REQUESTING_ORIGIN_AND_TOP_SCHEMEFUL_SITE_SCOPE`` in order to correspond to "
"the design of persistent origin trials. See also: https://github.com/cfredric/storage-access-"
"headers ALLOW: storage access request headers will be attached to cross-site requests, and url "
"requests will look for response headers from origins to retry a request or load with storage "
"access. BLOCK (default): no effect."
msgstr ""
"영구 origin trial의 설계에 대응하도록 ``REQUESTING_ORIGIN_AND_TOP_SCHEMEFUL_SITE_SCOPE``\\ 로 범위를 정해야 합니다. "
"다음도 참조하십시오: https://github.com/cfredric/storage-access-headers ALLOW: storage access 요청 헤더가 교차 "
"사이트 요청에 첨부되고, url 요청은 origin의 응답 헤더를 찾아 요청을 다시 시도하거나 storage access로 로드합니다. BLOCK(기본값): 효과가 없습니다."

#: cefweaver.types.ContentSettingTypes.HAND_TRACKING:1 of
msgid "Whether or not sites can request Hand Tracking data within WebXR Sessions."
msgstr "사이트가 WebXR 세션 내에서 손 추적 데이터를 요청할 수 있는지 여부."

#: cefweaver.types.ContentSettingTypes.WEB_APP_INSTALLATION:1 of
msgid "Website setting to indicate whether user has opted in to allow web apps to install other web apps."
msgstr "사용자가 웹 앱이 다른 웹 앱을 설치하도록 허용하는 데 동의했는지 나타내는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.DIRECT_SOCKETS_PRIVATE_NETWORK_ACCESS:1 of
msgid "Content settings for private network access in the context of the Direct Sockets API."
msgstr "Direct Sockets API 맥락에서 private network access에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.LEGACY_COOKIE_SCOPE:1 of
msgid "Content settings for legacy cookie scope."
msgstr "레거시 쿠키 scope에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.LEGACY_COOKIE_SCOPE:3 of
msgid "Checks whether cookies scope is handled according to origin-bound cookies or legacy behavior."
msgstr "쿠키 scope가 origin-bound 쿠키 방식으로 처리되는지 레거시 동작으로 처리되는지 확인합니다."

#: cefweaver.types.ContentSettingTypes.ARE_SUSPICIOUS_NOTIFICATIONS_ALLOWLISTED_BY_USER:1 of
msgid ""
"Website setting to indicate whether the user has allowlisted suspicious notifications for the "
"origin."
msgstr "사용자가 해당 origin의 의심스러운 알림을 허용 목록에 추가했는지 나타내는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.CONTROLLED_FRAME:1 of
msgid "Content settings for access to the Controlled Frame API."
msgstr "Controlled Frame API 접근에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.REVOKED_DISRUPTIVE_NOTIFICATION_PERMISSIONS:1 of
msgid ""
"Website setting which is used for RevokedPermissionsService to store revoked notification "
"permissions of disruptive sites."
msgstr "RevokedPermissionsService가 방해가 되는 사이트의 철회된 알림 권한을 저장하는 데 사용하는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.LOCAL_NETWORK:1
#: cefweaver.types.ContentSettingTypes.LOCAL_NETWORK_ACCESS:1 of
msgid "Content setting for whether the site is allowed to make local network requests."
msgstr "사이트가 로컬 네트워크 요청을 보내도록 허용되는지에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.ON_DEVICE_SPEECH_RECOGNITION_LANGUAGES_DOWNLOADED:1 of
msgid ""
"Stores information on-device language packs for which a site has installed using the Web Speech "
"API."
msgstr "사이트가 Web Speech API를 사용해 설치한 온디바이스 언어 팩에 대한 정보를 저장합니다."

#: cefweaver.types.ContentSettingTypes.INITIALIZED_TRANSLATIONS:1 of
msgid "Stores which Translator API language packs the site has initialized."
msgstr "사이트가 초기화한 Translator API 언어 팩을 저장합니다."

#: cefweaver.types.ContentSettingTypes.SUSPICIOUS_NOTIFICATION_IDS:1 of
msgid ""
"Stores a list of notification ids where content detection found the notification to be suspicious"
" and a warning has already been shown for the site."
msgstr "콘텐츠 감지에서 의심스럽다고 판단되어 해당 사이트에 이미 경고가 표시된 알림의 id 목록을 저장합니다."

#: cefweaver.types.ContentSettingTypes.SUSPICIOUS_NOTIFICATION_IDS:3 of
msgid ""
"Used for recovering notification contents from the database if the user decides they would like "
"to see all of these notifications."
msgstr "사용자가 이러한 알림을 모두 보기로 결정했을 때 데이터베이스에서 알림 내용을 복구하는 데 사용됩니다."

#: cefweaver.types.ContentSettingTypes.GEOLOCATION_WITH_OPTIONS:1 of
msgid ""
"To support approximate geolocation, the permission is migrating to use permissions with options, "
"which won't be stored as ContentSettings."
msgstr "대략적인 위치 정보를 지원하기 위해 이 권한은 ContentSettings로 저장되지 않는 옵션이 있는 권한을 사용하는 방향으로 이전되고 있습니다."

#: cefweaver.types.ContentSettingTypes.GEOLOCATION_WITH_OPTIONS:3 of
msgid "Upon launch of the feature, GEOLOCATION and GEOLOCATION_WITH_OPTIONS should be merged."
msgstr "기능이 출시되면 GEOLOCATION과 GEOLOCATION_WITH_OPTIONS는 병합되어야 합니다."

#: cefweaver.types.ContentSettingTypes.DEVICE_ATTRIBUTES:1 of
msgid "Setting for enabling the Device Attributes API."
msgstr "Device Attributes API를 활성화하는 설정."

#: cefweaver.types.ContentSettingTypes.DEVICE_ATTRIBUTES:3 of
msgid "Spec link: https://wicg.github.io/WebApiDevice/device_attributes/"
msgstr "사양 링크: https://wicg.github.io/WebApiDevice/device_attributes/"

#: cefweaver.types.ContentSettingTypes.PERMISSION_ACTIONS_HISTORY:1 of
msgid "Stores per-origin state for permission heuristics."
msgstr "권한 휴리스틱을 위한 origin별 상태를 저장합니다."

#: cefweaver.types.ContentSettingTypes.PERMISSION_ACTIONS_HISTORY:3 of
msgid ""
"Currently used for auto-granting geolocation element permission request after repeated temporary "
"grants."
msgstr "현재는 반복된 임시 허용 이후 geolocation element 권한 요청을 자동으로 허용하는 데 사용됩니다."

#: cefweaver.types.ContentSettingTypes.SUSPICIOUS_NOTIFICATION_SHOW_ORIGINAL:1 of
msgid ""
"Website setting to indicate whether the user has selected \"show original\" when suspicious "
"warning is shown."
msgstr "의심스러운 경고가 표시될 때 사용자가 \"원본 보기\"를 선택했는지 나타내는 웹사이트 설정."

#: cefweaver.types.ContentSettingTypes.SUSPICIOUS_NOTIFICATION_SHOW_ORIGINAL:3 of
msgid ""
"If the user has selected this, the notification permission will not be revoked based on "
"suspicious verdict."
msgstr "사용자가 이를 선택한 경우 의심스럽다는 판정에 따라 알림 권한이 철회되지 않습니다."

#: cefweaver.types.ContentSettingTypes.LOCAL_NETWORK:3
#: cefweaver.types.ContentSettingTypes.LOOPBACK_NETWORK:3 of
msgid "Split from LOCAL_NETWORK_ACCESS."
msgstr "LOCAL_NETWORK_ACCESS에서 분리되었습니다."

#: cefweaver.types.ContentSettingTypes.LOOPBACK_NETWORK:1 of
msgid "Content setting for whether the site is allowed to make loopback network requests."
msgstr "사이트가 loopback 네트워크 요청을 보내도록 허용되는지에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.SUB_APPS_WITHOUT_PROMPTS:1 of
msgid "Content setting for whether an IWA can add sub apps without prompting users."
msgstr "IWA가 사용자에게 묻지 않고 하위 앱을 추가할 수 있는지에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.INLINE_CUE_MENU:1 of
msgid "Content setting for inline cue menus."
msgstr "인라인 큐 메뉴에 대한 콘텐츠 설정."

#: cefweaver.types.ContentSettingTypes.SUSPICIOUS_SITE_WARNING_DATA:1 of
msgid "Stores allowlist decisions for Suspicious Site Warnings."
msgstr "Suspicious Site Warnings에 대한 허용 목록 결정을 저장합니다."

#: cefweaver.types.enums.ContentSettingValues:1 of
msgid "Supported content setting values."
msgstr "지원되는 콘텐츠 설정 값."

#: cefweaver.types.enums.ContentSettingValues:3 of
msgid "Should be kept in sync with Chromium's ContentSetting type."
msgstr "Chromium의 ContentSetting 타입과 동기화된 상태로 유지되어야 합니다."

#: cefweaver.types.enums.ContextMenuEditStateFlags:1 of
msgid "Supported context menu edit state bit flags."
msgstr "지원되는 컨텍스트 메뉴 편집 상태 비트 플래그."

#: cefweaver.types.enums.ContextMenuEditStateFlags:3 of
msgid ""
"These constants match their equivalents in Chromium's ContextMenuDataEditFlags and should not be "
"renumbered."
msgstr "이 상수들은 Chromium의 ContextMenuDataEditFlags에 있는 대응 상수와 일치하며 번호를 다시 매겨서는 안 됩니다."

#: cefweaver.types.enums.ContextMenuMediaStateFlags:1 of
msgid "Supported context menu media state bit flags."
msgstr "지원되는 컨텍스트 메뉴 미디어 상태 비트 플래그."

#: cefweaver.types.enums.ContextMenuMediaStateFlags:3 of
msgid ""
"These constants match their equivalents in Chromium's ContextMenuData::MediaFlags and should not "
"be renumbered."
msgstr "이 상수들은 Chromium의 ContextMenuData::MediaFlags에 있는 대응 상수와 일치하며 번호를 다시 매겨서는 안 됩니다."

#: cefweaver.types.enums.ContextMenuMediaType:1 of
msgid "Supported context menu media types."
msgstr "지원되는 컨텍스트 메뉴 미디어 타입."

#: cefweaver.types.enums.ContextMenuMediaType:3 of
msgid ""
"These constants match their equivalents in Chromium's ContextMenuDataMediaType and should not be "
"renumbered."
msgstr "이 상수들은 Chromium의 ContextMenuDataMediaType에 있는 대응 상수와 일치하며 번호를 다시 매겨서는 안 됩니다."

#: cefweaver.types.ContextMenuMediaType.NONE:1 of
msgid "No special node is in context."
msgstr "컨텍스트에 특별한 노드가 없습니다."

#: cefweaver.types.ContextMenuMediaType.IMAGE:1 of
msgid "An image node is selected."
msgstr "이미지 노드가 선택되었습니다."

#: cefweaver.types.ContextMenuMediaType.VIDEO:1 of
msgid "A video node is selected."
msgstr "비디오 노드가 선택되었습니다."

#: cefweaver.types.ContextMenuMediaType.AUDIO:1 of
msgid "An audio node is selected."
msgstr "오디오 노드가 선택되었습니다."

#: cefweaver.types.ContextMenuMediaType.CANVAS:1 of
msgid "An canvas node is selected."
msgstr "canvas 노드가 선택되었습니다."

#: cefweaver.types.ContextMenuMediaType.FILE:1 of
msgid "A file node is selected."
msgstr "파일 노드가 선택되었습니다."

#: cefweaver.types.ContextMenuMediaType.PLUGIN:1 of
msgid "A plugin node is selected."
msgstr "플러그인 노드가 선택되었습니다."

#: cefweaver.types.enums.ContextMenuTypeFlags:1 of
msgid "Supported context menu type flags."
msgstr "지원되는 컨텍스트 메뉴 타입 플래그."

#: cefweaver.types.ContextMenuTypeFlags.NONE:1 of
msgid "No node is selected."
msgstr "선택된 노드가 없습니다."

#: cefweaver.types.ContextMenuTypeFlags.PAGE:1 of
msgid "The top page is selected."
msgstr "최상위 페이지가 선택되었습니다."

#: cefweaver.types.ContextMenuTypeFlags.FRAME:1 of
msgid "A subframe page is selected."
msgstr "하위 frame 페이지가 선택되었습니다."

#: cefweaver.types.ContextMenuTypeFlags.LINK:1 of
msgid "A link is selected."
msgstr "링크가 선택되었습니다."

#: cefweaver.types.ContextMenuTypeFlags.MEDIA:1 of
msgid "A media node is selected."
msgstr "미디어 노드가 선택되었습니다."

#: cefweaver.types.ContextMenuTypeFlags.SELECTION:1 of
msgid "There is a textual or mixed selection that is selected."
msgstr "텍스트 또는 혼합 선택이 선택되어 있습니다."

#: cefweaver.types.ContextMenuTypeFlags.EDITABLE:1 of
msgid "An editable element is selected."
msgstr "편집 가능한 요소가 선택되었습니다."

#: cefweaver.types.enums.CookiePriority:1 of
msgid "Cookie priority values."
msgstr "쿠키 우선순위 값."

#: cefweaver.types.enums.CookieSameSite:1 of
msgid "Cookie same site values."
msgstr "쿠키 same site 값."

#: cefweaver.types.enums.CursorType:1 of
msgid "Cursor type values."
msgstr "커서 타입 값."

#: cefweaver.types.enums.DockingMode:1 of
msgid "Docking modes supported by ``Window.add_overlay``."
msgstr "``Window.add_overlay``\\ 가 지원하는 도킹 모드."

#: cefweaver.types.enums.DomDocumentType:1 of
msgid "DOM document types."
msgstr "DOM 문서 타입."

#: cefweaver.types.enums.DomEventCategory:1 of
msgid "DOM event category flags."
msgstr "DOM 이벤트 범주 플래그."

#: cefweaver.types.enums.DomEventPhase:1 of
msgid "DOM event processing phases."
msgstr "DOM 이벤트 처리 단계."

#: cefweaver.types.enums.DomFormControlType:1 of
msgid "DOM form control types."
msgstr "DOM 폼 컨트롤 타입."

#: cefweaver.types.enums.DomFormControlType:3 of
msgid "Should be kept in sync with Chromium's blink::mojom::FormControlType type."
msgstr "Chromium의 blink::mojom::FormControlType 타입과 동기화된 상태로 유지되어야 합니다."

#: cefweaver.types.enums.DomNodeType:1 of
msgid "DOM node types."
msgstr "DOM 노드 타입."

#: cefweaver.types.enums.DownloadInterruptReason:1 of
msgid "Download interrupt reasons."
msgstr "다운로드 중단 사유."

#: cefweaver.types.enums.DownloadInterruptReason:3 of
msgid "Should be kept in sync with Chromium's download::DownloadInterruptReason type."
msgstr "Chromium의 download::DownloadInterruptReason 타입과 동기화된 상태로 유지되어야 합니다."

#: cefweaver.types.DownloadInterruptReason.FILE_FAILED:1 of
msgid "Generic file operation failure."
msgstr "일반적인 파일 작업 실패."

#: cefweaver.types.DownloadInterruptReason.FILE_ACCESS_DENIED:1 of
msgid "The file cannot be accessed due to security restrictions."
msgstr "보안 제한 때문에 파일에 접근할 수 없습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_NO_SPACE:1 of
msgid "There is not enough room on the drive."
msgstr "드라이브에 공간이 충분하지 않습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_NAME_TOO_LONG:1 of
msgid "The directory or file name is too long."
msgstr "디렉터리 또는 파일 이름이 너무 깁니다."

#: cefweaver.types.DownloadInterruptReason.FILE_TOO_LARGE:1 of
msgid "The file is too large for the file system to handle."
msgstr "파일 시스템이 처리하기에 파일이 너무 큽니다."

#: cefweaver.types.DownloadInterruptReason.FILE_VIRUS_INFECTED:1 of
msgid "The file contains a virus."
msgstr "파일에 바이러스가 있습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_TRANSIENT_ERROR:1 of
msgid "The file was in use."
msgstr "파일이 사용 중이었습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_TRANSIENT_ERROR:3 of
msgid "Too many files are opened at once. We have run out of memory."
msgstr "한꺼번에 너무 많은 파일이 열려 있습니다. 메모리가 부족해졌습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_BLOCKED:1 of
msgid "The file was blocked due to local policy."
msgstr "로컬 정책 때문에 파일이 차단되었습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_SECURITY_CHECK_FAILED:1 of
msgid "An attempt to check the safety of the download failed due to unexpected reasons."
msgstr "예기치 않은 이유로 다운로드의 안전성을 확인하려는 시도가 실패했습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_SECURITY_CHECK_FAILED:3 of
msgid "See http://crbug.com/153212."
msgstr "http://crbug.com/153212를 참조하십시오."

#: cefweaver.types.DownloadInterruptReason.FILE_TOO_SHORT:1 of
msgid ""
"An attempt was made to seek past the end of a file in opening a file (as part of resuming a "
"previously interrupted download)."
msgstr "파일을 여는 중에(이전에 중단된 다운로드를 재개하는 과정의 일부로) 파일 끝을 넘어 seek하려는 시도가 있었습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_HASH_MISMATCH:1 of
msgid "The partial file didn't match the expected hash."
msgstr "부분 파일이 예상한 해시와 일치하지 않았습니다."

#: cefweaver.types.DownloadInterruptReason.FILE_SAME_AS_SOURCE:1 of
msgid "The source and the target of the download were the same."
msgstr "다운로드의 원본과 대상이 같았습니다."

#: cefweaver.types.DownloadInterruptReason.NETWORK_FAILED:1 of
msgid "Generic network failure."
msgstr "일반적인 네트워크 실패."

#: cefweaver.types.DownloadInterruptReason.NETWORK_TIMEOUT:1 of
msgid "The network operation timed out."
msgstr "네트워크 작업이 시간 초과되었습니다."

#: cefweaver.types.DownloadInterruptReason.NETWORK_DISCONNECTED:1 of
msgid "The network connection has been lost."
msgstr "네트워크 연결이 끊어졌습니다."

#: cefweaver.types.DownloadInterruptReason.NETWORK_SERVER_DOWN:1 of
msgid "The server has gone down."
msgstr "서버가 중단되었습니다."

#: cefweaver.types.DownloadInterruptReason.NETWORK_INVALID_REQUEST:1 of
msgid "The network request was invalid."
msgstr "네트워크 요청이 유효하지 않았습니다."

#: cefweaver.types.DownloadInterruptReason.NETWORK_INVALID_REQUEST:3 of
msgid "This may be due to the original URL or a redirected URL:"
msgstr "원래 URL이나 리디렉션된 URL 때문일 수 있습니다:"

#: cefweaver.types.DownloadInterruptReason.NETWORK_INVALID_REQUEST:5 of
msgid "Having an unsupported scheme."
msgstr "지원되지 않는 scheme을 가지고 있습니다."

#: cefweaver.types.DownloadInterruptReason.NETWORK_INVALID_REQUEST:6 of
msgid "Being an invalid URL."
msgstr "유효하지 않은 URL입니다."

#: cefweaver.types.DownloadInterruptReason.NETWORK_INVALID_REQUEST:7 of
msgid "Being disallowed by policy."
msgstr "정책에 의해 허용되지 않습니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_FAILED:1 of
msgid "The server indicates that the operation has failed (generic)."
msgstr "서버가 작업이 실패했음을 나타냅니다(일반)."

#: cefweaver.types.DownloadInterruptReason.SERVER_NO_RANGE:1 of
msgid "The server does not support range requests."
msgstr "서버가 range 요청을 지원하지 않습니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_NO_RANGE:3 of
msgid "Internal use only:  must restart from the beginning."
msgstr "내부 전용: 처음부터 다시 시작해야 합니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_BAD_CONTENT:1 of
msgid "The server does not have the requested data."
msgstr "서버에 요청한 데이터가 없습니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_UNAUTHORIZED:1 of
msgid "Server didn't authorize access to resource."
msgstr "서버가 리소스에 대한 접근을 승인하지 않았습니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_CERT_PROBLEM:1 of
msgid "Server certificate problem."
msgstr "서버 인증서 문제."

#: cefweaver.types.DownloadInterruptReason.SERVER_FORBIDDEN:1 of
msgid "Server access forbidden."
msgstr "서버 접근이 금지되었습니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_UNREACHABLE:1 of
msgid "Unexpected server response."
msgstr "예기치 않은 서버 응답."

#: cefweaver.types.DownloadInterruptReason.SERVER_UNREACHABLE:3 of
msgid "This might indicate that the responding server may not be the intended server."
msgstr "응답한 서버가 의도한 서버가 아닐 수 있음을 나타낼 수 있습니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_CONTENT_LENGTH_MISMATCH:1 of
msgid "The server sent fewer bytes than the content-length header."
msgstr "서버가 content-length 헤더보다 적은 바이트를 보냈습니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_CONTENT_LENGTH_MISMATCH:3 of
msgid ""
"It may indicate that the connection was closed prematurely, or the Content-Length header was "
"invalid. The download is only interrupted if strong validators are present. Otherwise, it is "
"treated as finished."
msgstr ""
"연결이 너무 일찍 닫혔거나 Content-Length 헤더가 유효하지 않았음을 나타낼 수 있습니다. 다운로드는 strong validator가 있는 경우에만 중단됩니다. "
"그렇지 않으면 완료된 것으로 처리됩니다."

#: cefweaver.types.DownloadInterruptReason.SERVER_CROSS_ORIGIN_REDIRECT:1 of
msgid "An unexpected cross-origin redirect happened."
msgstr "예기치 않은 cross-origin 리디렉션이 발생했습니다."

#: cefweaver.types.DownloadInterruptReason.USER_CANCELED:1 of
msgid "The user canceled the download."
msgstr "사용자가 다운로드를 취소했습니다."

#: cefweaver.types.DownloadInterruptReason.USER_SHUTDOWN:1 of
msgid "The user shut down the browser."
msgstr "사용자가 브라우저를 종료했습니다."

#: cefweaver.types.DownloadInterruptReason.CRASH:3
#: cefweaver.types.DownloadInterruptReason.USER_SHUTDOWN:3 of
msgid "Internal use only:  resume pending downloads if possible."
msgstr "내부 전용: 가능하면 대기 중인 다운로드를 재개합니다."

#: cefweaver.types.DownloadInterruptReason.CRASH:1 of
msgid "The browser crashed."
msgstr "브라우저가 크래시했습니다."

#: cefweaver.types.enums.DragOperationsMask:1 of
msgid "\"Verb\" of a drag-and-drop operation as negotiated between the source and destination."
msgstr "소스와 대상 사이에서 협상된 드래그 앤 드롭 작업의 \"동사\"."

#: cefweaver.types.enums.DragOperationsMask:3 of
msgid "These constants match their equivalents in WebCore's DragActions.h and should not be renumbered."
msgstr "이 상수들은 WebCore의 DragActions.h에 있는 대응 상수와 일치하며 번호를 다시 매겨서는 안 됩니다."

#: cefweaver.types.enums.DuplexMode:1 of
msgid "Print job duplex mode values."
msgstr "인쇄 작업 duplex 모드 값."

#: cefweaver.types.enums.ErrorCode:1 of
msgid "Supported error code values."
msgstr "지원되는 오류 코드 값."

#: cefweaver.types.enums.ErrorCode:3 of
msgid "For the complete list of error values see \"include/base/internal/cef_net_error_list.h\"."
msgstr "오류 값의 전체 목록은 \"include/base/internal/cef_net_error_list.h\"를 참조하십시오."

#: cefweaver.types.ErrorCode.IO_PENDING:1 of
msgid "An asynchronous IO operation is not yet complete."
msgstr "비동기 IO 작업이 아직 완료되지 않았습니다."

#: cefweaver.types.ErrorCode.IO_PENDING:3 of
msgid ""
"This usually does not indicate a fatal error.  Typically this error will be generated as a "
"notification to wait for some external notification that the IO operation finally completed."
msgstr "이것은 보통 치명적인 오류를 나타내지 않습니다. 일반적으로 이 오류는 IO 작업이 마침내 완료되었다는 외부 알림을 기다리라는 통지로 생성됩니다."

#: cefweaver.types.ErrorCode.FAILED:1 of
msgid "A generic failure occurred."
msgstr "일반적인 실패가 발생했습니다."

#: cefweaver.types.ErrorCode.ABORTED:1 of
msgid "An operation was aborted (due to user action)."
msgstr "작업이 (사용자 동작으로 인해) 중단되었습니다."

#: cefweaver.types.ErrorCode.INVALID_ARGUMENT:1 of
msgid "An argument to the function is incorrect."
msgstr "함수에 전달된 인자가 올바르지 않습니다."

#: cefweaver.types.ErrorCode.INVALID_HANDLE:1 of
msgid "The handle or file descriptor is invalid."
msgstr "핸들 또는 파일 디스크립터가 유효하지 않습니다."

#: cefweaver.types.ErrorCode.FILE_NOT_FOUND:1 of
msgid "The file or directory cannot be found."
msgstr "파일 또는 디렉터리를 찾을 수 없습니다."

#: cefweaver.types.ErrorCode.TIMED_OUT:1 of
msgid "An operation timed out."
msgstr "작업이 시간 초과되었습니다."

#: cefweaver.types.ErrorCode.FILE_TOO_BIG:1 of
msgid "The file is too large."
msgstr "파일이 너무 큽니다."

#: cefweaver.types.ErrorCode.UNEXPECTED:1 of
msgid "An unexpected error."
msgstr "예기치 않은 오류."

#: cefweaver.types.ErrorCode.UNEXPECTED:3 of
msgid "This may be caused by a programming mistake or an invalid assumption."
msgstr "프로그래밍 실수나 잘못된 가정 때문일 수 있습니다."

#: cefweaver.types.ErrorCode.ACCESS_DENIED:1 of
msgid "Permission to access a resource, other than the network, was denied."
msgstr "네트워크가 아닌 리소스에 접근할 권한이 거부되었습니다."

#: cefweaver.types.ErrorCode.NOT_IMPLEMENTED:1 of
msgid "The operation failed because of unimplemented functionality."
msgstr "구현되지 않은 기능 때문에 작업이 실패했습니다."

#: cefweaver.types.ErrorCode.INSUFFICIENT_RESOURCES:1 of
msgid "There were not enough resources to complete the operation."
msgstr "작업을 완료하기에 리소스가 충분하지 않았습니다."

#: cefweaver.types.ErrorCode.OUT_OF_MEMORY:1 of
msgid "Memory allocation failed."
msgstr "메모리 할당에 실패했습니다."

#: cefweaver.types.ErrorCode.UPLOAD_FILE_CHANGED:1 of
msgid "The file upload failed because the file's modification time was different from the expectation."
msgstr "파일의 수정 시간이 예상과 달라서 파일 업로드에 실패했습니다."

#: cefweaver.types.ErrorCode.SOCKET_NOT_CONNECTED:1 of
msgid "The socket is not connected."
msgstr "소켓이 연결되어 있지 않습니다."

#: cefweaver.types.ErrorCode.FILE_EXISTS:1 of
msgid "The file already exists."
msgstr "파일이 이미 존재합니다."

#: cefweaver.types.ErrorCode.FILE_PATH_TOO_LONG:1 of
msgid "The path or file name is too long."
msgstr "경로 또는 파일 이름이 너무 깁니다."

#: cefweaver.types.ErrorCode.FILE_NO_SPACE:1 of
msgid "Not enough room left on the disk."
msgstr "디스크에 남은 공간이 충분하지 않습니다."

#: cefweaver.types.ErrorCode.FILE_VIRUS_INFECTED:1 of
msgid "The file has a virus."
msgstr "파일에 바이러스가 있습니다."

#: cefweaver.types.ErrorCode.BLOCKED_BY_CLIENT:1 of
msgid "The client chose to block the request."
msgstr "클라이언트가 요청을 차단하기로 선택했습니다."

#: cefweaver.types.ErrorCode.NETWORK_CHANGED:1 of
msgid "The network changed."
msgstr "네트워크가 변경되었습니다."

#: cefweaver.types.ErrorCode.BLOCKED_BY_ADMINISTRATOR:1 of
msgid "The request was blocked by the URL block list configured by the domain administrator."
msgstr "도메인 관리자가 구성한 URL 차단 목록에 의해 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.SOCKET_IS_CONNECTED:1 of
msgid "The socket is already connected."
msgstr "소켓이 이미 연결되어 있습니다."

#: cefweaver.types.ErrorCode.UPLOAD_STREAM_REWIND_NOT_SUPPORTED:1 of
msgid ""
"The upload failed because the upload stream needed to be re-read, due to a retry or a redirect, "
"but the upload stream doesn't support that operation."
msgstr "재시도나 리디렉션 때문에 업로드 스트림을 다시 읽어야 했지만 업로드 스트림이 그 작업을 지원하지 않아서 업로드에 실패했습니다."

#: cefweaver.types.ErrorCode.CONTEXT_SHUT_DOWN:1 of
msgid "The request failed because the URLRequestContext is shutting down, or has been shut down."
msgstr "URLRequestContext가 종료 중이거나 이미 종료되어서 요청이 실패했습니다."

#: cefweaver.types.ErrorCode.BLOCKED_BY_RESPONSE:1 of
msgid ""
"The request failed because the response was delivered along with requirements which are not met "
"('X-Frame-Options' and 'Content-Security-Policy' ancestor checks and 'Cross-Origin-Resource-"
"Policy' for instance)."
msgstr ""
"응답이 충족되지 않는 요건과 함께 전달되어서 요청이 실패했습니다(예: 'X-Frame-Options'와 'Content-Security-Policy' ancestor 검사, "
"'Cross-Origin-Resource-Policy')."

#: cefweaver.types.ErrorCode.CLEARTEXT_NOT_PERMITTED:1 of
msgid "The request was blocked by system policy disallowing some or all cleartext requests."
msgstr "일부 또는 모든 cleartext 요청을 허용하지 않는 시스템 정책에 의해 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.CLEARTEXT_NOT_PERMITTED:3 of
msgid "Used for NetworkSecurityPolicy on Android."
msgstr "Android의 NetworkSecurityPolicy에 사용됩니다."

#: cefweaver.types.ErrorCode.BLOCKED_BY_CSP:1 of
msgid "The request was blocked by a Content Security Policy"
msgstr "Content Security Policy에 의해 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.BLOCKED_BY_ORB:1 of
msgid "The request was blocked by CORB or ORB."
msgstr "CORB 또는 ORB에 의해 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.NETWORK_ACCESS_REVOKED:1 of
msgid "The request was blocked because it originated from a frame that has disabled network access."
msgstr "네트워크 접근을 비활성화한 frame에서 시작되었기 때문에 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.BLOCKED_BY_FINGERPRINTING_PROTECTION:1 of
msgid "The request was blocked by fingerprinting protections."
msgstr "fingerprinting 보호에 의해 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.BLOCKED_IN_INCOGNITO_BY_ADMINISTRATOR:1 of
msgid ""
"The request was blocked by the Incognito Mode URL block list configured by the domain "
"administrator."
msgstr "도메인 관리자가 구성한 시크릿 모드 URL 차단 목록에 의해 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.LOCAL_NETWORK_PERMISSION_MISSING:1 of
msgid "The request was blocked because the local network permission is missing."
msgstr "로컬 네트워크 권한이 없어서 요청이 차단되었습니다."

#: cefweaver.types.ErrorCode.LOCAL_NETWORK_PERMISSION_MISSING:3 of
msgid ""
"Note that this is different from BLOCKED_BY_LOCAL_NETWORK_ACCESS_CHECKS which is specifically for"
" a CORS error code."
msgstr "이것은 CORS 오류 코드 전용인 BLOCKED_BY_LOCAL_NETWORK_ACCESS_CHECKS와 다르다는 점에 유의하십시오."

#: cefweaver.types.ErrorCode.STRICT_ECH_REQUIRED:1 of
msgid "The request was blocked because ECH is strictly required, but:"
msgstr "ECH가 엄격하게 요구되지만 다음과 같은 이유로 요청이 차단되었습니다:"

#: cefweaver.types.ErrorCode.STRICT_ECH_REQUIRED:3 of
msgid "The client could not obtain a valid ECH configuration."
msgstr "클라이언트가 유효한 ECH 구성을 얻지 못했습니다."

#: cefweaver.types.ErrorCode.STRICT_ECH_REQUIRED:4 of
msgid ""
"The server rejected the ECH, and the client failed to establish a new ECH connection after "
"retrying with retry_configs."
msgstr "서버가 ECH를 거부했고, 클라이언트가 retry_configs로 재시도한 뒤에도 새 ECH 연결을 설정하지 못했습니다."

#: cefweaver.types.ErrorCode.CONNECTION_CLOSED:1 of
msgid "A connection was closed (corresponding to a TCP FIN)."
msgstr "연결이 닫혔습니다(TCP FIN에 해당)."

#: cefweaver.types.ErrorCode.CONNECTION_RESET:1 of
msgid "A connection was reset (corresponding to a TCP RST)."
msgstr "연결이 재설정되었습니다(TCP RST에 해당)."

#: cefweaver.types.ErrorCode.CONNECTION_REFUSED:1 of
msgid "A connection attempt was refused."
msgstr "연결 시도가 거부되었습니다."

#: cefweaver.types.ErrorCode.CONNECTION_ABORTED:1 of
msgid "A connection timed out as a result of not receiving an ACK for data sent."
msgstr "보낸 데이터에 대한 ACK를 받지 못해서 연결이 시간 초과되었습니다."

#: cefweaver.types.ErrorCode.CONNECTION_ABORTED:3 of
msgid "This can include a FIN packet that did not get ACK'd."
msgstr "여기에는 ACK되지 않은 FIN 패킷이 포함될 수 있습니다."

#: cefweaver.types.ErrorCode.CONNECTION_FAILED:1 of
msgid "A connection attempt failed."
msgstr "연결 시도가 실패했습니다."

#: cefweaver.types.ErrorCode.NAME_NOT_RESOLVED:1 of
msgid "The host name could not be resolved."
msgstr "호스트 이름을 확인할 수 없습니다."

#: cefweaver.types.ErrorCode.INTERNET_DISCONNECTED:1 of
msgid "The Internet connection has been lost."
msgstr "인터넷 연결이 끊어졌습니다."

#: cefweaver.types.ErrorCode.SSL_PROTOCOL_ERROR:1 of
msgid "An SSL protocol error occurred."
msgstr "SSL 프로토콜 오류가 발생했습니다."

#: cefweaver.types.ErrorCode.ADDRESS_INVALID:1 of
msgid "The IP address or port number is invalid (e.g., cannot connect to the IP address 0 or the port 0)."
msgstr "IP 주소 또는 포트 번호가 유효하지 않습니다(예: IP 주소 0이나 포트 0에는 연결할 수 없습니다)."

#: cefweaver.types.ErrorCode.ADDRESS_UNREACHABLE:1 of
msgid "The IP address is unreachable."
msgstr "IP 주소에 도달할 수 없습니다."

#: cefweaver.types.ErrorCode.ADDRESS_UNREACHABLE:3 of
msgid "This usually means that there is no route to the specified host or network."
msgstr "보통 지정한 호스트나 네트워크로 가는 경로가 없다는 뜻입니다."

#: cefweaver.types.ErrorCode.SSL_CLIENT_AUTH_CERT_NEEDED:1 of
msgid "The server requested a client certificate for SSL client authentication."
msgstr "서버가 SSL 클라이언트 인증을 위해 클라이언트 인증서를 요청했습니다."

#: cefweaver.types.ErrorCode.TUNNEL_CONNECTION_FAILED:1 of
msgid "A tunnel connection through the proxy could not be established."
msgstr "proxy를 통한 터널 연결을 설정할 수 없었습니다."

#: cefweaver.types.ErrorCode.TUNNEL_CONNECTION_FAILED:3 of
msgid "For more info see the comment on PROXY_UNABLE_TO_CONNECT_TO_DESTINATION."
msgstr "자세한 내용은 PROXY_UNABLE_TO_CONNECT_TO_DESTINATION의 주석을 참조하십시오."

#: cefweaver.types.ErrorCode.SSL_VERSION_OR_CIPHER_MISMATCH:1 of
msgid "The client and server don't support a common SSL protocol version or cipher suite."
msgstr "클라이언트와 서버가 공통된 SSL 프로토콜 버전이나 암호 스위트를 지원하지 않습니다."

#: cefweaver.types.ErrorCode.SSL_RENEGOTIATION_REQUESTED:1 of
msgid "The server requested a renegotiation (rehandshake)."
msgstr "서버가 재협상(rehandshake)을 요청했습니다."

#: cefweaver.types.ErrorCode.PROXY_AUTH_UNSUPPORTED:1 of
msgid "The proxy requested authentication (for tunnel establishment) with an unsupported method."
msgstr "proxy가 지원되지 않는 방식으로 (터널 설정을 위한) 인증을 요청했습니다."

#: cefweaver.types.ErrorCode.BAD_SSL_CLIENT_AUTH_CERT:1 of
msgid "The SSL handshake failed because of a bad or missing client certificate."
msgstr "클라이언트 인증서가 잘못되었거나 없어서 SSL 핸드셰이크가 실패했습니다."

#: cefweaver.types.ErrorCode.CONNECTION_TIMED_OUT:1 of
msgid "A connection attempt timed out."
msgstr "연결 시도가 시간 초과되었습니다."

#: cefweaver.types.ErrorCode.HOST_RESOLVER_QUEUE_TOO_LARGE:1 of
msgid "There are too many pending DNS resolves, so a request in the queue was aborted."
msgstr "대기 중인 DNS 확인이 너무 많아서 큐에 있던 요청이 중단되었습니다."

#: cefweaver.types.ErrorCode.SOCKS_CONNECTION_FAILED:1 of
msgid "Failed establishing a connection to the SOCKS proxy server for a target host."
msgstr "대상 호스트를 위한 SOCKS proxy 서버와의 연결을 설정하지 못했습니다."

#: cefweaver.types.ErrorCode.SOCKS_CONNECTION_HOST_UNREACHABLE:1 of
msgid ""
"The SOCKS proxy server failed establishing connection to the target host because that host is "
"unreachable."
msgstr "대상 호스트에 도달할 수 없어서 SOCKS proxy 서버가 그 호스트와의 연결을 설정하지 못했습니다."

#: cefweaver.types.ErrorCode.ALPN_NEGOTIATION_FAILED:1 of
msgid "The request to negotiate an alternate protocol failed."
msgstr "대체 프로토콜을 협상하는 요청이 실패했습니다."

#: cefweaver.types.ErrorCode.SSL_NO_RENEGOTIATION:1 of
msgid "The peer sent an SSL no_renegotiation alert message."
msgstr "피어가 SSL no_renegotiation 경고 메시지를 보냈습니다."

#: cefweaver.types.ErrorCode.WINSOCK_UNEXPECTED_WRITTEN_BYTES:1 of
msgid "Winsock sometimes reports more data written than passed."
msgstr "Winsock은 때때로 전달한 것보다 많은 데이터가 기록되었다고 보고합니다."

#: cefweaver.types.ErrorCode.WINSOCK_UNEXPECTED_WRITTEN_BYTES:3 of
msgid "This is probably due to a broken LSP."
msgstr "이는 아마도 손상된 LSP 때문일 것입니다."

#: cefweaver.types.ErrorCode.SSL_DECOMPRESSION_FAILURE_ALERT:1 of
msgid "An SSL peer sent us a fatal decompression_failure alert."
msgstr "SSL 피어가 치명적인 decompression_failure 경고를 보냈습니다."

#: cefweaver.types.ErrorCode.SSL_DECOMPRESSION_FAILURE_ALERT:3 of
msgid ""
"This typically occurs when a peer selects DEFLATE compression in the mistaken belief that it "
"supports it."
msgstr "이는 보통 피어가 DEFLATE 압축을 지원한다고 잘못 믿고 선택했을 때 발생합니다."

#: cefweaver.types.ErrorCode.SSL_BAD_RECORD_MAC_ALERT:1 of
msgid "An SSL peer sent us a fatal bad_record_mac alert."
msgstr "SSL 피어가 치명적인 bad_record_mac 경고를 보냈습니다."

#: cefweaver.types.ErrorCode.SSL_BAD_RECORD_MAC_ALERT:3 of
msgid "This has been observed from servers with buggy DEFLATE support."
msgstr "DEFLATE 지원에 버그가 있는 서버에서 관찰되었습니다."

#: cefweaver.types.ErrorCode.PROXY_AUTH_REQUESTED:1 of
msgid "The proxy requested authentication (for tunnel establishment)."
msgstr "proxy가 (터널 설정을 위한) 인증을 요청했습니다."

#: cefweaver.types.ErrorCode.PROXY_CONNECTION_FAILED:1 of
msgid "Could not create a connection to the proxy server."
msgstr "proxy 서버와의 연결을 만들 수 없었습니다."

#: cefweaver.types.ErrorCode.PROXY_CONNECTION_FAILED:3 of
msgid ""
"An error occurred either in resolving its name, or in connecting a socket to it. Note that this "
"does NOT include failures during the actual \"CONNECT\" method of an HTTP proxy."
msgstr ""
"이름을 확인하거나 소켓을 연결하는 과정에서 오류가 발생했습니다. 여기에는 HTTP proxy의 실제 \"CONNECT\" 메서드 중의 실패는 포함되지 않는다는 점에 "
"유의하십시오."

#: cefweaver.types.ErrorCode.MANDATORY_PROXY_CONFIGURATION_FAILED:1 of
msgid "A mandatory proxy configuration could not be used."
msgstr "필수 proxy 구성을 사용할 수 없었습니다."

#: cefweaver.types.ErrorCode.MANDATORY_PROXY_CONFIGURATION_FAILED:3 of
msgid "Currently this means that a mandatory PAC script could not be fetched, parsed or executed."
msgstr "현재 이는 필수 PAC 스크립트를 가져오거나 구문 분석하거나 실행할 수 없었다는 뜻입니다."

#: cefweaver.types.ErrorCode.PRECONNECT_MAX_SOCKET_LIMIT:1 of
msgid "We've hit the max socket limit for the socket pool while preconnecting."
msgstr "preconnect 중에 소켓 풀의 최대 소켓 한도에 도달했습니다."

#: cefweaver.types.ErrorCode.PRECONNECT_MAX_SOCKET_LIMIT:3 of
msgid "We don't bother trying to preconnect more sockets."
msgstr "더 많은 소켓을 preconnect하려고 시도하지 않습니다."

#: cefweaver.types.ErrorCode.SSL_CLIENT_AUTH_PRIVATE_KEY_ACCESS_DENIED:1 of
msgid "The permission to use the SSL client certificate's private key was denied."
msgstr "SSL 클라이언트 인증서의 개인 키를 사용할 권한이 거부되었습니다."

#: cefweaver.types.ErrorCode.SSL_CLIENT_AUTH_CERT_NO_PRIVATE_KEY:1 of
msgid "The SSL client certificate has no private key."
msgstr "SSL 클라이언트 인증서에 개인 키가 없습니다."

#: cefweaver.types.ErrorCode.PROXY_CERTIFICATE_INVALID:1 of
msgid "The certificate presented by the HTTPS Proxy was invalid."
msgstr "HTTPS Proxy가 제시한 인증서가 유효하지 않았습니다."

#: cefweaver.types.ErrorCode.NAME_RESOLUTION_FAILED:1 of
msgid "An error occurred when trying to do a name resolution (DNS)."
msgstr "이름 확인(DNS)을 시도하는 중에 오류가 발생했습니다."

#: cefweaver.types.ErrorCode.NETWORK_ACCESS_DENIED:1 of
msgid "Permission to access the network was denied."
msgstr "네트워크 접근 권한이 거부되었습니다."

#: cefweaver.types.ErrorCode.NETWORK_ACCESS_DENIED:3 of
msgid ""
"This is used to distinguish errors that were most likely caused by a firewall from other access "
"denied errors. See also ERR_ACCESS_DENIED."
msgstr "이는 방화벽이 원인일 가능성이 큰 오류를 다른 접근 거부 오류와 구별하는 데 사용됩니다. ERR_ACCESS_DENIED도 참조하십시오."

#: cefweaver.types.ErrorCode.TEMPORARILY_THROTTLED:1 of
msgid "The request throttler module cancelled this request to avoid DDOS."
msgstr "요청 throttler 모듈이 DDOS를 피하기 위해 이 요청을 취소했습니다."

#: cefweaver.types.ErrorCode.SSL_CLIENT_AUTH_SIGNATURE_FAILED:1 of
msgid ""
"We were unable to sign the CertificateVerify data of an SSL client auth handshake with the client"
" certificate's private key."
msgstr "SSL 클라이언트 인증 핸드셰이크의 CertificateVerify 데이터에 클라이언트 인증서의 개인 키로 서명할 수 없었습니다."

#: cefweaver.types.ErrorCode.SSL_CLIENT_AUTH_SIGNATURE_FAILED:3 of
msgid ""
"Possible causes for this include the user implicitly or explicitly denying access to the private "
"key, the private key may not be valid for signing, the key may be relying on a cached handle "
"which is no longer valid, or the CSP won't allow arbitrary data to be signed."
msgstr ""
"가능한 원인으로는 사용자가 개인 키에 대한 접근을 암묵적으로 또는 명시적으로 거부한 경우, 개인 키가 서명에 유효하지 않은 경우, 키가 더 이상 유효하지 않은 캐시된 핸들에 "
"의존하는 경우, CSP가 임의의 데이터에 대한 서명을 허용하지 않는 경우가 있습니다."

#: cefweaver.types.ErrorCode.MSG_TOO_BIG:1 of
msgid "The message was too large for the transport."
msgstr "메시지가 전송에 비해 너무 컸습니다."

#: cefweaver.types.ErrorCode.MSG_TOO_BIG:3 of
msgid "(for example a UDP message which exceeds size threshold)."
msgstr "(예: 크기 임계값을 초과하는 UDP 메시지)."

#: cefweaver.types.ErrorCode.WS_PROTOCOL_ERROR:1 of
msgid "Websocket protocol error."
msgstr "Websocket 프로토콜 오류."

#: cefweaver.types.ErrorCode.WS_PROTOCOL_ERROR:3 of
msgid ""
"Indicates that we are terminating the connection due to a malformed frame or other protocol "
"violation."
msgstr "잘못된 형식의 frame이나 그 밖의 프로토콜 위반 때문에 연결을 종료하고 있음을 나타냅니다."

#: cefweaver.types.ErrorCode.ADDRESS_IN_USE:1 of
msgid "Returned when attempting to bind an address that is already in use."
msgstr "이미 사용 중인 주소에 바인드하려고 할 때 반환됩니다."

#: cefweaver.types.ErrorCode.SSL_PINNED_KEY_NOT_IN_CERT_CHAIN:1 of
msgid "The certificate didn't match the built-in public key pins for the host name."
msgstr "인증서가 호스트 이름에 대한 내장 공개 키 pin과 일치하지 않았습니다."

#: cefweaver.types.ErrorCode.SSL_PINNED_KEY_NOT_IN_CERT_CHAIN:3 of
msgid ""
"The pins are set in net/http/transport_security_state.cc and require that one of a set of public "
"keys exist on the path from the leaf to the root."
msgstr "pin은 net/http/transport_security_state.cc에 설정되어 있으며, leaf에서 root까지의 경로에 공개 키 집합 중 하나가 존재해야 합니다."

#: cefweaver.types.ErrorCode.CLIENT_AUTH_CERT_TYPE_UNSUPPORTED:1 of
msgid "Server request for client certificate did not contain any types we support."
msgstr "클라이언트 인증서에 대한 서버 요청에 지원되는 타입이 하나도 없었습니다."

#: cefweaver.types.ErrorCode.SSL_DECRYPT_ERROR_ALERT:1 of
msgid "An SSL peer sent us a fatal decrypt_error alert."
msgstr "SSL 피어가 치명적인 decrypt_error 경고를 보냈습니다."

#: cefweaver.types.ErrorCode.SSL_DECRYPT_ERROR_ALERT:3 of
msgid ""
"This typically occurs when a peer could not correctly verify a signature (in CertificateVerify or"
" ServerKeyExchange) or validate a Finished message."
msgstr ""
"이는 보통 피어가 (CertificateVerify나 ServerKeyExchange의) 서명을 올바르게 검증하지 못했거나 Finished 메시지를 검증하지 못했을 때 "
"발생합니다."

#: cefweaver.types.ErrorCode.WS_THROTTLE_QUEUE_TOO_LARGE:1 of
msgid "There are too many pending WebSocketJob instances, so the new job was not pushed to the queue."
msgstr "대기 중인 WebSocketJob 인스턴스가 너무 많아서 새 작업이 큐에 들어가지 않았습니다."

#: cefweaver.types.ErrorCode.SSL_SERVER_CERT_CHANGED:1 of
msgid "The SSL server certificate changed in a renegotiation."
msgstr "재협상 중에 SSL 서버 인증서가 변경되었습니다."

#: cefweaver.types.ErrorCode.SSL_UNRECOGNIZED_NAME_ALERT:1 of
msgid "The SSL server sent us a fatal unrecognized_name alert."
msgstr "SSL 서버가 치명적인 unrecognized_name 경고를 보냈습니다."

#: cefweaver.types.ErrorCode.SOCKET_SET_RECEIVE_BUFFER_SIZE_ERROR:1 of
msgid "Failed to set the socket's receive buffer size as requested."
msgstr "요청한 대로 소켓의 수신 버퍼 크기를 설정하지 못했습니다."

#: cefweaver.types.ErrorCode.SOCKET_SET_SEND_BUFFER_SIZE_ERROR:1 of
msgid "Failed to set the socket's send buffer size as requested."
msgstr "요청한 대로 소켓의 송신 버퍼 크기를 설정하지 못했습니다."

#: cefweaver.types.ErrorCode.SOCKET_RECEIVE_BUFFER_SIZE_UNCHANGEABLE:1 of
msgid ""
"Failed to set the socket's receive buffer size as requested, despite success return code from "
"setsockopt."
msgstr "setsockopt가 성공 반환 코드를 반환했음에도 요청한 대로 소켓의 수신 버퍼 크기를 설정하지 못했습니다."

#: cefweaver.types.ErrorCode.SOCKET_SEND_BUFFER_SIZE_UNCHANGEABLE:1 of
msgid ""
"Failed to set the socket's send buffer size as requested, despite success return code from "
"setsockopt."
msgstr "setsockopt가 성공 반환 코드를 반환했음에도 요청한 대로 소켓의 송신 버퍼 크기를 설정하지 못했습니다."

#: cefweaver.types.ErrorCode.SSL_CLIENT_AUTH_CERT_BAD_FORMAT:1 of
msgid "Failed to import a client certificate from the platform store into the SSL library."
msgstr "플랫폼 저장소의 클라이언트 인증서를 SSL 라이브러리로 가져오지 못했습니다."

#: cefweaver.types.ErrorCode.ICANN_NAME_COLLISION:1 of
msgid "Resolving a hostname to an IP address list included the IPv4 address \"127.0.53.53\"."
msgstr "호스트 이름을 IP 주소 목록으로 확인한 결과에 IPv4 주소 \"127.0.53.53\"이 포함되었습니다."

#: cefweaver.types.ErrorCode.ICANN_NAME_COLLISION:3 of
msgid ""
"This is a special IP address which ICANN has recommended to indicate there was a name collision, "
"and alert admins to a potential problem."
msgstr "이는 ICANN이 이름 충돌이 있었음을 나타내고 관리자에게 잠재적인 문제를 알리도록 권장한 특별한 IP 주소입니다."

#: cefweaver.types.ErrorCode.SSL_SERVER_CERT_BAD_FORMAT:1 of
msgid "The SSL server presented a certificate which could not be decoded."
msgstr "SSL 서버가 디코딩할 수 없는 인증서를 제시했습니다."

#: cefweaver.types.ErrorCode.SSL_SERVER_CERT_BAD_FORMAT:3 of
msgid ""
"This is not a certificate error code as no X509Certificate object is available. This error is "
"fatal."
msgstr "X509Certificate 객체를 사용할 수 없으므로 이것은 인증서 오류 코드가 아닙니다. 이 오류는 치명적입니다."

#: cefweaver.types.ErrorCode.CT_STH_PARSING_FAILED:1 of
msgid "Certificate Transparency: Received a signed tree head that failed to parse."
msgstr "Certificate Transparency: 구문 분석에 실패한 signed tree head를 받았습니다."

#: cefweaver.types.ErrorCode.CT_STH_INCOMPLETE:1 of
msgid ""
"Certificate Transparency: Received a signed tree head whose JSON parsing was OK but was missing "
"some of the fields."
msgstr "Certificate Transparency: JSON 구문 분석은 성공했지만 일부 필드가 누락된 signed tree head를 받았습니다."

#: cefweaver.types.ErrorCode.UNABLE_TO_REUSE_CONNECTION_FOR_PROXY_AUTH:1 of
msgid ""
"The attempt to reuse a connection to send proxy auth credentials failed before the AuthController"
" was used to generate credentials."
msgstr "AuthController를 사용해 자격 증명을 생성하기 전에, proxy 인증 자격 증명을 보내기 위해 연결을 재사용하려는 시도가 실패했습니다."

#: cefweaver.types.ErrorCode.UNABLE_TO_REUSE_CONNECTION_FOR_PROXY_AUTH:3 of
msgid ""
"The caller should reuse the controller with a new connection. This error is only used internally "
"by the network stack."
msgstr "호출자는 새 연결로 컨트롤러를 재사용해야 합니다. 이 오류는 네트워크 스택 내부에서만 사용됩니다."

#: cefweaver.types.ErrorCode.CT_CONSISTENCY_PROOF_PARSING_FAILED:1 of
msgid "Certificate Transparency: Failed to parse the received consistency proof."
msgstr "Certificate Transparency: 받은 consistency proof를 구문 분석하지 못했습니다."

#: cefweaver.types.ErrorCode.SSL_OBSOLETE_CIPHER:1 of
msgid "The SSL server required an unsupported cipher suite that has since been removed."
msgstr "SSL 서버가 그 후 제거된, 지원되지 않는 암호 스위트를 요구했습니다."

#: cefweaver.types.ErrorCode.SSL_OBSOLETE_CIPHER:3 of
msgid ""
"This error will temporarily be signaled on a fallback for one or two releases immediately "
"following a cipher suite's removal, after which the fallback will be removed."
msgstr "이 오류는 암호 스위트가 제거된 직후 한두 릴리스 동안 fallback에서 일시적으로 신호되며, 그 이후에는 fallback이 제거됩니다."

#: cefweaver.types.ErrorCode.WS_UPGRADE:1 of
msgid ""
"When a WebSocket handshake is done successfully and the connection has been upgraded, the "
"URLRequest is cancelled with this error code."
msgstr "WebSocket 핸드셰이크가 성공적으로 완료되어 연결이 업그레이드되면 URLRequest가 이 오류 코드로 취소됩니다."

#: cefweaver.types.ErrorCode.READ_IF_READY_NOT_IMPLEMENTED:1 of
msgid "Socket ReadIfReady support is not implemented."
msgstr "소켓 ReadIfReady 지원이 구현되어 있지 않습니다."

#: cefweaver.types.ErrorCode.READ_IF_READY_NOT_IMPLEMENTED:3 of
msgid "This error should not be user visible, because the normal Read() method is used as a fallback."
msgstr "일반적인 Read() 메서드가 fallback으로 사용되므로 이 오류는 사용자에게 보이지 않아야 합니다."

#: cefweaver.types.ErrorCode.NO_BUFFER_SPACE:1 of
msgid "No socket buffer space is available."
msgstr "사용 가능한 소켓 버퍼 공간이 없습니다."

#: cefweaver.types.ErrorCode.SSL_CLIENT_AUTH_NO_COMMON_ALGORITHMS:1 of
msgid ""
"There were no common signature algorithms between our client certificate private key and the "
"server's preferences."
msgstr "클라이언트 인증서 개인 키와 서버의 선호 사항 사이에 공통된 서명 알고리즘이 없었습니다."

#: cefweaver.types.ErrorCode.EARLY_DATA_REJECTED:1 of
msgid "TLS 1.3 early data was rejected by the server."
msgstr "TLS 1.3 early data가 서버에 의해 거부되었습니다."

#: cefweaver.types.ErrorCode.EARLY_DATA_REJECTED:3 of
msgid ""
"This will be received before any data is returned from the socket. The request should be retried "
"with early data disabled."
msgstr "이는 소켓에서 데이터가 반환되기 전에 수신됩니다. early data를 비활성화하고 요청을 다시 시도해야 합니다."

#: cefweaver.types.ErrorCode.WRONG_VERSION_ON_EARLY_DATA:1 of
msgid "TLS 1.3 early data was offered, but the server responded with TLS 1.2 or earlier."
msgstr "TLS 1.3 early data를 제안했지만 서버가 TLS 1.2 이하로 응답했습니다."

#: cefweaver.types.ErrorCode.WRONG_VERSION_ON_EARLY_DATA:3 of
msgid ""
"This is an internal error code to account for a backwards-compatibility issue with early data and"
" TLS 1.2. It will be received before any data is returned from the socket. The request should be "
"retried with early data disabled."
msgstr ""
"이는 early data와 TLS 1.2의 하위 호환성 문제를 처리하기 위한 내부 오류 코드입니다. 소켓에서 데이터가 반환되기 전에 수신됩니다. early data를 "
"비활성화하고 요청을 다시 시도해야 합니다."

#: cefweaver.types.ErrorCode.WRONG_VERSION_ON_EARLY_DATA:7 of
msgid "See https://tools.ietf.org/html/rfc8446#appendix-D.3 for details."
msgstr "자세한 내용은 https://tools.ietf.org/html/rfc8446#appendix-D.3을 참조하십시오."

#: cefweaver.types.ErrorCode.TLS13_DOWNGRADE_DETECTED:1 of
msgid ""
"TLS 1.3 was enabled, but a lower version was negotiated and the server returned a value "
"indicating it supported TLS 1.3."
msgstr "TLS 1.3이 활성화되어 있었지만 더 낮은 버전이 협상되었고, 서버는 TLS 1.3을 지원한다는 것을 나타내는 값을 반환했습니다."

#: cefweaver.types.ErrorCode.TLS13_DOWNGRADE_DETECTED:3 of
msgid ""
"This is part of a security check in TLS 1.3, but it may also indicate the user is behind a buggy "
"TLS-terminating proxy which implemented TLS 1.2 incorrectly. (See "
"https://crbug.com/boringssl/226.)"
msgstr ""
"이는 TLS 1.3의 보안 검사의 일부이지만, 사용자가 TLS 1.2를 잘못 구현한 버그 있는 TLS 종단 proxy 뒤에 있음을 나타낼 수도 있습니다. "
"(https://crbug.com/boringssl/226을 참조하십시오.)"

#: cefweaver.types.ErrorCode.SSL_KEY_USAGE_INCOMPATIBLE:1 of
msgid ""
"The server's certificate has a keyUsage extension incompatible with the negotiated TLS key "
"exchange method."
msgstr "서버 인증서에 협상된 TLS 키 교환 방식과 호환되지 않는 keyUsage 확장이 있습니다."

#: cefweaver.types.ErrorCode.INVALID_ECH_CONFIG_LIST:1 of
msgid "The ECHConfigList fetched over DNS cannot be parsed."
msgstr "DNS로 가져온 ECHConfigList를 구문 분석할 수 없습니다."

#: cefweaver.types.ErrorCode.ECH_NOT_NEGOTIATED:1 of
msgid "ECH was enabled, but the server was unable to decrypt the encrypted ClientHello."
msgstr "ECH가 활성화되어 있었지만 서버가 암호화된 ClientHello를 복호화할 수 없었습니다."

#: cefweaver.types.ErrorCode.ECH_FALLBACK_CERTIFICATE_INVALID:1 of
msgid ""
"ECH was enabled, the server was unable to decrypt the encrypted ClientHello, and additionally did"
" not present a certificate valid for the public name."
msgstr "ECH가 활성화되어 있었는데 서버가 암호화된 ClientHello를 복호화할 수 없었고, 게다가 public name에 유효한 인증서도 제시하지 않았습니다."

#: cefweaver.types.ErrorCode.PROXY_UNABLE_TO_CONNECT_TO_DESTINATION:1 of
msgid ""
"An attempt to proxy a request failed because the proxy wasn't able to successfully connect to the"
" destination."
msgstr "proxy가 대상에 성공적으로 연결하지 못해서 요청을 proxy하려는 시도가 실패했습니다."

#: cefweaver.types.ErrorCode.PROXY_UNABLE_TO_CONNECT_TO_DESTINATION:3 of
msgid ""
"This likely indicates an issue with the request itself (for instance, the hostname failed to "
"resolve to an IP address or the destination server refused the connection). This error code is "
"used to indicate that the error is outside the control of the proxy server and thus the proxy "
"chain should not be marked as bad. This is in contrast to ERR_TUNNEL_CONNECTION_FAILED which is "
"used for general purpose errors connecting to the proxy and by the proxy request response "
"handling when a proxy delegate doesn't indicate via a different error code whether proxy fallback"
" should occur. Note that for IP Protection proxies this error code causes the proxy to be marked "
"as bad since the preference is to fail open for general purpose errors, but for other proxies "
"this error does not cause the proxy to be marked as bad."
msgstr ""
"이는 요청 자체의 문제를 나타낼 가능성이 큽니다(예: 호스트 이름을 IP 주소로 확인하지 못했거나 대상 서버가 연결을 거부했습니다). 이 오류 코드는 오류가 proxy 서버의"
" 통제 밖에 있으므로 proxy 체인을 불량으로 표시해서는 안 된다는 것을 나타내는 데 사용됩니다. 이는 proxy에 대한 일반적인 연결 오류와, proxy delegate가"
" 다른 오류 코드로 proxy fallback 발생 여부를 나타내지 않을 때 proxy 요청 응답 처리에 사용되는 ERR_TUNNEL_CONNECTION_FAILED와 "
"대조됩니다. IP Protection proxy의 경우 일반적인 오류에는 fail open을 선호하기 때문에 이 오류 코드가 proxy를 불량으로 표시하게 하지만, 다른 "
"proxy의 경우 이 오류는 proxy를 불량으로 표시하지 않는다는 점에 유의하십시오."

#: cefweaver.types.ErrorCode.PROXY_DELEGATE_CANCELED_CONNECT_REQUEST:1 of
msgid ""
"Some implementations of ProxyDelegate query a separate entity to know whether it should cancel "
"tunnel prior to:"
msgstr "ProxyDelegate의 일부 구현은 다음에 앞서 터널을 취소해야 하는지 알기 위해 별도의 엔터티에 질의합니다:"

#: cefweaver.types.ErrorCode.PROXY_DELEGATE_CANCELED_CONNECT_REQUEST:3 of
msgid "The HTTP CONNECT requests being sent out"
msgstr "HTTP CONNECT 요청이 전송되기 전"

#: cefweaver.types.ErrorCode.PROXY_DELEGATE_CANCELED_CONNECT_REQUEST:4 of
msgid ""
"The HTTP CONNECT response being parsed by //net An example is CronetProxyDelegate: Cronet allows "
"developers to decide whether the tunnel being established should be canceled."
msgstr ""
"HTTP CONNECT 응답이 //net에서 구문 분석되기 전. 예로 CronetProxyDelegate가 있습니다. Cronet은 개발자가 설정 중인 터널을 취소할지 "
"결정하도록 허용합니다."

#: cefweaver.types.ErrorCode.CONTROL_MSG_TOO_BIG:1 of
msgid "The control message was too large for the transport."
msgstr "제어 메시지가 전송에 비해 너무 컸습니다."

#: cefweaver.types.ErrorCode.CONTROL_MSG_TOO_BIG:3 of
msgid "(for example a UDP message control data exceeds size threshold)."
msgstr "(예: UDP 메시지 제어 데이터가 크기 임계값을 초과합니다)."

#: cefweaver.types.ErrorCode.MULTICAST_NOT_ALLOWED:1 of
msgid ""
"Direct Sockets attempted to connect to or send a packet to a multicast address without 'direct-"
"sockets-multicast' permissions policy."
msgstr "Direct Sockets가 'direct-sockets-multicast' 권한 정책 없이 multicast 주소에 연결하거나 패킷을 보내려고 시도했습니다."

#: cefweaver.types.ErrorCode.CERT_COMMON_NAME_INVALID:1 of
msgid "The server responded with a certificate whose common name did not match the host name."
msgstr "서버가 common name이 호스트 이름과 일치하지 않는 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_COMMON_NAME_INVALID:3 cefweaver.types.ErrorCode.CERT_DATE_INVALID:3
#: cefweaver.types.ErrorCode.CERT_UNABLE_TO_CHECK_REVOCATION:3 of
msgid "This could mean:"
msgstr "이는 다음을 의미할 수 있습니다:"

#: cefweaver.types.ErrorCode.CERT_COMMON_NAME_INVALID:5 of
msgid ""
"An attacker has redirected our traffic to their server and is presenting a certificate for which "
"they know the private key."
msgstr "공격자가 우리 트래픽을 자신의 서버로 리디렉션했고, 개인 키를 알고 있는 인증서를 제시하고 있습니다."

#: cefweaver.types.ErrorCode.CERT_COMMON_NAME_INVALID:7 of
msgid "The server is misconfigured and responding with the wrong cert."
msgstr "서버가 잘못 구성되어 있고 잘못된 인증서로 응답하고 있습니다."

#: cefweaver.types.ErrorCode.CERT_COMMON_NAME_INVALID:8 of
msgid "The user is on a wireless network and is being redirected to the network's login page."
msgstr "사용자가 무선 네트워크에 있고 그 네트워크의 로그인 페이지로 리디렉션되고 있습니다."

#: cefweaver.types.ErrorCode.CERT_COMMON_NAME_INVALID:10 of
msgid ""
"The OS has used a DNS search suffix and the server doesn't have a certificate for the abbreviated"
" name in the address bar."
msgstr "OS가 DNS 검색 접미사를 사용했고, 서버에 주소 표시줄의 축약된 이름에 대한 인증서가 없습니다."

#: cefweaver.types.ErrorCode.CERT_DATE_INVALID:1 of
msgid ""
"The server responded with a certificate that, by our clock, appears to either not yet be valid or"
" to have expired."
msgstr "서버가 우리 시계 기준으로 아직 유효하지 않거나 만료된 것으로 보이는 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_DATE_INVALID:5 of
msgid ""
"An attacker is presenting an old certificate for which they have managed to obtain the private "
"key."
msgstr "공격자가 개인 키를 얻는 데 성공한 오래된 인증서를 제시하고 있습니다."

#: cefweaver.types.ErrorCode.CERT_DATE_INVALID:7 of
msgid "The server is misconfigured and is not presenting a valid cert."
msgstr "서버가 잘못 구성되어 있고 유효한 인증서를 제시하지 않고 있습니다."

#: cefweaver.types.ErrorCode.CERT_DATE_INVALID:8 of
msgid "Our clock is wrong."
msgstr "우리 시계가 잘못되었습니다."

#: cefweaver.types.ErrorCode.CERT_AUTHORITY_INVALID:1 of
msgid "The server responded with a certificate that is signed by an authority we don't trust."
msgstr "서버가 우리가 신뢰하지 않는 기관이 서명한 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_AUTHORITY_INVALID:3 of
msgid "The could mean:"
msgstr "이는 다음을 의미할 수 있습니다:"

#: cefweaver.types.ErrorCode.CERT_AUTHORITY_INVALID:5 of
msgid ""
"An attacker has substituted the real certificate for a cert that contains their public key and is"
" signed by their cousin."
msgstr "공격자가 실제 인증서를 자신의 공개 키를 담고 그들의 사촌이 서명한 인증서로 바꿔치기했습니다."

#: cefweaver.types.ErrorCode.CERT_AUTHORITY_INVALID:7 of
msgid "The server operator has a legitimate certificate from a CA we don't know about, but should trust."
msgstr "서버 운영자가 우리가 모르지만 신뢰해야 하는 CA의 정당한 인증서를 가지고 있습니다."

#: cefweaver.types.ErrorCode.CERT_AUTHORITY_INVALID:9 of
msgid ""
"The server is presenting a self-signed certificate, providing no defense against active attackers"
" (but foiling passive attackers)."
msgstr "서버가 자체 서명 인증서를 제시하고 있으며, 이는 능동적 공격자에 대한 방어를 제공하지 않습니다(하지만 수동적 공격자는 막습니다)."

#: cefweaver.types.ErrorCode.CERT_CONTAINS_ERRORS:1 of
msgid "The server responded with a certificate that contains errors."
msgstr "서버가 오류가 있는 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_CONTAINS_ERRORS:3 cefweaver.types.ErrorCode.CERT_INVALID:3 of
msgid "This error is not recoverable."
msgstr "이 오류는 복구할 수 없습니다."

#: cefweaver.types.ErrorCode.CERT_CONTAINS_ERRORS:5 of
msgid ""
"MSDN describes this error as follows: \"The SSL certificate contains errors.\" NOTE: It's unclear"
" how this differs from ERR_CERT_INVALID. For consistency, use that code instead of this one from "
"now on."
msgstr ""
"MSDN은 이 오류를 다음과 같이 설명합니다. \"SSL 인증서에 오류가 있습니다.\" 참고: 이것이 ERR_CERT_INVALID와 어떻게 다른지는 불분명합니다. 일관성을 "
"위해 앞으로는 이 코드 대신 그 코드를 사용하십시오."

#: cefweaver.types.ErrorCode.CERT_NO_REVOCATION_MECHANISM:1 of
msgid "The certificate has no mechanism for determining if it is revoked."
msgstr "인증서에 폐기 여부를 판단할 수단이 없습니다."

#: cefweaver.types.ErrorCode.CERT_NO_REVOCATION_MECHANISM:3 of
msgid "In effect, this certificate cannot be revoked."
msgstr "사실상 이 인증서는 폐기할 수 없습니다."

#: cefweaver.types.ErrorCode.CERT_UNABLE_TO_CHECK_REVOCATION:1 of
msgid "Revocation information for the security certificate for this site is not available."
msgstr "이 사이트의 보안 인증서에 대한 폐기 정보를 사용할 수 없습니다."

#: cefweaver.types.ErrorCode.CERT_UNABLE_TO_CHECK_REVOCATION:5 of
msgid ""
"An attacker has compromised the private key in the certificate and is blocking our attempt to "
"find out that the cert was revoked."
msgstr "공격자가 인증서의 개인 키를 탈취했으며, 인증서가 폐기되었는지 확인하려는 시도를 막고 있습니다."

#: cefweaver.types.ErrorCode.CERT_UNABLE_TO_CHECK_REVOCATION:7 of
msgid "The certificate is unrevoked, but the revocation server is busy or unavailable."
msgstr "인증서는 폐기되지 않았지만 폐기 서버가 사용 중이거나 사용할 수 없습니다."

#: cefweaver.types.ErrorCode.CERT_REVOKED:1 of
msgid "The server responded with a certificate has been revoked."
msgstr "서버가 폐기된 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_REVOKED:3 of
msgid "We have the capability to ignore this error, but it is probably not the thing to do."
msgstr "이 오류를 무시할 수는 있지만 그렇게 하는 것은 바람직하지 않을 가능성이 큽니다."

#: cefweaver.types.ErrorCode.CERT_INVALID:1 of
msgid "The server responded with a certificate that is invalid."
msgstr "서버가 유효하지 않은 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_INVALID:5 of
msgid "MSDN describes this error as follows: \"The SSL certificate is invalid.\""
msgstr "MSDN은 이 오류를 다음과 같이 설명합니다. \"SSL 인증서가 유효하지 않습니다.\""

#: cefweaver.types.ErrorCode.CERT_WEAK_SIGNATURE_ALGORITHM:1 of
msgid "The server responded with a certificate that is signed using a weak signature algorithm."
msgstr "서버가 취약한 서명 알고리즘으로 서명된 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_NON_UNIQUE_NAME:1 of
msgid "The host name specified in the certificate is not unique."
msgstr "인증서에 지정된 호스트 이름이 고유하지 않습니다."

#: cefweaver.types.ErrorCode.CERT_WEAK_KEY:1 of
msgid "The server responded with a certificate that contains a weak key (e.g."
msgstr "서버가 취약한 키(예:"

#: cefweaver.types.ErrorCode.CERT_WEAK_KEY:3 of
msgid "a too-small RSA key)."
msgstr "너무 작은 RSA 키)를 포함한 인증서로 응답했습니다."

#: cefweaver.types.ErrorCode.CERT_NAME_CONSTRAINT_VIOLATION:1 of
msgid "The certificate claimed DNS names that are in violation of name constraints."
msgstr "인증서가 이름 제약 조건을 위반하는 DNS 이름을 주장했습니다."

#: cefweaver.types.ErrorCode.CERT_VALIDITY_TOO_LONG:1 of
msgid "The certificate's validity period is too long."
msgstr "인증서의 유효 기간이 너무 깁니다."

#: cefweaver.types.ErrorCode.CERTIFICATE_TRANSPARENCY_REQUIRED:1 of
msgid ""
"Certificate Transparency was required for this connection, but the server did not provide CT "
"information that complied with the policy."
msgstr "이 연결에는 Certificate Transparency가 필요했지만, 서버가 정책을 준수하는 CT 정보를 제공하지 않았습니다."

#: cefweaver.types.ErrorCode.CERT_KNOWN_INTERCEPTION_BLOCKED:1 of
msgid "The certificate is known to be used for interception by an entity other the device owner."
msgstr "이 인증서는 장치 소유자가 아닌 다른 주체가 가로채기(interception)에 사용하는 것으로 알려져 있습니다."

#: cefweaver.types.ErrorCode.CERT_SELF_SIGNED_LOCAL_NETWORK:1 of
msgid ""
"The certificate is self signed and it's being used for either an RFC1918 IP literal URL, or a url"
" ending in .local."
msgstr "이 인증서는 자체 서명되었으며 RFC1918 IP 리터럴 URL 또는 .local로 끝나는 URL에 사용되고 있습니다."

#: cefweaver.types.ErrorCode.CERT_END:1 of
msgid "The value immediately past the last certificate error code."
msgstr "마지막 인증서 오류 코드 바로 다음의 값."

#: cefweaver.types.ErrorCode.INVALID_URL:1 of
msgid "The URL is invalid."
msgstr "URL이 유효하지 않습니다."

#: cefweaver.types.ErrorCode.DISALLOWED_URL_SCHEME:1 of
msgid "The scheme of the URL is disallowed."
msgstr "URL의 scheme이 허용되지 않습니다."

#: cefweaver.types.ErrorCode.UNKNOWN_URL_SCHEME:1 of
msgid "The scheme of the URL is unknown."
msgstr "URL의 scheme을 알 수 없습니다."

#: cefweaver.types.ErrorCode.INVALID_REDIRECT:1 of
msgid "Attempting to load an URL resulted in a redirect to an invalid URL."
msgstr "URL을 로드하려는 시도가 유효하지 않은 URL로의 리디렉션으로 이어졌습니다."

#: cefweaver.types.ErrorCode.TOO_MANY_REDIRECTS:1 of
msgid "Attempting to load an URL resulted in too many redirects."
msgstr "URL을 로드하려는 시도가 너무 많은 리디렉션으로 이어졌습니다."

#: cefweaver.types.ErrorCode.UNSAFE_REDIRECT:1 of
msgid ""
"Attempting to load an URL resulted in an unsafe redirect (e.g., a redirect to file:// is "
"considered unsafe)."
msgstr "URL을 로드하려는 시도가 안전하지 않은 리디렉션으로 이어졌습니다(예: file://로의 리디렉션은 안전하지 않은 것으로 간주됩니다)."

#: cefweaver.types.ErrorCode.UNSAFE_PORT:1 of
msgid "Attempting to load an URL with an unsafe port number."
msgstr "안전하지 않은 포트 번호로 URL을 로드하려는 시도입니다."

#: cefweaver.types.ErrorCode.UNSAFE_PORT:3 of
msgid ""
"These are port numbers that correspond to services, which are not robust to spurious input that "
"may be constructed as a result of an allowed web construct (e.g., HTTP looks a lot like SMTP, so "
"form submission to port 25 is denied)."
msgstr ""
"서비스에 해당하는 포트 번호이며, 허용된 웹 구성 요소의 결과로 만들어질 수 있는 의도치 않은 입력에 견고하지 않습니다(예: HTTP는 SMTP와 매우 비슷하게 보이므로 포트"
" 25로의 폼 제출은 거부됩니다)."

#: cefweaver.types.ErrorCode.INVALID_RESPONSE:1 of
msgid "The server's response was invalid."
msgstr "서버의 응답이 유효하지 않았습니다."

#: cefweaver.types.ErrorCode.INVALID_CHUNKED_ENCODING:1 of
msgid "Error in chunked transfer encoding."
msgstr "chunked 전송 인코딩에 오류가 있습니다."

#: cefweaver.types.ErrorCode.METHOD_NOT_SUPPORTED:1 of
msgid "The server did not support the request method."
msgstr "서버가 요청 메서드를 지원하지 않았습니다."

#: cefweaver.types.ErrorCode.UNEXPECTED_PROXY_AUTH:1 of
msgid "The response was 407 (Proxy Authentication Required), yet we did not send the request to a proxy."
msgstr "응답이 407(Proxy Authentication Required)이었지만 요청을 proxy로 보내지 않았습니다."

#: cefweaver.types.ErrorCode.EMPTY_RESPONSE:1 of
msgid "The server closed the connection without sending any data."
msgstr "서버가 데이터를 보내지 않고 연결을 닫았습니다."

#: cefweaver.types.ErrorCode.RESPONSE_HEADERS_TOO_BIG:1 of
msgid "The headers section of the response is too large."
msgstr "응답의 헤더 섹션이 너무 큽니다."

#: cefweaver.types.ErrorCode.PAC_SCRIPT_FAILED:1 of
msgid "The evaluation of the PAC script failed."
msgstr "PAC 스크립트의 평가에 실패했습니다."

#: cefweaver.types.ErrorCode.REQUEST_RANGE_NOT_SATISFIABLE:1 of
msgid ""
"The response was 416 (Requested range not satisfiable) and the server cannot satisfy the range "
"requested."
msgstr "응답이 416(Requested range not satisfiable)이었으며, 서버가 요청된 범위를 충족할 수 없습니다."

#: cefweaver.types.ErrorCode.MALFORMED_IDENTITY:1 of
msgid "The identity used for authentication is invalid."
msgstr "인증에 사용된 ID가 유효하지 않습니다."

#: cefweaver.types.ErrorCode.CONTENT_DECODING_FAILED:1 of
msgid "Content decoding of the response body failed."
msgstr "응답 본문의 콘텐츠 디코딩에 실패했습니다."

#: cefweaver.types.ErrorCode.NETWORK_IO_SUSPENDED:1 of
msgid "An operation could not be completed because all network IO is suspended."
msgstr "모든 네트워크 IO가 일시 중단되어 작업을 완료할 수 없었습니다."

#: cefweaver.types.ErrorCode.NO_SUPPORTED_PROXIES:1 of
msgid "There are no supported proxies in the provided list."
msgstr "제공된 목록에 지원되는 proxy가 없습니다."

#: cefweaver.types.ErrorCode.HTTP2_PROTOCOL_ERROR:1 of
msgid "There is an HTTP/2 protocol error."
msgstr "HTTP/2 프로토콜 오류가 있습니다."

#: cefweaver.types.ErrorCode.INVALID_AUTH_CREDENTIALS:1 of
msgid "Credentials could not be established during HTTP Authentication."
msgstr "HTTP 인증 중에 자격 증명을 설정할 수 없었습니다."

#: cefweaver.types.ErrorCode.UNSUPPORTED_AUTH_SCHEME:1 of
msgid "An HTTP Authentication scheme was tried which is not supported on this machine."
msgstr "이 컴퓨터에서 지원되지 않는 HTTP 인증 scheme을 시도했습니다."

#: cefweaver.types.ErrorCode.ENCODING_DETECTION_FAILED:1 of
msgid "Detecting the encoding of the response failed."
msgstr "응답의 인코딩 감지에 실패했습니다."

#: cefweaver.types.ErrorCode.MISSING_AUTH_CREDENTIALS:1 of
msgid "(GSSAPI) No Kerberos credentials were available during HTTP Authentication."
msgstr "(GSSAPI) HTTP 인증 중에 사용할 수 있는 Kerberos 자격 증명이 없었습니다."

#: cefweaver.types.ErrorCode.UNEXPECTED_SECURITY_LIBRARY_STATUS:1 of
msgid "An unexpected, but documented, SSPI or GSSAPI status code was returned."
msgstr "예상하지 못했지만 문서화된 SSPI 또는 GSSAPI 상태 코드가 반환되었습니다."

#: cefweaver.types.ErrorCode.MISCONFIGURED_AUTH_ENVIRONMENT:1 of
msgid ""
"The environment was not set up correctly for authentication (for example, no KDC could be found "
"or the principal is unknown."
msgstr "인증을 위한 환경이 올바르게 설정되지 않았습니다(예: KDC를 찾을 수 없거나 principal을 알 수 없음)."

#: cefweaver.types.ErrorCode.UNDOCUMENTED_SECURITY_LIBRARY_STATUS:1 of
msgid "An undocumented SSPI or GSSAPI status code was returned."
msgstr "문서화되지 않은 SSPI 또는 GSSAPI 상태 코드가 반환되었습니다."

#: cefweaver.types.ErrorCode.RESPONSE_BODY_TOO_BIG_TO_DRAIN:1 of
msgid "The HTTP response was too big to drain."
msgstr "HTTP 응답이 너무 커서 비울(drain) 수 없었습니다."

#: cefweaver.types.ErrorCode.RESPONSE_HEADERS_MULTIPLE_CONTENT_LENGTH:1 of
msgid "The HTTP response contained multiple distinct Content-Length headers."
msgstr "HTTP 응답에 서로 다른 Content-Length 헤더가 여러 개 포함되어 있었습니다."

#: cefweaver.types.ErrorCode.INCOMPLETE_HTTP2_HEADERS:1 of
msgid ""
"HTTP/2 headers have been received, but not all of them - status or version headers are missing, "
"so we're expecting additional frames to complete them."
msgstr "HTTP/2 헤더를 받았지만 전부는 아닙니다. 상태 또는 버전 헤더가 없으므로, 이를 완성할 추가 frame을 기다리고 있습니다."

#: cefweaver.types.ErrorCode.PAC_NOT_IN_DHCP:1 of
msgid "No PAC URL configuration could be retrieved from DHCP."
msgstr "DHCP에서 PAC URL 구성을 가져올 수 없었습니다."

#: cefweaver.types.ErrorCode.PAC_NOT_IN_DHCP:3 of
msgid ""
"This can indicate either a failure to retrieve the DHCP configuration, or that there was no PAC "
"URL configured in DHCP."
msgstr "DHCP 구성을 가져오지 못했거나 DHCP에 PAC URL이 구성되어 있지 않다는 뜻일 수 있습니다."

#: cefweaver.types.ErrorCode.RESPONSE_HEADERS_MULTIPLE_CONTENT_DISPOSITION:1 of
msgid "The HTTP response contained multiple Content-Disposition headers."
msgstr "HTTP 응답에 Content-Disposition 헤더가 여러 개 포함되어 있었습니다."

#: cefweaver.types.ErrorCode.RESPONSE_HEADERS_MULTIPLE_LOCATION:1 of
msgid "The HTTP response contained multiple Location headers."
msgstr "HTTP 응답에 Location 헤더가 여러 개 포함되어 있었습니다."

#: cefweaver.types.ErrorCode.HTTP2_SERVER_REFUSED_STREAM:1 of
msgid ""
"HTTP/2 server refused the request without processing, and sent either a GOAWAY frame with error "
"code NO_ERROR and Last-Stream-ID lower than the stream id corresponding to the request indicating"
" that this request has not been processed yet, or a RST_STREAM frame with error code "
"REFUSED_STREAM."
msgstr ""
"HTTP/2 서버가 요청을 처리하지 않고 거부했으며, 오류 코드 NO_ERROR와 이 요청에 해당하는 스트림 ID보다 낮은 Last-Stream-ID를 가진 GOAWAY "
"frame(이 요청이 아직 처리되지 않았음을 나타냄) 또는 오류 코드 REFUSED_STREAM을 가진 RST_STREAM frame을 보냈습니다."

#: cefweaver.types.ErrorCode.HTTP2_SERVER_REFUSED_STREAM:3 of
msgid "Client MAY retry (on a different connection).  See RFC7540 Section 8.1.4."
msgstr "클라이언트는 (다른 연결에서) 재시도할 수 있습니다(MAY).  RFC7540 Section 8.1.4를 참고하십시오."

#: cefweaver.types.ErrorCode.HTTP2_PING_FAILED:1 of
msgid "HTTP/2 server didn't respond to the PING message."
msgstr "HTTP/2 서버가 PING 메시지에 응답하지 않았습니다."

#: cefweaver.types.ErrorCode.CONTENT_LENGTH_MISMATCH:1 of
msgid ""
"The HTTP response body transferred fewer bytes than were advertised by the Content-Length header "
"when the connection is closed."
msgstr "연결이 닫힐 때 HTTP 응답 본문으로 전송된 바이트 수가 Content-Length 헤더에 명시된 것보다 적었습니다."

#: cefweaver.types.ErrorCode.INCOMPLETE_CHUNKED_ENCODING:1 of
msgid ""
"The HTTP response body is transferred with Chunked-Encoding, but the terminating zero-length "
"chunk was never sent when the connection is closed."
msgstr "HTTP 응답 본문이 Chunked-Encoding으로 전송되었지만, 연결이 닫힐 때까지 길이가 0인 종료 chunk가 전송되지 않았습니다."

#: cefweaver.types.ErrorCode.QUIC_PROTOCOL_ERROR:1 of
msgid "There is a QUIC protocol error."
msgstr "QUIC 프로토콜 오류가 있습니다."

#: cefweaver.types.ErrorCode.RESPONSE_HEADERS_TRUNCATED:1 of
msgid "The HTTP headers were truncated by an EOF."
msgstr "HTTP 헤더가 EOF로 잘렸습니다."

#: cefweaver.types.ErrorCode.QUIC_HANDSHAKE_FAILED:1 of
msgid "The QUIC crypto handshake failed."
msgstr "QUIC crypto 핸드셰이크에 실패했습니다."

#: cefweaver.types.ErrorCode.QUIC_HANDSHAKE_FAILED:3 of
msgid "This means that the server was unable to read any requests sent, so they may be resent."
msgstr "서버가 보낸 요청을 하나도 읽을 수 없었으므로 요청을 다시 보낼 수 있다는 뜻입니다."

#: cefweaver.types.ErrorCode.HTTP2_INADEQUATE_TRANSPORT_SECURITY:1 of
msgid "Transport security is inadequate for the HTTP/2 version."
msgstr "전송 보안이 HTTP/2 버전에 적합하지 않습니다."

#: cefweaver.types.ErrorCode.HTTP2_FLOW_CONTROL_ERROR:1 of
msgid "The peer violated HTTP/2 flow control."
msgstr "피어가 HTTP/2 흐름 제어를 위반했습니다."

#: cefweaver.types.ErrorCode.HTTP2_FRAME_SIZE_ERROR:1 of
msgid "The peer sent an improperly sized HTTP/2 frame."
msgstr "피어가 크기가 올바르지 않은 HTTP/2 frame을 보냈습니다."

#: cefweaver.types.ErrorCode.HTTP2_COMPRESSION_ERROR:1 of
msgid "Decoding or encoding of compressed HTTP/2 headers failed."
msgstr "압축된 HTTP/2 헤더의 디코딩 또는 인코딩에 실패했습니다."

#: cefweaver.types.ErrorCode.PROXY_AUTH_REQUESTED_WITH_NO_CONNECTION:1 of
msgid "Proxy Auth Requested without a valid Client Socket Handle."
msgstr "유효한 클라이언트 소켓 핸들 없이 Proxy Auth가 요청되었습니다."

#: cefweaver.types.ErrorCode.HTTP_1_1_REQUIRED:1 of
msgid "HTTP_1_1_REQUIRED error code received on HTTP/2 session."
msgstr "HTTP/2 세션에서 HTTP_1_1_REQUIRED 오류 코드를 받았습니다."

#: cefweaver.types.ErrorCode.PROXY_HTTP_1_1_REQUIRED:1 of
msgid "HTTP_1_1_REQUIRED error code received on HTTP/2 session to proxy."
msgstr "proxy로의 HTTP/2 세션에서 HTTP_1_1_REQUIRED 오류 코드를 받았습니다."

#: cefweaver.types.ErrorCode.PAC_SCRIPT_TERMINATED:1 of
msgid "The PAC script terminated fatally and must be reloaded."
msgstr "PAC 스크립트가 치명적으로 종료되어 다시 로드해야 합니다."

#: cefweaver.types.ErrorCode.INVALID_HTTP_RESPONSE:1 of
msgid "The server was expected to return an HTTP/1.x response, but did not."
msgstr "서버가 HTTP/1.x 응답을 반환해야 했지만 그러지 않았습니다."

#: cefweaver.types.ErrorCode.INVALID_HTTP_RESPONSE:3 of
msgid "Rather than treat it as HTTP/0.9, this error is returned."
msgstr "HTTP/0.9로 처리하는 대신 이 오류가 반환됩니다."

#: cefweaver.types.ErrorCode.CONTENT_DECODING_INIT_FAILED:1 of
msgid "Initializing content decoding failed."
msgstr "콘텐츠 디코딩 초기화에 실패했습니다."

#: cefweaver.types.ErrorCode.HTTP2_RST_STREAM_NO_ERROR_RECEIVED:1 of
msgid "Received HTTP/2 RST_STREAM frame with NO_ERROR error code."
msgstr "오류 코드 NO_ERROR를 가진 HTTP/2 RST_STREAM frame을 받았습니다."

#: cefweaver.types.ErrorCode.HTTP2_RST_STREAM_NO_ERROR_RECEIVED:3 of
msgid ""
"This error should be handled internally by HTTP/2 code, and should not make it above the "
"SpdyStream layer."
msgstr "이 오류는 HTTP/2 코드 내부에서 처리되어야 하며 SpdyStream 계층 위로 올라가서는 안 됩니다."

#: cefweaver.types.ErrorCode.TOO_MANY_RETRIES:1 of
msgid "An HTTP transaction was retried too many times due for authentication or invalid certificates."
msgstr "인증 또는 유효하지 않은 인증서 때문에 HTTP 트랜잭션이 너무 많이 재시도되었습니다."

#: cefweaver.types.ErrorCode.TOO_MANY_RETRIES:3 of
msgid ""
"This may be due to a bug in the net stack that would otherwise infinite loop, or if the server or"
" proxy continually requests fresh credentials or presents a fresh invalid certificate."
msgstr ""
"그대로 두면 무한 루프에 빠질 수 있는 net 스택의 버그 때문일 수도 있고, 서버나 proxy가 새 자격 증명을 계속 요청하거나 새로운 유효하지 않은 인증서를 계속 제시하기"
" 때문일 수도 있습니다."

#: cefweaver.types.ErrorCode.HTTP2_STREAM_CLOSED:1 of
msgid "Received an HTTP/2 frame on a closed stream."
msgstr "닫힌 스트림에서 HTTP/2 frame을 받았습니다."

#: cefweaver.types.ErrorCode.HTTP_RESPONSE_CODE_FAILURE:1 of
msgid "The server returned a non-2xx HTTP response code."
msgstr "서버가 2xx가 아닌 HTTP 응답 코드를 반환했습니다."

#: cefweaver.types.ErrorCode.HTTP_RESPONSE_CODE_FAILURE:3 of
msgid ""
"Note that this error is only used by certain APIs that interpret the HTTP response itself. "
"URLRequest for instance just passes most non-2xx response back as success."
msgstr "이 오류는 HTTP 응답 자체를 해석하는 일부 API에서만 사용됩니다. 예를 들어 URLRequest는 2xx가 아닌 대부분의 응답을 성공으로 그대로 전달합니다."

#: cefweaver.types.ErrorCode.QUIC_CERT_ROOT_NOT_KNOWN:1 of
msgid ""
"The certificate presented on a QUIC connection does not chain to a known root and the origin "
"connected to is not on a list of domains where unknown roots are allowed."
msgstr "QUIC 연결에서 제시된 인증서가 알려진 루트로 체인되지 않으며, 연결된 origin이 알 수 없는 루트를 허용하는 도메인 목록에 없습니다."

#: cefweaver.types.ErrorCode.QUIC_GOAWAY_REQUEST_CAN_BE_RETRIED:1 of
msgid ""
"A GOAWAY frame has been received indicating that the request has not been processed and is "
"therefore safe to retry on a different connection."
msgstr "요청이 처리되지 않았으므로 다른 연결에서 안전하게 재시도할 수 있음을 나타내는 GOAWAY frame을 받았습니다."

#: cefweaver.types.ErrorCode.TOO_MANY_ACCEPT_CH_RESTARTS:1 of
msgid "The ACCEPT_CH restart has been triggered too many times"
msgstr "ACCEPT_CH 재시작이 너무 많이 트리거되었습니다"

#: cefweaver.types.ErrorCode.INCONSISTENT_IP_ADDRESS_SPACE:1 of
msgid ""
"The IP address space of the remote endpoint differed from the previous observed value during the "
"same request."
msgstr "같은 요청 동안 원격 엔드포인트의 IP 주소 공간이 이전에 관찰된 값과 달랐습니다."

#: cefweaver.types.ErrorCode.INCONSISTENT_IP_ADDRESS_SPACE:3 of
msgid "Any cache entry for the affected request should be invalidated."
msgstr "해당 요청에 영향을 받는 모든 캐시 항목은 무효화해야 합니다."

#: cefweaver.types.ErrorCode.CACHED_IP_ADDRESS_SPACE_BLOCKED_BY_LOCAL_NETWORK_ACCESS_POLICY:1 of
msgid "The IP address space of the cached remote endpoint is blocked by private network access check."
msgstr "캐시된 원격 엔드포인트의 IP 주소 공간이 사설 네트워크 접근 검사에 의해 차단되었습니다."

#: cefweaver.types.ErrorCode.BLOCKED_BY_LOCAL_NETWORK_ACCESS_CHECKS:1 of
msgid "The connection is blocked by private network access checks."
msgstr "연결이 사설 네트워크 접근 검사에 의해 차단되었습니다."

#: cefweaver.types.ErrorCode.ZSTD_WINDOW_SIZE_TOO_BIG:1 of
msgid "Content decoding failed due to the zstd window size being too big (over 8MB)."
msgstr "zstd 창 크기가 너무 커서(8MB 초과) 콘텐츠 디코딩에 실패했습니다."

#: cefweaver.types.ErrorCode.DICTIONARY_LOAD_FAILED:1 of
msgid "The compression dictionary cannot be loaded."
msgstr "압축 사전을 로드할 수 없습니다."

#: cefweaver.types.ErrorCode.UNEXPECTED_CONTENT_DICTIONARY_HEADER:1 of
msgid "The header of dictionary compressed stream does not match the expected value."
msgstr "사전 압축 스트림의 헤더가 기대한 값과 일치하지 않습니다."

#: cefweaver.types.ErrorCode.CACHE_MISS:1 of
msgid "The cache does not have the requested entry."
msgstr "캐시에 요청한 항목이 없습니다."

#: cefweaver.types.ErrorCode.CACHE_READ_FAILURE:1 of
msgid "Unable to read from the disk cache."
msgstr "디스크 캐시에서 읽을 수 없습니다."

#: cefweaver.types.ErrorCode.CACHE_WRITE_FAILURE:1 of
msgid "Unable to write to the disk cache."
msgstr "디스크 캐시에 쓸 수 없습니다."

#: cefweaver.types.ErrorCode.CACHE_OPERATION_NOT_SUPPORTED:1 of
msgid "The operation is not supported for this entry."
msgstr "이 항목에서는 해당 작업이 지원되지 않습니다."

#: cefweaver.types.ErrorCode.CACHE_OPEN_FAILURE:1 of
msgid "The disk cache is unable to open this entry."
msgstr "디스크 캐시가 이 항목을 열 수 없습니다."

#: cefweaver.types.ErrorCode.CACHE_CREATE_FAILURE:1 of
msgid "The disk cache is unable to create this entry."
msgstr "디스크 캐시가 이 항목을 만들 수 없습니다."

#: cefweaver.types.ErrorCode.CACHE_RACE:1 of
msgid "Multiple transactions are racing to create disk cache entries."
msgstr "여러 트랜잭션이 디스크 캐시 항목을 만들려고 경합하고 있습니다."

#: cefweaver.types.ErrorCode.CACHE_RACE:3 of
msgid ""
"This is an internal error returned from the HttpCache to the HttpCacheTransaction that tells the "
"transaction to restart the entry-creation logic because the state of the cache has changed."
msgstr "캐시의 상태가 바뀌었으므로 항목 생성 로직을 다시 시작하라고 HttpCache가 HttpCacheTransaction에 알려 주는 내부 오류입니다."

#: cefweaver.types.ErrorCode.CACHE_CHECKSUM_READ_FAILURE:1 of
msgid "The cache was unable to read a checksum record on an entry."
msgstr "캐시가 항목의 체크섬 레코드를 읽을 수 없었습니다."

#: cefweaver.types.ErrorCode.CACHE_CHECKSUM_MISMATCH:3
#: cefweaver.types.ErrorCode.CACHE_CHECKSUM_READ_FAILURE:3 of
msgid ""
"This can be returned from attempts to read from the cache. It is an internal error, returned by "
"the SimpleCache backend, but not by any URLRequest methods or members."
msgstr "캐시에서 읽으려는 시도에서 반환될 수 있습니다. SimpleCache 백엔드가 반환하는 내부 오류이며, URLRequest의 메서드나 멤버에서는 반환되지 않습니다."

#: cefweaver.types.ErrorCode.CACHE_CHECKSUM_MISMATCH:1 of
msgid "The cache found an entry with an invalid checksum."
msgstr "캐시에서 체크섬이 유효하지 않은 항목을 발견했습니다."

#: cefweaver.types.ErrorCode.CACHE_LOCK_TIMEOUT:1 of
msgid "Internal error code for the HTTP cache."
msgstr "HTTP 캐시의 내부 오류 코드."

#: cefweaver.types.ErrorCode.CACHE_LOCK_TIMEOUT:3 of
msgid "The cache lock timeout has fired."
msgstr "캐시 잠금 시간 제한이 발생했습니다."

#: cefweaver.types.ErrorCode.CACHE_AUTH_FAILURE_AFTER_READ:1 of
msgid ""
"Received a challenge after the transaction has read some data, and the credentials aren't "
"available."
msgstr "트랜잭션이 일부 데이터를 읽은 뒤에 챌린지를 받았고, 자격 증명을 사용할 수 없습니다."

#: cefweaver.types.ErrorCode.CACHE_AUTH_FAILURE_AFTER_READ:3 of
msgid "There isn't a way to get them at that point."
msgstr "그 시점에는 자격 증명을 얻을 방법이 없습니다."

#: cefweaver.types.ErrorCode.CACHE_ENTRY_NOT_SUITABLE:1 of
msgid "Internal not-quite error code for the HTTP cache."
msgstr "HTTP 캐시의 내부용, 오류에 가까운 코드."

#: cefweaver.types.ErrorCode.CACHE_ENTRY_NOT_SUITABLE:3 of
msgid ""
"In-memory hints suggest that the cache entry would not have been usable with the transaction's "
"current configuration (e.g. load flags, mode, etc.)"
msgstr "메모리 내 힌트에 따르면 해당 캐시 항목은 트랜잭션의 현재 구성(예: 로드 플래그, 모드 등)에서 사용할 수 없었을 것입니다."

#: cefweaver.types.ErrorCode.CACHE_DOOM_FAILURE:1 of
msgid "The disk cache is unable to doom this entry."
msgstr "디스크 캐시가 이 항목을 doom할 수 없습니다."

#: cefweaver.types.ErrorCode.CACHE_OPEN_OR_CREATE_FAILURE:1 of
msgid "The disk cache is unable to open or create this entry."
msgstr "디스크 캐시가 이 항목을 열거나 만들 수 없습니다."

#: cefweaver.types.ErrorCode.CACHE_COMPRESSION_FAILURE:1 of
msgid "Zstd compression of a cache entry body failed."
msgstr "캐시 항목 본문의 Zstd 압축에 실패했습니다."

#: cefweaver.types.ErrorCode.INSECURE_RESPONSE:1 of
msgid "The server's response was insecure (e.g."
msgstr "서버의 응답이 안전하지 않았습니다(예:"

#: cefweaver.types.ErrorCode.INSECURE_RESPONSE:3 of
msgid "there was a cert error)."
msgstr "인증서 오류가 있었습니다)."

#: cefweaver.types.ErrorCode.NO_PRIVATE_KEY_FOR_CERT:1 of
msgid ""
"An attempt to import a client certificate failed, as the user's key database lacked a "
"corresponding private key."
msgstr "사용자의 키 데이터베이스에 해당하는 개인 키가 없어서 클라이언트 인증서 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.ADD_USER_CERT_FAILED:1 of
msgid "An error adding a certificate to the OS certificate database."
msgstr "OS 인증서 데이터베이스에 인증서를 추가하는 중 오류가 발생했습니다."

#: cefweaver.types.ErrorCode.INVALID_SIGNED_EXCHANGE:1 of
msgid "An error occurred while handling a signed exchange."
msgstr "signed exchange를 처리하는 중 오류가 발생했습니다."

#: cefweaver.types.ErrorCode.INVALID_WEB_BUNDLE:1 of
msgid "An error occurred while handling a Web Bundle source."
msgstr "Web Bundle 소스를 처리하는 중 오류가 발생했습니다."

#: cefweaver.types.ErrorCode.TRUST_TOKEN_OPERATION_FAILED:1 of
msgid ""
"A Trust Tokens protocol operation-executing request failed for one of a number of reasons "
"(precondition failure, internal error, bad response)."
msgstr "Trust Tokens 프로토콜의 작업을 실행하는 요청이 여러 이유(전제 조건 실패, 내부 오류, 잘못된 응답) 중 하나로 실패했습니다."

#: cefweaver.types.ErrorCode.TRUST_TOKEN_OPERATION_SUCCESS_WITHOUT_SENDING_REQUEST:1 of
msgid ""
"When handling a Trust Tokens protocol operation-executing request, the system was able to execute"
" the request's Trust Tokens operation without sending the request to its destination: for "
"instance, the results could have been present in a local cache (for redemption) or the operation "
"could have been diverted to a local provider (for \"platform-provided\" issuance)."
msgstr ""
"Trust Tokens 프로토콜의 작업을 실행하는 요청을 처리할 때, 시스템이 요청을 목적지로 보내지 않고 해당 요청의 Trust Tokens 작업을 실행할 수 있었습니다. "
"예를 들어 결과가 로컬 캐시에 있었거나(redemption의 경우), 작업이 로컬 제공자로 우회되었을 수 있습니다(\"platform-provided\" issuance의 "
"경우)."

#: cefweaver.types.ErrorCode.HTTPENGINE_PROVIDER_IN_USE:1 of
msgid "This is a placeholder value that should never be used within //net."
msgstr "//net 내부에서는 절대 사용해서는 안 되는 자리 표시자 값입니다."

#: cefweaver.types.ErrorCode.HTTPENGINE_PROVIDER_IN_USE:3 of
msgid ""
"When Cronet APIs are being backed by HttpEngine (i.e., HttpEngineProvider is being used), "
"org.chromium.net.NetworkException#getCronetInternalErrorCode is not supported "
"(android.net.http.NetworkException#getCronetInternalErrorCode does not exist). In this scenario, "
"getCronetInternalErrorCode will always return this error. This is a first step towards the "
"deprecation of getCronetInternalErrorCode."
msgstr ""
"Cronet API가 HttpEngine을 기반으로 동작하는 경우(즉 HttpEngineProvider가 사용되는 경우) "
"org.chromium.net.NetworkException#getCronetInternalErrorCode는 지원되지 "
"않습니다(android.net.http.NetworkException#getCronetInternalErrorCode가 존재하지 않음). 이 상황에서 "
"getCronetInternalErrorCode는 항상 이 오류를 반환합니다. 이는 getCronetInternalErrorCode를 더 이상 사용하지 않도록 하는 첫 "
"단계입니다."

#: cefweaver.types.ErrorCode.HTTPENGINE_PROVIDER_IN_USE:9 of
msgid ""
"Temporarily terminate, then restart, ITTT to avoid unsupported nesting. LINT.ThenChange( "
"//tools/metrics/histograms/enums.xml:HTTPResponseAndNetErrorCodes, "
"//tools/metrics/histograms/enums.xml:NetErrorCodes, ) LINT.IfChange(HTTPENGINE_PROVIDER_IN_USE)"
msgstr ""
"지원되지 않는 중첩을 피하기 위해 ITTT를 일시적으로 종료한 뒤 다시 시작합니다. LINT.ThenChange( "
"//tools/metrics/histograms/enums.xml:HTTPResponseAndNetErrorCodes, "
"//tools/metrics/histograms/enums.xml:NetErrorCodes, ) LINT.IfChange(HTTPENGINE_PROVIDER_IN_USE)"

#: cefweaver.types.ErrorCode.PKCS12_IMPORT_BAD_PASSWORD:1 of
msgid "PKCS #12 import failed due to incorrect password."
msgstr "비밀번호가 올바르지 않아 PKCS #12 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.PKCS12_IMPORT_FAILED:1 of
msgid "PKCS #12 import failed due to other error."
msgstr "다른 오류로 PKCS #12 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.IMPORT_CA_CERT_NOT_CA:1 of
msgid "CA import failed - not a CA cert."
msgstr "CA 가져오기에 실패했습니다. CA 인증서가 아닙니다."

#: cefweaver.types.ErrorCode.IMPORT_CERT_ALREADY_EXISTS:1 of
msgid "Import failed - certificate already exists in database."
msgstr "가져오기에 실패했습니다. 인증서가 이미 데이터베이스에 있습니다."

#: cefweaver.types.ErrorCode.IMPORT_CERT_ALREADY_EXISTS:3 of
msgid ""
"Note it's a little weird this is an error but reimporting a PKCS12 is ok (no-op). That's how "
"Mozilla does it, though."
msgstr "이것이 오류인데도 PKCS12를 다시 가져오는 것은 괜찮다는(no-op) 점이 조금 이상하다는 데 유의하십시오. 다만 Mozilla가 그렇게 동작합니다."

#: cefweaver.types.ErrorCode.IMPORT_CA_CERT_FAILED:1 of
msgid "CA import failed due to some other error."
msgstr "다른 오류로 CA 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.IMPORT_SERVER_CERT_FAILED:1 of
msgid "Server certificate import failed due to some internal error."
msgstr "내부 오류로 서버 인증서 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.PKCS12_IMPORT_INVALID_MAC:1 of
msgid "PKCS #12 import failed due to invalid MAC."
msgstr "MAC이 유효하지 않아 PKCS #12 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.PKCS12_IMPORT_INVALID_FILE:1 of
msgid "PKCS #12 import failed due to invalid/corrupt file."
msgstr "파일이 유효하지 않거나 손상되어 PKCS #12 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.PKCS12_IMPORT_UNSUPPORTED:1 of
msgid "PKCS #12 import failed due to unsupported features."
msgstr "지원되지 않는 기능 때문에 PKCS #12 가져오기에 실패했습니다."

#: cefweaver.types.ErrorCode.KEY_GENERATION_FAILED:1 of
msgid "Key generation failed."
msgstr "키 생성에 실패했습니다."

#: cefweaver.types.ErrorCode.PRIVATE_KEY_EXPORT_FAILED:1 of
msgid "Failure to export private key."
msgstr "개인 키 내보내기에 실패했습니다."

#: cefweaver.types.ErrorCode.SELF_SIGNED_CERT_GENERATION_FAILED:1 of
msgid "Self-signed certificate generation failed."
msgstr "자체 서명 인증서 생성에 실패했습니다."

#: cefweaver.types.ErrorCode.CERT_DATABASE_CHANGED:1 of
msgid "The certificate database changed in some way."
msgstr "인증서 데이터베이스가 어떤 식으로든 변경되었습니다."

#: cefweaver.types.ErrorCode.CERT_VERIFIER_CHANGED:1 of
msgid "The certificate verifier configuration changed in some way."
msgstr "인증서 검증기 구성이 어떤 식으로든 변경되었습니다."

#: cefweaver.types.ErrorCode.DNS_MALFORMED_RESPONSE:1 of
msgid "DNS resolver received a malformed response."
msgstr "DNS 리졸버가 형식이 잘못된 응답을 받았습니다."

#: cefweaver.types.ErrorCode.DNS_SERVER_REQUIRES_TCP:1 of
msgid "DNS server requires TCP"
msgstr "DNS 서버에 TCP가 필요합니다"

#: cefweaver.types.ErrorCode.DNS_TIMED_OUT:1 of
msgid "DNS transaction timed out."
msgstr "DNS 트랜잭션이 시간 초과되었습니다."

#: cefweaver.types.ErrorCode.DNS_CACHE_MISS:1 of
msgid ""
"The entry was not found in cache or other local sources, for lookups where only local sources "
"were queried."
msgstr "로컬 소스만 조회한 조회에서, 캐시나 다른 로컬 소스에서 항목을 찾지 못했습니다."

#: cefweaver.types.ErrorCode.DNS_CACHE_MISS:3 of
msgid ""
"TODO(ericorth): Consider renaming to DNS_LOCAL_MISS or something like that as the cache is not "
"necessarily queried either."
msgstr "TODO(ericorth): 캐시도 반드시 조회되는 것은 아니므로 DNS_LOCAL_MISS 같은 이름으로 바꾸는 것을 고려할 것."

#: cefweaver.types.ErrorCode.DNS_SEARCH_EMPTY:1 of
msgid "Suffix search list rules prevent resolution of the given host name."
msgstr "접미사 검색 목록 규칙 때문에 주어진 호스트 이름을 확인할 수 없습니다."

#: cefweaver.types.ErrorCode.DNS_SORT_ERROR:1 of
msgid "Failed to sort addresses according to RFC3484."
msgstr "RFC3484에 따라 주소를 정렬하지 못했습니다."

#: cefweaver.types.ErrorCode.DNS_SECURE_RESOLVER_HOSTNAME_RESOLUTION_FAILED:1 of
msgid "Failed to resolve the hostname of a DNS-over-HTTPS server."
msgstr "DNS-over-HTTPS 서버의 호스트 이름을 확인하지 못했습니다."

#: cefweaver.types.ErrorCode.DNS_NAME_HTTPS_ONLY:1 of
msgid "DNS identified the request as disallowed for insecure connection (http/ws)."
msgstr "DNS가 해당 요청을 안전하지 않은 연결(http/ws)에서 허용되지 않는 요청으로 식별했습니다."

#: cefweaver.types.ErrorCode.DNS_NAME_HTTPS_ONLY:3 of
msgid "Error should be handled as if an HTTP redirect was received to redirect to https or wss."
msgstr "이 오류는 https 또는 wss로 리디렉션하는 HTTP 리디렉션을 받은 것처럼 처리해야 합니다."

#: cefweaver.types.ErrorCode.DNS_REQUEST_CANCELLED:1 of
msgid "All DNS requests associated with this job have been cancelled."
msgstr "이 작업과 연결된 모든 DNS 요청이 취소되었습니다."

#: cefweaver.types.ErrorCode.DNS_NO_MATCHING_SUPPORTED_ALPN:1 of
msgid ""
"The hostname resolution of HTTPS record was expected to be resolved with alpn values of supported"
" protocols, but did not."
msgstr "HTTPS 레코드의 호스트 이름 확인에서 지원되는 프로토콜의 alpn 값과 함께 확인될 것으로 기대했지만 그렇지 않았습니다."

#: cefweaver.types.ErrorCode.DNS_SECURE_PROBE_RECORD_INVALID:1 of
msgid ""
"When checking whether secure DNS can be used, the response returned for the requested probe "
"record either had no answer or was invalid."
msgstr "보안 DNS를 사용할 수 있는지 확인할 때, 요청한 프로브 레코드에 대해 반환된 응답에 답이 없었거나 유효하지 않았습니다."

#: cefweaver.types.ErrorCode.DNS_CACHE_INVALIDATION_IN_PROGRESS:1 of
msgid "Returned when DNS cache invalidation is in progress."
msgstr "DNS 캐시 무효화가 진행 중일 때 반환됩니다."

#: cefweaver.types.ErrorCode.DNS_CACHE_INVALIDATION_IN_PROGRESS:3 of
msgid "This is a transient error. Callers may want to retry later."
msgstr "일시적인 오류입니다. 호출자는 나중에 다시 시도할 수 있습니다."

#: cefweaver.types.ErrorCode.DNS_FORMAT_ERROR:1 of
msgid "The DNS server responded with a format error response code."
msgstr "DNS 서버가 형식 오류 응답 코드로 응답했습니다."

#: cefweaver.types.ErrorCode.DNS_SERVER_FAILURE:1 of
msgid "The DNS server responded with a server failure response code."
msgstr "DNS 서버가 서버 실패 응답 코드로 응답했습니다."

#: cefweaver.types.ErrorCode.DNS_NOT_IMPLEMENTED:1 of
msgid "The DNS server responded that the query type is not implemented."
msgstr "DNS 서버가 쿼리 유형이 구현되지 않았다고 응답했습니다."

#: cefweaver.types.ErrorCode.DNS_REFUSED:1 of
msgid "The DNS server responded that the request was refused."
msgstr "DNS 서버가 요청이 거부되었다고 응답했습니다."

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:1 of
msgid ""
"The DNS server responded with an rcode indicating that the request failed, but the rcode is not "
"one that we have a specific error code for."
msgstr "DNS 서버가 요청이 실패했음을 나타내는 rcode로 응답했지만, 해당 rcode에 대한 구체적인 오류 코드가 없습니다."

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:3 of
msgid "In other words, the rcode was not one of the following:"
msgstr "즉, rcode가 다음 중 하나가 아니었습니다."

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:5 of
msgid "NOERR"
msgstr "NOERR"

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:6 of
msgid "FORMERR"
msgstr "FORMERR"

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:7 of
msgid "SERVFAIL"
msgstr "SERVFAIL"

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:8 of
msgid "NXDOMAIN"
msgstr "NXDOMAIN"

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:9 of
msgid "NOTIMP"
msgstr "NOTIMP"

#: cefweaver.types.ErrorCode.DNS_OTHER_FAILURE:10 of
msgid "REFUSED"
msgstr "REFUSED"

#: cefweaver.types.ErrorCode.DNS_DIRECT_ONLY:1 of
msgid ""
"Declined to call DNS for a direct_only request of a hostname whose traffic would be routed "
"through a proxy."
msgstr "트래픽이 proxy를 거치게 될 호스트 이름에 대한 direct_only 요청에서 DNS 호출을 거부했습니다."

#: cefweaver.types.ErrorCode.BLOB_INVALID_CONSTRUCTION_ARGUMENTS:1 of
msgid "The construction arguments are invalid."
msgstr "생성 인자가 유효하지 않습니다."

#: cefweaver.types.ErrorCode.BLOB_INVALID_CONSTRUCTION_ARGUMENTS:3 of
msgid "This is considered a bad IPC."
msgstr "잘못된 IPC로 간주됩니다."

#: cefweaver.types.ErrorCode.BLOB_OUT_OF_MEMORY:1 of
msgid "We don't have enough memory for the blob."
msgstr "blob을 위한 메모리가 충분하지 않습니다."

#: cefweaver.types.ErrorCode.BLOB_FILE_WRITE_FAILED:1 of
msgid "We couldn't create or write to a file."
msgstr "파일을 만들거나 쓸 수 없었습니다."

#: cefweaver.types.ErrorCode.BLOB_FILE_WRITE_FAILED:3 of
msgid "File system error, like a full disk."
msgstr "디스크가 가득 찬 것과 같은 파일 시스템 오류입니다."

#: cefweaver.types.ErrorCode.BLOB_SOURCE_DIED_IN_TRANSIT:1 of
msgid "The renderer was destroyed while data was in transit."
msgstr "데이터가 전송 중인 동안 renderer가 소멸되었습니다."

#: cefweaver.types.ErrorCode.BLOB_DEREFERENCED_WHILE_BUILDING:1 of
msgid ""
"The renderer destructed the blob before it was done transferring, and there were no outstanding "
"references (no one is waiting to read) to keep the blob alive."
msgstr "전송이 끝나기 전에 renderer가 blob을 소멸시켰고, blob을 유지할 미해결 참조(읽기를 기다리는 대상)가 없었습니다."

#: cefweaver.types.ErrorCode.BLOB_REFERENCED_BLOB_BROKEN:1 of
msgid ""
"A blob that we referenced during construction is broken, or a browser-side builder tries to build"
" a blob with a blob reference that isn't finished constructing."
msgstr "생성 중에 참조한 blob이 손상되었거나, 브라우저 측 빌더가 아직 생성이 끝나지 않은 blob 참조로 blob을 만들려고 합니다."

#: cefweaver.types.ErrorCode.BLOB_REFERENCED_FILE_UNAVAILABLE:1 of
msgid ""
"A file that we referenced during construction is not accessible to the renderer trying to create "
"the blob."
msgstr "생성 중에 참조한 파일에 blob을 만들려는 renderer가 접근할 수 없습니다."

#: cefweaver.types.enums.EventFlags:1 of
msgid "Supported event bit flags."
msgstr "지원되는 이벤트 비트 플래그."

#: cefweaver.types.EventFlags.COMMAND_DOWN:1 of
msgid "Mac OS-X command key."
msgstr "Mac OS-X의 command 키."

#: cefweaver.types.enums.FileDialogMode:1 of
msgid "Supported file dialog modes."
msgstr "지원되는 파일 대화상자 모드."

#: cefweaver.types.FileDialogMode.OPEN:1 of
msgid "Requires that the file exists before allowing the user to pick it."
msgstr "사용자가 파일을 선택하기 전에 파일이 존재해야 합니다."

#: cefweaver.types.FileDialogMode.OPEN_MULTIPLE:1 of
msgid "Like Open, but allows picking multiple files to open."
msgstr "Open과 비슷하지만 열 파일을 여러 개 선택할 수 있습니다."

#: cefweaver.types.FileDialogMode.OPEN_FOLDER:1 of
msgid "Like Open, but selects a folder to open."
msgstr "Open과 비슷하지만 열 폴더를 선택합니다."

#: cefweaver.types.FileDialogMode.SAVE:1 of
msgid "Allows picking a nonexistent file, and prompts to overwrite if the file already exists."
msgstr "존재하지 않는 파일을 선택할 수 있으며, 파일이 이미 있으면 덮어쓸지 묻습니다."

#: cefweaver.types.enums.FocusSource:1 of
msgid "Focus sources."
msgstr "포커스 소스."

#: cefweaver.types.FocusSource.NAVIGATION:1 of
msgid "The source is explicit navigation via the API (LoadURL(), etc)."
msgstr "소스는 API를 통한 명시적 이동입니다(LoadURL() 등)."

#: cefweaver.types.FocusSource.SYSTEM:1 of
msgid "The source is a system-generated focus event."
msgstr "소스는 시스템이 생성한 포커스 이벤트입니다."

#: cefweaver.types.enums.GestureCommand:1 of
msgid "Specifies the gesture commands."
msgstr "제스처 명령을 지정합니다."

#: cefweaver.types.enums.HorizontalAlignment:1 of
msgid "Specifies the horizontal text alignment mode."
msgstr "가로 텍스트 정렬 모드를 지정합니다."

#: cefweaver.types.HorizontalAlignment.LEFT:1 of
msgid "Align the text's left edge with that of its display area."
msgstr "텍스트의 왼쪽 가장자리를 표시 영역의 왼쪽 가장자리에 맞춥니다."

#: cefweaver.types.HorizontalAlignment.CENTER:1 of
msgid "Align the text's center with that of its display area."
msgstr "텍스트의 가운데를 표시 영역의 가운데에 맞춥니다."

#: cefweaver.types.HorizontalAlignment.RIGHT:1 of
msgid "Align the text's right edge with that of its display area."
msgstr "텍스트의 오른쪽 가장자리를 표시 영역의 오른쪽 가장자리에 맞춥니다."

#: cefweaver.types.enums.JSDialogType:1 of
msgid "Supported JavaScript dialog types."
msgstr "지원되는 JavaScript 대화상자 유형."

#: cefweaver.types.enums.JsonParserOptions:1 of
msgid "Options that can be passed to ``CefParseJSON``."
msgstr "``CefParseJSON``\\ 에 전달할 수 있는 옵션."

#: cefweaver.types.JsonParserOptions.RFC:1 of
msgid "Parse the input strictly according to RFC 4627."
msgstr "입력을 RFC 4627에 따라 엄격하게 파싱합니다."

#: cefweaver.types.JsonParserOptions.RFC:3 of
msgid ""
"See comments in Chromium's base/json/json_reader.h file for known limitations/ deviations from "
"the RFC."
msgstr "알려진 제한 사항과 RFC와의 차이는 Chromium의 base/json/json_reader.h 파일의 주석을 참고하십시오."

#: cefweaver.types.JsonParserOptions.ALLOW_TRAILING_COMMAS:1 of
msgid "Allows commas to exist after the last element in structures."
msgstr "구조의 마지막 요소 뒤에 쉼표를 허용합니다."

#: cefweaver.types.enums.JsonWriterOptions:1 of
msgid "Options that can be passed to ``CefWriteJSON``."
msgstr "``CefWriteJSON``\\ 에 전달할 수 있는 옵션."

#: cefweaver.types.JsonWriterOptions.DEFAULT:1 cefweaver.types.UrlrequestFlags.NONE:1 of
msgid "Default behavior."
msgstr "기본 동작."

#: cefweaver.types.JsonWriterOptions.OMIT_BINARY_VALUES:1 of
msgid ""
"This option instructs the writer that if a Binary value is encountered, the value (and key if "
"within a dictionary) will be omitted from the output, and success will be returned."
msgstr "이 옵션은 Binary 값을 만나면 해당 값(딕셔너리 안에 있으면 키도 함께)을 출력에서 생략하고 성공을 반환하도록 writer에 지시합니다."

#: cefweaver.types.JsonWriterOptions.OMIT_BINARY_VALUES:3 of
msgid "Otherwise, if a binary value is encountered, failure will be returned."
msgstr "이 옵션이 없으면 binary 값을 만났을 때 실패를 반환합니다."

#: cefweaver.types.JsonWriterOptions.OMIT_DOUBLE_TYPE_PRESERVATION:1 of
msgid ""
"This option instructs the writer to write doubles that have no fractional part as a normal "
"integer (i.e., without using exponential notation or appending a '.0') as long as the value is "
"within the range of a 64-bit int."
msgstr ""
"이 옵션은 소수 부분이 없는 double을 값이 64비트 int의 범위 안에 있는 한 일반 정수로(즉 지수 표기법을 쓰거나 '.0'을 덧붙이지 않고) 쓰도록 writer에 "
"지시합니다."

#: cefweaver.types.JsonWriterOptions.PRETTY_PRINT:1 of
msgid "Return a slightly nicer formatted json string (pads with whitespace to help with readability)."
msgstr "조금 더 보기 좋게 서식을 적용한 json 문자열을 반환합니다(가독성을 돕기 위해 공백으로 채움)."

#: cefweaver.types.enums.KeyEventType:1 of
msgid "Key event types."
msgstr "키 이벤트 유형."

#: cefweaver.types.KeyEventType.RAWKEYDOWN:1 of
msgid "Notification that a key transitioned from \"up\" to \"down\"."
msgstr "키가 \"up\"에서 \"down\"으로 전환되었다는 알림입니다."

#: cefweaver.types.KeyEventType.KEYDOWN:1 of
msgid "Notification that a key was pressed."
msgstr "키가 눌렸다는 알림입니다."

#: cefweaver.types.KeyEventType.KEYDOWN:3 of
msgid ""
"This does not necessarily correspond to a character depending on the key and language. Use "
"KEYEVENT_CHAR for character input."
msgstr "키와 언어에 따라 문자에 대응하지 않을 수도 있습니다. 문자 입력에는 KEYEVENT_CHAR를 사용하십시오."

#: cefweaver.types.KeyEventType.KEYUP:1 of
msgid "Notification that a key was released."
msgstr "키가 놓였다는 알림입니다."

#: cefweaver.types.KeyEventType.CHAR:1 of
msgid "Notification that a character was typed."
msgstr "문자가 입력되었다는 알림입니다."

#: cefweaver.types.KeyEventType.CHAR:3 of
msgid ""
"Use this for text input. Key down events may generate 0, 1, or more than one character event "
"depending on the key, locale, and operating system."
msgstr "텍스트 입력에 사용하십시오. 키 누름 이벤트는 키, 로캘, 운영 체제에 따라 문자 이벤트를 0개, 1개 또는 여러 개 생성할 수 있습니다."

#: cefweaver.types.enums.LogItems:1 of
msgid "Log items prepended to each log line."
msgstr "각 로그 줄의 앞에 붙는 항목."

#: cefweaver.types.LogItems.DEFAULT:1 of
msgid "Prepend the default list of items."
msgstr "기본 항목 목록을 앞에 붙입니다."

#: cefweaver.types.LogItems.NONE:1 of
msgid "Prepend no items."
msgstr "아무 항목도 앞에 붙이지 않습니다."

#: cefweaver.types.LogItems.FLAG_PROCESS_ID:1 of
msgid "Prepend the process ID."
msgstr "프로세스 ID를 앞에 붙입니다."

#: cefweaver.types.LogItems.FLAG_THREAD_ID:1 of
msgid "Prepend the thread ID."
msgstr "스레드 ID를 앞에 붙입니다."

#: cefweaver.types.LogItems.FLAG_TIME_STAMP:1 of
msgid "Prepend the timestamp."
msgstr "타임스탬프를 앞에 붙입니다."

#: cefweaver.types.LogItems.FLAG_TICK_COUNT:1 of
msgid "Prepend the tickcount."
msgstr "tickcount를 앞에 붙입니다."

#: cefweaver.types.enums.LogSeverity:1 of
msgid "Log severity levels."
msgstr "로그 심각도 수준."

#: cefweaver.types.LogSeverity.DEFAULT:1 of
msgid "Default logging (currently INFO logging)."
msgstr "기본 로깅(현재는 INFO 로깅)."

#: cefweaver.types.LogSeverity.VERBOSE:1 of
msgid "Verbose logging."
msgstr "상세 로깅."

#: cefweaver.types.LogSeverity.DEBUG:1 of
msgid "DEBUG logging."
msgstr "DEBUG 로깅."

#: cefweaver.types.LogSeverity.INFO:1 of
msgid "INFO logging."
msgstr "INFO 로깅."

#: cefweaver.types.LogSeverity.WARNING:1 of
msgid "WARNING logging."
msgstr "WARNING 로깅."

#: cefweaver.types.LogSeverity.ERROR:1 of
msgid "ERROR logging."
msgstr "ERROR 로깅."

#: cefweaver.types.LogSeverity.FATAL:1 of
msgid "FATAL logging."
msgstr "FATAL 로깅."

#: cefweaver.types.LogSeverity.DISABLE:1 of
msgid ""
"Disable logging to file for all messages, and to stderr for messages with severity less than "
"FATAL."
msgstr "모든 메시지의 파일 로깅과, 심각도가 FATAL보다 낮은 메시지의 stderr 로깅을 끕니다."

#: cefweaver.types.enums.MediaAccessPermissionTypes:1 of
msgid "Media access permissions used by OnRequestMediaAccessPermission."
msgstr "OnRequestMediaAccessPermission에서 사용하는 미디어 접근 권한."

#: cefweaver.types.MediaAccessPermissionTypes.NONE:1 of
msgid "No permission."
msgstr "권한 없음."

#: cefweaver.types.MediaAccessPermissionTypes.DEVICE_AUDIO_CAPTURE:1 of
msgid "Device audio capture permission."
msgstr "장치 오디오 캡처 권한."

#: cefweaver.types.MediaAccessPermissionTypes.DEVICE_VIDEO_CAPTURE:1 of
msgid "Device video capture permission."
msgstr "장치 비디오 캡처 권한."

#: cefweaver.types.MediaAccessPermissionTypes.DESKTOP_AUDIO_CAPTURE:1 of
msgid "Desktop audio capture permission."
msgstr "데스크톱 오디오 캡처 권한."

#: cefweaver.types.MediaAccessPermissionTypes.DESKTOP_VIDEO_CAPTURE:1 of
msgid "Desktop video capture permission."
msgstr "데스크톱 비디오 캡처 권한."

#: cefweaver.types.enums.MediaRouteConnectionState:1 of
msgid "Connection state for a MediaRoute object."
msgstr "MediaRoute 객체의 연결 상태."

#: cefweaver.types.enums.MediaRouteConnectionState:3 of
msgid "Should be kept in sync with Chromium's blink::mojom::PresentationConnectionState type."
msgstr "Chromium의 blink::mojom::PresentationConnectionState 유형과 동기화된 상태로 유지되어야 합니다."

#: cefweaver.types.enums.MediaRouteCreateResult:1 of
msgid "Result codes for :meth:`~cefweaver.MediaRouter.create_route`."
msgstr ":meth:`~cefweaver.MediaRouter.create_route`\\ 의 결과 코드."

#: cefweaver.types.enums.MediaRouteCreateResult:3 of
msgid "Should be kept in sync with Chromium's media_router::mojom::RouteRequestResultCode type."
msgstr "Chromium의 media_router::mojom::RouteRequestResultCode 유형과 동기화된 상태로 유지되어야 합니다."

#: cefweaver.types.enums.MediaSinkIconType:1 of
msgid "Icon types for a MediaSink object."
msgstr "MediaSink 객체의 아이콘 유형."

#: cefweaver.types.enums.MediaSinkIconType:3 of
msgid "Should be kept in sync with Chromium's media_router::SinkIconType type."
msgstr "Chromium의 media_router::SinkIconType 유형과 동기화된 상태로 유지되어야 합니다."

#: cefweaver.types.enums.MenuAnchorPosition:1 of
msgid "Specifies how a menu will be anchored for non-RTL languages."
msgstr "RTL이 아닌 언어에서 메뉴를 어떻게 고정할지 지정합니다."

#: cefweaver.types.enums.MenuAnchorPosition:3 of
msgid "The opposite position will be used for RTL languages."
msgstr "RTL 언어에서는 반대쪽 위치가 사용됩니다."

#: cefweaver.types.enums.MenuColorType:1 of
msgid "Supported color types for menu items."
msgstr "지원되는 메뉴 항목 색상 유형."

#: cefweaver.types.enums.MenuId:1 of
msgid "Supported menu IDs."
msgstr "지원되는 메뉴 ID."

#: cefweaver.types.enums.MenuId:3 of
msgid ""
"Non-English translations can be provided for the ``IDS_MENU_*`` strings in "
"``CefResourceBundleHandler::GetLocalizedString()``."
msgstr ""
"``CefResourceBundleHandler::GetLocalizedString()``\\ 에서 ``IDS_MENU_*`` 문자열에 대해 영어가 아닌 번역을 제공할 수 "
"있습니다."

#: cefweaver.types.MenuId.BACK:1 of
msgid "Navigation."
msgstr "이동."

#: cefweaver.types.MenuId.UNDO:1 of
msgid "Editing."
msgstr "편집."

#: cefweaver.types.MenuId.FIND:1 of
msgid "Miscellaneous."
msgstr "기타."

#: cefweaver.types.MenuId.SPELLCHECK_SUGGESTION_0:1 of
msgid "Spell checking word correction suggestions."
msgstr "맞춤법 검사 단어 수정 제안."

#: cefweaver.types.MenuId.CUSTOM_FIRST:1 of
msgid "Custom menu items originating from the renderer process."
msgstr "renderer 프로세스에서 발생한 사용자 지정 메뉴 항목."

#: cefweaver.types.MenuId.USER_FIRST:1 of
msgid ""
"All user-defined menu IDs should come between MENU_ID_USER_FIRST and MENU_ID_USER_LAST to avoid "
"overlapping the Chromium and CEF ID ranges defined in the tools/gritsettings/resource_ids file."
msgstr ""
"사용자가 정의하는 모든 메뉴 ID는 tools/gritsettings/resource_ids 파일에 정의된 Chromium과 CEF의 ID 범위와 겹치지 않도록 "
"MENU_ID_USER_FIRST와 MENU_ID_USER_LAST 사이에 있어야 합니다."

#: cefweaver.types.enums.MenuItemType:1 of
msgid "Supported menu item types."
msgstr "지원되는 메뉴 항목 유형."

#: cefweaver.types.enums.MessageLoopType:1 of
msgid "Message loop types."
msgstr "메시지 루프 유형."

#: cefweaver.types.enums.MessageLoopType:3 of
msgid "Indicates the set of asynchronous events that a message loop can process."
msgstr "메시지 루프가 처리할 수 있는 비동기 이벤트의 집합을 나타냅니다."

#: cefweaver.types.MessageLoopType.TYPE_DEFAULT:1 of
msgid "Supports tasks and timers."
msgstr "작업과 타이머를 지원합니다."

#: cefweaver.types.MessageLoopType.TYPE_UI:1 of
msgid "Supports tasks, timers and native UI events (e.g."
msgstr "작업, 타이머, 네이티브 UI 이벤트(예:"

#: cefweaver.types.MessageLoopType.TYPE_UI:3 of
msgid "Windows messages)."
msgstr "Windows 메시지)를 지원합니다."

#: cefweaver.types.MessageLoopType.TYPE_IO:1 of
msgid "Supports tasks, timers and asynchronous IO events."
msgstr "작업, 타이머, 비동기 IO 이벤트를 지원합니다."

#: cefweaver.types.enums.MouseButtonType:1 of
msgid "Mouse button types."
msgstr "마우스 단추 유형."

#: cefweaver.types.enums.NavigationType:1 of
msgid "Navigation types."
msgstr "이동 유형."

#: cefweaver.types.enums.PaintElementType:1 of
msgid "Paint element types."
msgstr "페인트 요소 유형."

#: cefweaver.types.enums.PathKey:1 of
msgid "Path key values."
msgstr "경로 키 값."

#: cefweaver.types.PathKey.DIR_CURRENT:1 of
msgid "Current directory."
msgstr "현재 디렉터리."

#: cefweaver.types.PathKey.DIR_EXE:1 of
msgid "Directory containing PK_FILE_EXE."
msgstr "PK_FILE_EXE가 들어 있는 디렉터리."

#: cefweaver.types.PathKey.DIR_MODULE:1 of
msgid "Directory containing PK_FILE_MODULE."
msgstr "PK_FILE_MODULE이 들어 있는 디렉터리."

#: cefweaver.types.PathKey.DIR_TEMP:1 of
msgid "Temporary directory."
msgstr "임시 디렉터리."

#: cefweaver.types.PathKey.FILE_EXE:1 of
msgid "Path and filename of the current executable."
msgstr "현재 실행 파일의 경로와 파일 이름."

#: cefweaver.types.PathKey.FILE_MODULE:1 of
msgid "Path and filename of the module containing the CEF code (usually the libcef module)."
msgstr "CEF 코드가 들어 있는 모듈(보통 libcef 모듈)의 경로와 파일 이름."

#: cefweaver.types.PathKey.LOCAL_APP_DATA:1 of
msgid "\"Local Settings\\Application Data\" directory under the user profile directory on Windows."
msgstr "Windows에서 사용자 프로필 디렉터리 아래의 \"Local Settings\\Application Data\" 디렉터리."

#: cefweaver.types.PathKey.USER_DATA:1 of
msgid ""
"\"Application Data\" directory under the user profile directory on Windows and "
"\"~/Library/Application Support\" directory on MacOS."
msgstr ""
"Windows에서는 사용자 프로필 디렉터리 아래의 \"Application Data\" 디렉터리, MacOS에서는 \"~/Library/Application Support\""
" 디렉터리."

#: cefweaver.types.PathKey.DIR_RESOURCES:1 of
msgid "Directory containing application resources."
msgstr "애플리케이션 리소스가 들어 있는 디렉터리."

#: cefweaver.types.PathKey.DIR_RESOURCES:3 of
msgid "Can be configured via ``CefSettings``.resources_dir_path."
msgstr "``CefSettings``.resources_dir_path로 구성할 수 있습니다."

#: cefweaver.types.enums.PdfPrintMarginType:1 of
msgid "Margin type for PDF printing."
msgstr "PDF 인쇄의 여백 유형."

#: cefweaver.types.PdfPrintMarginType.DEFAULT:1 of
msgid "Default margins of 1cm (~0.4 inches)."
msgstr "1cm(약 0.4인치)의 기본 여백."

#: cefweaver.types.PdfPrintMarginType.NONE:1 of
msgid "No margins."
msgstr "여백 없음."

#: cefweaver.types.PdfPrintMarginType.CUSTOM:1 of
msgid "Custom margins using the ``margin_*`` values from cef_pdf_print_settings_t."
msgstr "cef_pdf_print_settings_t의 ``margin_*`` 값을 사용하는 사용자 지정 여백."

#: cefweaver.types.enums.PermissionRequestResult:1 of
msgid "Permission request results."
msgstr "권한 요청 결과."

#: cefweaver.types.PermissionRequestResult.ACCEPT:1 of
msgid "Accept the permission request as an explicit user action."
msgstr "권한 요청을 명시적인 사용자 동작으로 수락합니다."

#: cefweaver.types.PermissionRequestResult.DENY:1 of
msgid "Deny the permission request as an explicit user action."
msgstr "권한 요청을 명시적인 사용자 동작으로 거부합니다."

#: cefweaver.types.PermissionRequestResult.DISMISS:1 of
msgid "Dismiss the permission request as an explicit user action."
msgstr "권한 요청을 명시적인 사용자 동작으로 닫습니다."

#: cefweaver.types.PermissionRequestResult.IGNORE:1 of
msgid "Ignore the permission request."
msgstr "권한 요청을 무시합니다."

#: cefweaver.types.PermissionRequestResult.IGNORE:3 of
msgid ""
"If the prompt remains unhandled (e.g. OnShowPermissionPrompt returns ``False`` and there is no "
"default permissions UI) then any related promises may remain unresolved."
msgstr ""
"프롬프트가 처리되지 않은 채로 남으면(예: OnShowPermissionPrompt가 ``False``\\ 를 반환하고 기본 권한 UI가 없는 경우) 관련된 promise가 "
"해결되지 않은 채로 남을 수 있습니다."

#: cefweaver.types.enums.PermissionRequestTypes:1 of
msgid "Permission types used with OnShowPermissionPrompt."
msgstr "OnShowPermissionPrompt와 함께 사용하는 권한 유형."

#: cefweaver.types.enums.PermissionRequestTypes:3 of
msgid ""
"Some types are platform-specific or only supported with Chrome style. Should be kept in sync with"
" Chromium's permissions::RequestType type."
msgstr ""
"일부 유형은 플랫폼에 따라 다르거나 Chrome 스타일에서만 지원됩니다. Chromium의 permissions::RequestType 유형과 동기화된 상태로 유지되어야 "
"합니다."

#: cefweaver.types.TouchEvent.pointer_type:1 cefweaver.types.enums.PointerType:1 of
msgid "The device type that caused the event."
msgstr "이벤트를 일으킨 장치 유형."

#: cefweaver.types.enums.PostdataelementType:1 of
msgid "Post data elements may represent either bytes or files."
msgstr "Post 데이터 요소는 바이트 또는 파일을 나타낼 수 있습니다."

#: cefweaver.types.enums.PreferencesType:1 of
msgid "Preferences type passed to ``CefBrowserProcessHandler::OnRegisterCustomPreferences``."
msgstr "``CefBrowserProcessHandler::OnRegisterCustomPreferences``\\ 에 전달되는 환경 설정 유형."

#: cefweaver.types.PreferencesType.GLOBAL:1 of
msgid "Global preferences registered a single time at application startup."
msgstr "애플리케이션 시작 시 한 번만 등록되는 전역 환경 설정."

#: cefweaver.types.PreferencesType.REQUEST_CONTEXT:1 of
msgid ""
"Request context preferences registered each time a new :class:`~cefweaver.RequestContext` is "
"created."
msgstr "새 :class:`~cefweaver.RequestContext`\\ 이 생성될 때마다 등록되는 요청 컨텍스트 환경설정."

#: cefweaver.types.enums.ProcessId:1 of
msgid "Existing process IDs."
msgstr "존재하는 프로세스 ID."

#: cefweaver.types.ProcessId.BROWSER:1 of
msgid "Browser process."
msgstr "브라우저 프로세스."

#: cefweaver.types.ProcessId.RENDERER:1 of
msgid "Renderer process."
msgstr "Renderer 프로세스."

#: cefweaver.types.enums.QuickMenuEditStateFlags:1 of
msgid "Supported quick menu state bit flags."
msgstr "지원되는 빠른 메뉴 상태 비트 플래그."

#: cefweaver.types.enums.ReferrerPolicy:1 of
msgid "Policy for how the Referrer HTTP header value will be sent during navigation."
msgstr "탐색 중에 Referrer HTTP 헤더 값을 어떻게 보낼지에 대한 정책."

#: cefweaver.types.enums.ReferrerPolicy:3 of
msgid ""
"If the ``--no-referrers`` command-line flag is specified then the policy value will be ignored "
"and the Referrer value will never be sent. Must be kept synchronized with "
"net::URLRequest::ReferrerPolicy from Chromium."
msgstr ""
"``--no-referrers`` 명령줄 플래그가 지정되면 정책 값은 무시되고 Referrer 값은 절대 전송되지 않습니다. Chromium의 "
"net::URLRequest::ReferrerPolicy와 동기화된 상태를 유지해야 합니다."

#: cefweaver.types.ReferrerPolicy.CLEAR_REFERRER_ON_TRANSITION_FROM_SECURE_TO_INSECURE:1 of
msgid "Clear the referrer header if the header value is HTTPS but the request destination is HTTP."
msgstr "Referrer 헤더 값이 HTTPS이지만 요청 대상이 HTTP이면 referrer 헤더를 지웁니다."

#: cefweaver.types.ReferrerPolicy.CLEAR_REFERRER_ON_TRANSITION_FROM_SECURE_TO_INSECURE:3 of
msgid "This is the default behavior."
msgstr "이것이 기본 동작입니다."

#: cefweaver.types.ReferrerPolicy.REDUCE_REFERRER_GRANULARITY_ON_TRANSITION_CROSS_ORIGIN:1 of
msgid ""
"A slight variant on CLEAR_REFERRER_ON_TRANSITION_FROM_SECURE_TO_INSECURE: If the request "
"destination is HTTP, an HTTPS referrer will be cleared."
msgstr ""
"CLEAR_REFERRER_ON_TRANSITION_FROM_SECURE_TO_INSECURE의 약간 다른 변형입니다. 요청 대상이 HTTP이면 HTTPS referrer가 "
"지워집니다."

#: cefweaver.types.ReferrerPolicy.REDUCE_REFERRER_GRANULARITY_ON_TRANSITION_CROSS_ORIGIN:3 of
msgid ""
"If the request's destination is cross-origin with the referrer (but does not downgrade), the "
"referrer's granularity will be stripped down to an origin rather than a full URL. Same-origin "
"requests will send the full referrer."
msgstr ""
"요청의 대상이 referrer와 cross-origin이면(그러나 다운그레이드는 아님) referrer의 세분성이 전체 URL이 아닌 origin까지로 줄어듭니다. Same-"
"origin 요청은 전체 referrer를 보냅니다."

#: cefweaver.types.ReferrerPolicy.ORIGIN_ONLY_ON_TRANSITION_CROSS_ORIGIN:1 of
msgid ""
"Strip the referrer down to an origin when the origin of the referrer is different from the "
"destination's origin."
msgstr "Referrer의 origin이 대상의 origin과 다를 때 referrer를 origin까지로 줄입니다."

#: cefweaver.types.ReferrerPolicy.NEVER_CLEAR_REFERRER:1 of
msgid "Never change the referrer."
msgstr "Referrer를 절대 변경하지 않습니다."

#: cefweaver.types.ReferrerPolicy.ORIGIN:1 of
msgid "Strip the referrer down to the origin regardless of the redirect location."
msgstr "리디렉션 위치와 관계없이 referrer를 origin까지로 줄입니다."

#: cefweaver.types.ReferrerPolicy.CLEAR_REFERRER_ON_TRANSITION_CROSS_ORIGIN:1 of
msgid "Clear the referrer when the request's referrer is cross-origin with the request's destination."
msgstr "요청의 referrer가 요청의 대상과 cross-origin일 때 referrer를 지웁니다."

#: cefweaver.types.ReferrerPolicy.ORIGIN_CLEAR_ON_TRANSITION_FROM_SECURE_TO_INSECURE:1 of
msgid ""
"Strip the referrer down to the origin, but clear it entirely if the referrer value is HTTPS and "
"the destination is HTTP."
msgstr "Referrer를 origin까지로 줄이되, referrer 값이 HTTPS이고 대상이 HTTP이면 완전히 지웁니다."

#: cefweaver.types.ReferrerPolicy.NO_REFERRER:1 of
msgid "Always clear the referrer regardless of the request destination."
msgstr "요청 대상과 관계없이 항상 referrer를 지웁니다."

#: cefweaver.types.ReferrerPolicy.NUM_VALUES:1 of
msgid "Always the last value in this enumeration."
msgstr "항상 이 열거형의 마지막 값입니다."

#: cefweaver.types.enums.ResourceType:1 of
msgid "Resource type for a request."
msgstr "요청의 리소스 타입."

#: cefweaver.types.enums.ResourceType:3 of
msgid "These constants match their equivalents in Chromium's ResourceType and should not be renumbered."
msgstr "이 상수들은 Chromium의 ResourceType에 있는 대응 상수와 일치하며 번호를 다시 매기면 안 됩니다."

#: cefweaver.types.ResourceType.MAIN_FRAME:1 of
msgid "Top level page."
msgstr "최상위 페이지."

#: cefweaver.types.ResourceType.SUB_FRAME:1 of
msgid "Frame or iframe."
msgstr "Frame 또는 iframe."

#: cefweaver.types.ResourceType.STYLESHEET:1 of
msgid "CSS stylesheet."
msgstr "CSS 스타일시트."

#: cefweaver.types.ResourceType.SCRIPT:1 of
msgid "External script."
msgstr "외부 스크립트."

#: cefweaver.types.ResourceType.IMAGE:1 of
msgid "Image (jpg/gif/png/etc)."
msgstr "이미지(jpg/gif/png 등)."

#: cefweaver.types.ResourceType.FONT_RESOURCE:1 of
msgid "Font."
msgstr "글꼴."

#: cefweaver.types.ResourceType.SUB_RESOURCE:1 of
msgid "Some other subresource."
msgstr "기타 하위 리소스."

#: cefweaver.types.ResourceType.SUB_RESOURCE:3 of
msgid "This is the default type if the actual type is unknown."
msgstr "실제 타입을 알 수 없을 때의 기본 타입입니다."

#: cefweaver.types.ResourceType.OBJECT:1 of
msgid "Object (or embed) tag for a plugin, or a resource that a plugin requested."
msgstr "플러그인용 object(또는 embed) 태그, 또는 플러그인이 요청한 리소스."

#: cefweaver.types.ResourceType.MEDIA:1 of
msgid "Media resource."
msgstr "미디어 리소스."

#: cefweaver.types.ResourceType.WORKER:1 of
msgid "Main resource of a dedicated worker."
msgstr "전용 worker의 메인 리소스."

#: cefweaver.types.ResourceType.SHARED_WORKER:1 of
msgid "Main resource of a shared worker."
msgstr "공유 worker의 메인 리소스."

#: cefweaver.types.ResourceType.PREFETCH:1 of
msgid "Explicitly requested prefetch."
msgstr "명시적으로 요청된 prefetch."

#: cefweaver.types.ResourceType.FAVICON:1 of
msgid "Favicon."
msgstr "Favicon."

#: cefweaver.types.ResourceType.XHR:1 of
msgid "XMLHttpRequest."
msgstr "XMLHttpRequest."

#: cefweaver.types.ResourceType.PING:1 of
msgid "A request for a \"<ping>\"."
msgstr "\"<ping>\"에 대한 요청."

#: cefweaver.types.ResourceType.SERVICE_WORKER:1 of
msgid "Main resource of a service worker."
msgstr "Service worker의 메인 리소스."

#: cefweaver.types.ResourceType.CSP_REPORT:1 of
msgid "A report of Content Security Policy violations."
msgstr "Content Security Policy 위반 보고서."

#: cefweaver.types.ResourceType.PLUGIN_RESOURCE:1 of
msgid "A resource that a plugin requested."
msgstr "플러그인이 요청한 리소스."

#: cefweaver.types.ResourceType.NAVIGATION_PRELOAD_MAIN_FRAME:1 of
msgid "A main-frame service worker navigation preload request."
msgstr "메인 frame service worker 탐색 preload 요청."

#: cefweaver.types.ResourceType.NAVIGATION_PRELOAD_SUB_FRAME:1 of
msgid "A sub-frame service worker navigation preload request."
msgstr "하위 frame service worker 탐색 preload 요청."

#: cefweaver.types.enums.ResponseFilterStatus:1 of
msgid "Return values for :meth:`~cefweaver.ResponseFilter.filter`."
msgstr ":meth:`~cefweaver.ResponseFilter.filter`\\ 의 반환값."

#: cefweaver.types.ResponseFilterStatus.NEED_MORE_DATA:1 of
msgid ""
"Some or all of the pre-filter data was read successfully but more data is needed in order to "
"continue filtering (filtered output is pending)."
msgstr "필터링 이전 데이터의 일부 또는 전부를 성공적으로 읽었지만 필터링을 계속하려면 더 많은 데이터가 필요합니다(필터링된 출력이 보류 중입니다)."

#: cefweaver.types.ResponseFilterStatus.DONE:1 of
msgid ""
"Some or all of the pre-filter data was read successfully and all available filtered output has "
"been written."
msgstr "필터링 이전 데이터의 일부 또는 전부를 성공적으로 읽었고 사용 가능한 필터링된 출력을 모두 기록했습니다."

#: cefweaver.types.ResponseFilterStatus.ERROR:1 of
msgid "An error occurred during filtering."
msgstr "필터링 중에 오류가 발생했습니다."

#: cefweaver.types.enums.Resultcode:1 of
msgid "Process result codes."
msgstr "프로세스 결과 코드."

#: cefweaver.types.enums.Resultcode:3 of
msgid ""
"This is not a comprehensive list, as result codes might also include platform-specific crash "
"values (Posix signal or Windows hardware exception), or internal-only implementation values."
msgstr "결과 코드에는 플랫폼별 크래시 값(Posix 시그널 또는 Windows 하드웨어 예외)이나 내부 전용 구현 값도 포함될 수 있으므로 이것이 전체 목록은 아닙니다."

#: cefweaver.types.Resultcode.KILLED:1 of
msgid "Process was killed by user or system."
msgstr "사용자 또는 시스템이 프로세스를 종료했습니다."

#: cefweaver.types.Resultcode.HUNG:1 of
msgid "Process hung."
msgstr "프로세스가 멈췄습니다."

#: cefweaver.types.Resultcode.KILLED_BAD_MESSAGE:1 of
msgid "A bad message caused the process termination."
msgstr "잘못된 메시지로 인해 프로세스가 종료되었습니다."

#: cefweaver.types.Resultcode.GPU_DEAD_ON_ARRIVAL:1 of
msgid "The GPU process exited because initialization failed."
msgstr "초기화가 실패하여 GPU 프로세스가 종료되었습니다."

#: cefweaver.types.Resultcode.BAD_PROCESS_TYPE:1 of
msgid "The process is of an unknown type."
msgstr "알 수 없는 타입의 프로세스입니다."

#: cefweaver.types.Resultcode.MISSING_DATA:1 of
msgid "A critical chrome file is missing."
msgstr "필수 chrome 파일이 없습니다."

#: cefweaver.types.Resultcode.UNSUPPORTED_PARAM:1 of
msgid "Command line parameter is not supported."
msgstr "명령줄 매개변수가 지원되지 않습니다."

#: cefweaver.types.Resultcode.PROFILE_IN_USE:1 of
msgid "The profile was in use on another host."
msgstr "프로필이 다른 호스트에서 사용 중이었습니다."

#: cefweaver.types.Resultcode.PACK_EXTENSION_ERROR:1 of
msgid "Failed to pack an extension via the command line."
msgstr "명령줄을 통한 확장 프로그램 패키징에 실패했습니다."

#: cefweaver.types.Resultcode.NORMAL_EXIT_PROCESS_NOTIFIED:1 of
msgid "The browser process exited early by passing the command line to another running browser."
msgstr "실행 중인 다른 브라우저에 명령줄을 전달하고 브라우저 프로세스가 일찍 종료되었습니다."

#: cefweaver.types.Resultcode.INVALID_SANDBOX_STATE:1 of
msgid "A browser process was sandboxed."
msgstr "브라우저 프로세스가 sandbox 안에서 실행되었습니다."

#: cefweaver.types.Resultcode.INVALID_SANDBOX_STATE:3 of
msgid "This should never happen."
msgstr "이런 일은 절대 발생하지 않아야 합니다."

#: cefweaver.types.Resultcode.CLOUD_POLICY_ENROLLMENT_FAILED:1 of
msgid "Cloud policy enrollment failed or was given up by user."
msgstr "클라우드 정책 등록이 실패했거나 사용자가 포기했습니다."

#: cefweaver.types.Resultcode.GPU_EXIT_ON_CONTEXT_LOST:1 of
msgid "The GPU process was terminated due to context lost."
msgstr "컨텍스트 손실로 인해 GPU 프로세스가 종료되었습니다."

#: cefweaver.types.Resultcode.NORMAL_EXIT_PACK_EXTENSION_SUCCESS:1 of
msgid "An early startup command was executed and the browser must exit."
msgstr "초기 시작 명령이 실행되었고 브라우저가 종료되어야 합니다."

#: cefweaver.types.Resultcode.SYSTEM_RESOURCE_EXHAUSTED:1 of
msgid "The browser process exited because system resources are exhausted."
msgstr "시스템 리소스가 고갈되어 브라우저 프로세스가 종료되었습니다."

#: cefweaver.types.Resultcode.SYSTEM_RESOURCE_EXHAUSTED:3 of
msgid "The system state can't be recovered and will be unstable."
msgstr "시스템 상태를 복구할 수 없으며 불안정해집니다."

#: cefweaver.types.Resultcode.NORMAL_EXIT_AUTO_DE_ELEVATED:1 of
msgid "The browser process exited because it was re-launched without elevation."
msgstr "권한 상승 없이 다시 실행되었기 때문에 브라우저 프로세스가 종료되었습니다."

#: cefweaver.types.Resultcode.TERMINATED_BY_OTHER_PROCESS_ON_COMMIT_FAILURE:1 of
msgid ""
"Upon encountering a commit failure in a process, PartitionAlloc terminated another process deemed"
" less important."
msgstr "한 프로세스에서 commit 실패가 발생하자 PartitionAlloc이 덜 중요하다고 판단한 다른 프로세스를 종료했습니다."

#: cefweaver.types.Resultcode.INVALID_ISOLATED_BROWSER_PROCESS:1 of
msgid ""
"The isolated browser process launched but it was not possible to wait on the exit of the process,"
" so the browser must exit."
msgstr "격리된 브라우저 프로세스가 실행되었지만 해당 프로세스의 종료를 기다릴 수 없어서 브라우저가 종료되어야 합니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_INTEGRITY:1 of
msgid "Windows sandbox could not set the integrity level."
msgstr "Windows sandbox가 무결성 수준을 설정하지 못했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_DROPTOKEN:1 of
msgid "Windows sandbox could not lower the token."
msgstr "Windows sandbox가 토큰을 낮추지 못했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_FLUSHANDLES:1 of
msgid "Windows sandbox failed to flush registry handles."
msgstr "Windows sandbox가 레지스트리 핸들을 flush하지 못했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_CACHEDISABLE:1 of
msgid "Windows sandbox failed to forbid HCKU caching."
msgstr "Windows sandbox가 HCKU 캐싱을 금지하지 못했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_CLOSEHANDLES:1 of
msgid "Windows sandbox failed to close pending handles."
msgstr "Windows sandbox가 보류 중인 핸들을 닫지 못했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_MITIGATION:1 of
msgid "Windows sandbox could not set the mitigation policy."
msgstr "Windows sandbox가 완화 정책을 설정하지 못했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_MEMORY_EXCEEDED:1 of
msgid "Windows sandbox exceeded the job memory limit."
msgstr "Windows sandbox가 job 메모리 한도를 초과했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_WARMUP:1 of
msgid "Windows sandbox failed to warmup."
msgstr "Windows sandbox가 warmup에 실패했습니다."

#: cefweaver.types.Resultcode.SANDBOX_FATAL_BROKER_SHUTDOWN_HUNG:1 of
msgid "Windows sandbox broker terminated in shutdown."
msgstr "Windows sandbox broker가 종료 중에 종료되었습니다."

#: cefweaver.types.enums.ReturnValue:1 of
msgid "Return value types."
msgstr "반환값 타입."

#: cefweaver.types.ReturnValue.CANCEL:1 of
msgid "Cancel immediately."
msgstr "즉시 취소합니다."

#: cefweaver.types.ReturnValue.CONTINUE:1 of
msgid "Continue immediately."
msgstr "즉시 계속합니다."

#: cefweaver.types.ReturnValue.CONTINUE_ASYNC:1 of
msgid "Continue asynchronously (usually via a callback)."
msgstr "비동기로 계속합니다(보통 콜백을 통해)."

#: cefweaver.types.enums.RuntimeStyle:1 of
msgid ""
"CEF supports both a Chrome runtime style (based on the Chrome UI layer) and an Alloy runtime "
"style (based on the Chromium content layer)."
msgstr "CEF는 Chrome runtime 스타일(Chrome UI 레이어 기반)과 Alloy runtime 스타일(Chromium content 레이어 기반)을 모두 지원합니다."

#: cefweaver.types.enums.RuntimeStyle:3 of
msgid ""
"Chrome style provides the full Chrome UI and browser functionality whereas Alloy style provides "
"less default browser functionality but adds additional client callbacks and support for "
"windowless (off-screen) rendering. The style type is individually configured for each "
"window/browser at creation time and different styles can be mixed during runtime. For additional "
"comparative details on runtime styles see "
"https://chromiumembedded.github.io/cef/architecture#cef3"
msgstr ""
"Chrome 스타일은 전체 Chrome UI와 브라우저 기능을 제공하는 반면, Alloy 스타일은 기본 브라우저 기능이 더 적지만 추가 클라이언트 콜백과 "
"windowless(오프스크린) 렌더링 지원을 더합니다. 스타일 타입은 생성 시점에 창/브라우저마다 개별적으로 구성되며 실행 중에 서로 다른 스타일을 섞어 쓸 수 있습니다. "
"runtime 스타일의 추가 비교 내용은 https://chromiumembedded.github.io/cef/architecture#cef3 를 참조하십시오."

#: cefweaver.types.enums.RuntimeStyle:10 of
msgid ""
"Windowless rendering will always use Alloy style. Windowed rendering with a default window or "
"client-provided parent window can configure the style via ``CefWindowInfo``.runtime_style. "
"Windowed rendering with the Views framework can configure the style via "
":meth:`~cefweaver.WindowDelegate.get_window_runtime_style` and "
":meth:`~cefweaver.BrowserViewDelegate.get_browser_runtime_style`. Alloy style Windows with the "
"Views framework can host only Alloy style BrowserViews but Chrome style Windows can host both "
"style BrowserViews. Additionally, a Chrome style Window can host at most one Chrome style "
"BrowserView but potentially multiple Alloy style BrowserViews. See "
"``CefWindowInfo``.runtime_style documentation for any additional platform-specific limitations."
msgstr ""
"Windowless 렌더링은 항상 Alloy 스타일을 사용합니다. 기본 창 또는 클라이언트가 제공한 부모 창을 사용하는 windowed 렌더링은 "
"``CefWindowInfo``.runtime_style을 통해 스타일을 구성할 수 있습니다. Views framework를 사용하는 windowed 렌더링은 "
":meth:`~cefweaver.WindowDelegate.get_window_runtime_style`\\ 과 "
":meth:`~cefweaver.BrowserViewDelegate.get_browser_runtime_style`\\ 을 통해 스타일을 구성할 수 있습니다. Views "
"framework를 사용하는 Alloy 스타일 창은 Alloy 스타일 BrowserView만 호스트할 수 있지만 Chrome 스타일 창은 두 스타일의 BrowserView를 "
"모두 호스트할 수 있습니다. 또한 Chrome 스타일 창은 Chrome 스타일 BrowserView를 최대 하나만 호스트할 수 있지만 Alloy 스타일 BrowserView는"
" 여러 개를 호스트할 수 있습니다. 플랫폼별 추가 제한 사항은 ``CefWindowInfo``.runtime_style 문서를 참조하십시오."

#: cefweaver.types.RuntimeStyle.DEFAULT:1 of
msgid "Use the default style."
msgstr "기본 스타일을 사용합니다."

#: cefweaver.types.RuntimeStyle.DEFAULT:3 of
msgid "See above documentation for exceptions."
msgstr "예외는 위의 문서를 참조하십시오."

#: cefweaver.types.RuntimeStyle.CHROME:1 of
msgid "Use Chrome style."
msgstr "Chrome 스타일을 사용합니다."

#: cefweaver.types.RuntimeStyle.ALLOY:1 of
msgid "Use Alloy style."
msgstr "Alloy 스타일을 사용합니다."

#: cefweaver.types.enums.ScaleFactor:1 of
msgid "Supported UI scale factors for the platform."
msgstr "플랫폼에서 지원하는 UI 배율."

#: cefweaver.types.enums.ScaleFactor:3 of
msgid ""
"SCALE_FACTOR_NONE is used for density independent resources such as string, html/js files or an "
"image that can be used for any scale factors (such as wallpapers)."
msgstr "SCALE_FACTOR_NONE은 문자열, html/js 파일, 또는 모든 배율에 쓸 수 있는 이미지(예: 배경 화면)처럼 밀도에 독립적인 리소스에 사용됩니다."

#: cefweaver.types.enums.SchemeOptions:1 of
msgid "The CEF enumeration cef_scheme_options_t."
msgstr "CEF 열거형 cef_scheme_options_t."

#: cefweaver.types.SchemeOptions.STANDARD:1 of
msgid "If CEF_SCHEME_OPTION_STANDARD is set the scheme will be treated as a standard scheme."
msgstr "CEF_SCHEME_OPTION_STANDARD가 설정되면 scheme은 표준 scheme으로 취급됩니다."

#: cefweaver.types.SchemeOptions.STANDARD:3 of
msgid ""
"Standard schemes are subject to URL canonicalization and parsing rules as defined in the Common "
"Internet Scheme Syntax RFC 1738 Section 3.1 available at http://www.ietf.org/rfc/rfc1738.txt"
msgstr ""
"표준 scheme은 http://www.ietf.org/rfc/rfc1738.txt 에서 볼 수 있는 Common Internet Scheme Syntax RFC 1738 "
"Section 3.1에 정의된 URL 정규화 및 파싱 규칙의 적용을 받습니다."

#: cefweaver.types.SchemeOptions.STANDARD:7 of
msgid ""
"In particular, the syntax for standard scheme URLs must be of the form: "
"[scheme]://[username]:[password]@[host]:[port]/[url-path] </pre> Standard scheme URLs must have a"
" host component that is a fully qualified domain name as defined in Section 3.5 of RFC 1034 [13] "
"and Section 2.1 of RFC 1123. These URLs will be canonicalized to \"scheme://host/path\" in the "
"simplest case and \"scheme://username:password@host:port/path\" in the most explicit case. For "
"example, \"scheme:host/path\" and \"scheme:///host/path\" will both be canonicalized to "
"\"scheme://host/path\". The origin of a standard scheme URL is the combination of scheme, host "
"and port (i.e., \"scheme://host:port\" in the most explicit case)."
msgstr ""
"특히 표준 scheme URL의 구문은 다음 형태여야 합니다. [scheme]://[username]:[password]@[host]:[port]/[url-path] "
"</pre> 표준 scheme URL은 RFC 1034 [13]의 Section 3.5와 RFC 1123의 Section 2.1에 정의된 정규화된 도메인 이름(FQDN)인 "
"host 구성 요소를 가져야 합니다. 이러한 URL은 가장 단순한 경우 \"scheme://host/path\"로, 가장 명시적인 경우 "
"\"scheme://username:password@host:port/path\"로 정규화됩니다. 예를 들어 \"scheme:host/path\"와 "
"\"scheme:///host/path\"는 모두 \"scheme://host/path\"로 정규화됩니다. 표준 scheme URL의 origin은 scheme, host, "
"port의 조합입니다(즉, 가장 명시적인 경우 \"scheme://host:port\")."

#: cefweaver.types.SchemeOptions.STANDARD:17 of
msgid ""
"For non-standard scheme URLs only the \"scheme:\" component is parsed and canonicalized. The "
"remainder of the URL will be passed to the handler as- is. For example, \"scheme:///some%20text\""
" will remain the same. Non-standard scheme URLs cannot be used as a target for form submission."
msgstr ""
"비표준 scheme URL은 \"scheme:\" 구성 요소만 파싱되고 정규화됩니다. URL의 나머지 부분은 그대로 핸들러에 전달됩니다. 예를 들어 "
"\"scheme:///some%20text\"는 그대로 유지됩니다. 비표준 scheme URL은 폼 제출의 대상으로 사용할 수 없습니다."

#: cefweaver.types.SchemeOptions.LOCAL:1 of
msgid ""
"If CEF_SCHEME_OPTION_LOCAL is set the scheme will be treated with the same security rules as "
"those applied to \"file\" URLs."
msgstr "CEF_SCHEME_OPTION_LOCAL이 설정되면 scheme은 \"file\" URL에 적용되는 것과 동일한 보안 규칙으로 취급됩니다."

#: cefweaver.types.SchemeOptions.LOCAL:3 of
msgid ""
"Normal pages cannot link to or access local URLs. Also, by default, local URLs can only perform "
"XMLHttpRequest calls to the same URL (origin + path) that originated the request. To allow "
"XMLHttpRequest calls from a local URL to other URLs with the same origin set the "
"``CefSettings``.file_access_from_file_urls_allowed value to ``True`` (1). To allow XMLHttpRequest"
" calls from a local URL to all origins set the "
"``CefSettings``.universal_access_from_file_urls_allowed value to ``True`` (1)."
msgstr ""
"일반 페이지는 로컬 URL에 링크하거나 접근할 수 없습니다. 또한 기본적으로 로컬 URL은 요청을 시작한 동일한 URL(origin + 경로)에 대해서만 "
"XMLHttpRequest 호출을 수행할 수 있습니다. 로컬 URL에서 동일한 origin을 가진 다른 URL로의 XMLHttpRequest 호출을 허용하려면 "
"``CefSettings``.file_access_from_file_urls_allowed 값을 ``True``\\ (1)로 설정하십시오. 로컬 URL에서 모든 "
"origin으로의 XMLHttpRequest 호출을 허용하려면 ``CefSettings``.universal_access_from_file_urls_allowed 값을 "
"``True``\\ (1)로 설정하십시오."

#: cefweaver.types.SchemeOptions.DISPLAY_ISOLATED:1 of
msgid ""
"If CEF_SCHEME_OPTION_DISPLAY_ISOLATED is set the scheme can only be displayed from other content "
"hosted with the same scheme."
msgstr "CEF_SCHEME_OPTION_DISPLAY_ISOLATED가 설정되면 해당 scheme은 같은 scheme으로 호스팅되는 다른 콘텐츠에서만 표시될 수 있습니다."

#: cefweaver.types.SchemeOptions.DISPLAY_ISOLATED:3 of
msgid ""
"For example, pages in other origins cannot create iframes or hyperlinks to URLs with the scheme. "
"For schemes that must be accessible from other schemes don't set this, set "
"CEF_SCHEME_OPTION_CORS_ENABLED, and use CORS \"Access-Control-Allow-Origin\" headers to further "
"restrict access."
msgstr ""
"예를 들어 다른 origin의 페이지는 해당 scheme의 URL에 대한 iframe이나 하이퍼링크를 만들 수 없습니다. 다른 scheme에서 접근할 수 있어야 하는 "
"scheme에는 이 값을 설정하지 말고 CEF_SCHEME_OPTION_CORS_ENABLED를 설정한 뒤 CORS \"Access-Control-Allow-Origin\" "
"헤더로 접근을 추가로 제한하십시오."

#: cefweaver.types.SchemeOptions.SECURE:1 of
msgid ""
"If CEF_SCHEME_OPTION_SECURE is set the scheme will be treated with the same security rules as "
"those applied to \"https\" URLs."
msgstr "CEF_SCHEME_OPTION_SECURE가 설정되면 scheme은 \"https\" URL에 적용되는 것과 동일한 보안 규칙으로 취급됩니다."

#: cefweaver.types.SchemeOptions.SECURE:3 of
msgid ""
"For example, loading this scheme from other secure schemes will not trigger mixed content "
"warnings."
msgstr "예를 들어 다른 보안 scheme에서 이 scheme을 로드해도 mixed content 경고가 발생하지 않습니다."

#: cefweaver.types.SchemeOptions.CORS_ENABLED:1 of
msgid "If CEF_SCHEME_OPTION_CORS_ENABLED is set the scheme can be sent CORS requests."
msgstr "CEF_SCHEME_OPTION_CORS_ENABLED가 설정되면 해당 scheme에 CORS 요청을 보낼 수 있습니다."

#: cefweaver.types.SchemeOptions.CORS_ENABLED:3 of
msgid "This value should be set in most cases where CEF_SCHEME_OPTION_STANDARD is set."
msgstr "CEF_SCHEME_OPTION_STANDARD가 설정되는 대부분의 경우에 이 값도 설정해야 합니다."

#: cefweaver.types.SchemeOptions.CSP_BYPASSING:1 of
msgid ""
"If CEF_SCHEME_OPTION_CSP_BYPASSING is set the scheme can bypass Content- Security-Policy (CSP) "
"checks."
msgstr "CEF_SCHEME_OPTION_CSP_BYPASSING이 설정되면 scheme은 Content-Security-Policy(CSP) 검사를 우회할 수 있습니다."

#: cefweaver.types.SchemeOptions.CSP_BYPASSING:3 of
msgid "This value should not be set in most cases where CEF_SCHEME_OPTION_STANDARD is set."
msgstr "CEF_SCHEME_OPTION_STANDARD가 설정되는 대부분의 경우에 이 값은 설정하지 않아야 합니다."

#: cefweaver.types.SchemeOptions.FETCH_ENABLED:1 of
msgid "If CEF_SCHEME_OPTION_FETCH_ENABLED is set the scheme can perform Fetch API requests."
msgstr "CEF_SCHEME_OPTION_FETCH_ENABLED가 설정되면 scheme은 Fetch API 요청을 수행할 수 있습니다."

#: cefweaver.types.enums.ShowState:1 of
msgid "Show states supported by :meth:`~cefweaver.WindowDelegate.get_initial_show_state`."
msgstr ":meth:`~cefweaver.WindowDelegate.get_initial_show_state`\\ 가 지원하는 표시 상태."

#: cefweaver.types.ShowState.NORMAL:1 of
msgid "Show the window as normal."
msgstr "창을 보통 상태로 표시합니다."

#: cefweaver.types.ShowState.MINIMIZED:1 of
msgid "Show the window as minimized."
msgstr "창을 최소화된 상태로 표시합니다."

#: cefweaver.types.ShowState.MAXIMIZED:1 of
msgid "Show the window as maximized."
msgstr "창을 최대화된 상태로 표시합니다."

#: cefweaver.types.ShowState.FULLSCREEN:1 of
msgid "Show the window as fullscreen."
msgstr "창을 전체 화면으로 표시합니다."

#: cefweaver.types.ShowState.HIDDEN:1 of
msgid "Show the window as hidden (no dock thumbnail)."
msgstr "창을 숨김 상태로 표시합니다(dock 미리보기 없음)."

#: cefweaver.types.ShowState.HIDDEN:3 of
msgid "Only supported on MacOS."
msgstr "MacOS에서만 지원됩니다."

#: cefweaver.types.enums.SslContentStatus:1 of
msgid "Supported SSL content status flags."
msgstr "지원되는 SSL 콘텐츠 상태 플래그."

#: cefweaver.types.enums.SslContentStatus:3 of
msgid "See content/public/common/ssl_status.h for more information."
msgstr "자세한 내용은 content/public/common/ssl_status.h를 참조하십시오."

#: cefweaver.types.enums.SslVersion:1 of
msgid "Supported SSL version values."
msgstr "지원되는 SSL 버전 값."

#: cefweaver.types.enums.SslVersion:3 of
msgid "See net/ssl/ssl_connection_status_flags.h for more information."
msgstr "자세한 내용은 net/ssl/ssl_connection_status_flags.h를 참조하십시오."

#: cefweaver.types.SslVersion.UNKNOWN:1 of
msgid "Unknown SSL version."
msgstr "알 수 없는 SSL 버전."

#: cefweaver.types.enums.State:1 of
msgid "Represents the state of a setting."
msgstr "설정의 상태를 나타냅니다."

#: cefweaver.types.State.DEFAULT:1 of
msgid "Use the default state for the setting."
msgstr "설정의 기본 상태를 사용합니다."

#: cefweaver.types.State.ENABLED:1 of
msgid "Enable or allow the setting."
msgstr "설정을 활성화하거나 허용합니다."

#: cefweaver.types.State.DISABLED:1 of
msgid "Disable or disallow the setting."
msgstr "설정을 비활성화하거나 허용하지 않습니다."

#: cefweaver.types.enums.StorageType:1 of
msgid "Storage types."
msgstr "저장소 타입."

#: cefweaver.types.enums.TaskType:1 of
msgid "Specifies the task type variants supported by :class:`~cefweaver.TaskManager`."
msgstr ":class:`~cefweaver.TaskManager`\\ 가 지원하는 작업 타입 변형을 지정합니다."

#: cefweaver.types.enums.TaskType:3 of
msgid "Should be kept in sync with Chromium's task_manager::Task::Type type."
msgstr "Chromium의 task_manager::Task::Type 타입과 동기화된 상태를 유지해야 합니다."

#: cefweaver.types.TaskType.BROWSER:1 of
msgid "The main browser process."
msgstr "메인 브라우저 프로세스."

#: cefweaver.types.TaskType.GPU:1 of
msgid "A graphics process."
msgstr "그래픽 프로세스."

#: cefweaver.types.TaskType.ZYGOTE:1 of
msgid "A Linux zygote process."
msgstr "Linux zygote 프로세스."

#: cefweaver.types.TaskType.UTILITY:1 of
msgid "A browser utility process."
msgstr "브라우저 utility 프로세스."

#: cefweaver.types.TaskType.RENDERER:1 of
msgid "A normal WebContents renderer process."
msgstr "일반 WebContents renderer 프로세스."

#: cefweaver.types.TaskType.EXTENSION:1 of
msgid "An extension or app process."
msgstr "확장 프로그램 또는 앱 프로세스."

#: cefweaver.types.TaskType.GUEST:1 of
msgid "A browser plugin guest process."
msgstr "브라우저 플러그인 guest 프로세스."

#: cefweaver.types.TaskType.SANDBOX_HELPER:1 of
msgid "A sandbox helper process"
msgstr "Sandbox helper 프로세스"

#: cefweaver.types.TaskType.DEDICATED_WORKER:1 of
msgid "A dedicated worker running on the renderer process."
msgstr "renderer 프로세스에서 실행되는 전용 worker."

#: cefweaver.types.TaskType.SHARED_WORKER:1 of
msgid "A shared worker running on the renderer process."
msgstr "renderer 프로세스에서 실행되는 공유 worker."

#: cefweaver.types.TaskType.SERVICE_WORKER:1 of
msgid "A service worker running on the renderer process."
msgstr "renderer 프로세스에서 실행되는 service worker."

#: cefweaver.types.enums.TerminationStatus:1 of
msgid "Process termination status values."
msgstr "프로세스 종료 상태 값."

#: cefweaver.types.TerminationStatus.ABNORMAL_TERMINATION:1 of
msgid "Non-zero exit status."
msgstr "0이 아닌 종료 상태."

#: cefweaver.types.TerminationStatus.PROCESS_WAS_KILLED:1 of
msgid "SIGKILL or task manager kill."
msgstr "SIGKILL 또는 작업 관리자에 의한 종료."

#: cefweaver.types.TerminationStatus.PROCESS_CRASHED:1 of
msgid "Segmentation fault."
msgstr "세그멘테이션 오류."

#: cefweaver.types.TerminationStatus.PROCESS_OOM:1 of
msgid "Out of memory."
msgstr "메모리 부족."

#: cefweaver.types.TerminationStatus.PROCESS_OOM:3 of
msgid "Some platforms may use TS_PROCESS_CRASHED instead."
msgstr "일부 플랫폼에서는 대신 TS_PROCESS_CRASHED를 사용할 수 있습니다."

#: cefweaver.types.TerminationStatus.LAUNCH_FAILED:1 of
msgid "Child process never launched."
msgstr "자식 프로세스가 실행되지 않았습니다."

#: cefweaver.types.TerminationStatus.INTEGRITY_FAILURE:1 of
msgid "On Windows, the OS terminated the process due to code integrity failure."
msgstr "Windows에서 코드 무결성 실패로 인해 OS가 프로세스를 종료했습니다."

#: cefweaver.types.enums.TestCertType:1 of
msgid "Certificate types supported by ``CefTestServer::CreateAndStart``."
msgstr "``CefTestServer::CreateAndStart``\\ 가 지원하는 인증서 타입."

#: cefweaver.types.enums.TestCertType:3 of
msgid ""
"The matching certificate file must exist in the \"net/data/ssl/certificates\" directory. See "
"``CefSetDataDirectoryForTests`` () for related configuration."
msgstr ""
"일치하는 인증서 파일이 \"net/data/ssl/certificates\" 디렉터리에 있어야 합니다. 관련 구성은 ``CefSetDataDirectoryForTests`` "
"()를 참조하십시오."

#: cefweaver.types.TestCertType.OK_IP:1 of
msgid "Valid certificate using the IP (127.0.0.1)."
msgstr "IP(127.0.0.1)를 사용하는 유효한 인증서."

#: cefweaver.types.TestCertType.OK_IP:3 of
msgid "Loads the \"ok_cert.pem\" file."
msgstr "\"ok_cert.pem\" 파일을 로드합니다."

#: cefweaver.types.TestCertType.OK_DOMAIN:1 of
msgid "Valid certificate using the domain (\"localhost\")."
msgstr "도메인(\"localhost\")을 사용하는 유효한 인증서."

#: cefweaver.types.TestCertType.OK_DOMAIN:3 of
msgid "Loads the \"localhost_cert.pem\" file."
msgstr "\"localhost_cert.pem\" 파일을 로드합니다."

#: cefweaver.types.TestCertType.EXPIRED:1 of
msgid "Expired certificate."
msgstr "만료된 인증서."

#: cefweaver.types.TestCertType.EXPIRED:3 of
msgid "Loads the \"expired_cert.pem\" file."
msgstr "\"expired_cert.pem\" 파일을 로드합니다."

#: cefweaver.types.enums.TextFieldCommands:1 of
msgid "Represents commands available to TextField."
msgstr "TextField에서 사용할 수 있는 명령을 나타냅니다."

#: cefweaver.types.enums.TextFieldCommands:3 of
msgid "Should be kept in sync with Chromium's views::TextField::MenuCommands type."
msgstr "Chromium의 views::TextField::MenuCommands 타입과 동기화된 상태를 유지해야 합니다."

#: cefweaver.types.enums.TextInputMode:1 of
msgid "Input mode of a virtual keyboard."
msgstr "가상 키보드의 입력 모드."

#: cefweaver.types.enums.TextInputMode:3 of
msgid ""
"These constants match their equivalents in Chromium's text_input_mode.h and should not be "
"renumbered. See https://html.spec.whatwg.org/#input-modalities:-the-inputmode-attribute"
msgstr ""
"이 상수들은 Chromium의 text_input_mode.h에 있는 대응 상수와 일치하며 번호를 다시 매기면 안 됩니다. https://html.spec.whatwg.org"
"/#input-modalities:-the-inputmode-attribute 를 참조하십시오."

#: cefweaver.types.enums.TextStyle:1 of
msgid "Text style types."
msgstr "텍스트 스타일 타입."

#: cefweaver.types.enums.TextStyle:3 of
msgid "Should be kepy in sync with gfx::TextStyle."
msgstr "gfx::TextStyle과 동기화된 상태를 유지해야 합니다."

#: cefweaver.types.enums.ThreadId:1 of
msgid "Existing thread IDs."
msgstr "존재하는 스레드 ID."

#: cefweaver.types.ThreadId.UI:1 of
msgid "The main thread in the browser."
msgstr "브라우저의 메인 스레드."

#: cefweaver.types.ThreadId.UI:3 of
msgid ""
"This will be the same as the main application thread if ``CefInitialize`` () is called with a "
"``CefSettings``.multi_threaded_message_loop value of ``False``. Do not perform blocking tasks on "
"this thread. All tasks posted after ``CefBrowserProcessHandler::OnContextInitialized()`` and "
"before ``CefShutdown`` () are guaranteed to run. This thread will outlive all other CEF threads."
msgstr ""
"``CefInitialize`` ()를 ``CefSettings``.multi_threaded_message_loop 값을 ``False``\\ 로 하여 호출하면 이것은 메인"
" 애플리케이션 스레드와 같습니다. 이 스레드에서 블로킹 작업을 수행하지 마십시오. "
"``CefBrowserProcessHandler::OnContextInitialized()`` 이후와 ``CefShutdown`` () 이전에 게시된 모든 작업은 실행이 "
"보장됩니다. 이 스레드는 다른 모든 CEF 스레드보다 오래 유지됩니다."

#: cefweaver.types.ThreadId.FILE_BACKGROUND:1 of
msgid ""
"Used for blocking tasks like file system access where the user won't notice if the task takes an "
"arbitrarily long time to complete."
msgstr "작업이 임의로 오래 걸려도 사용자가 알아차리지 못하는 파일 시스템 접근 같은 블로킹 작업에 사용됩니다."

#: cefweaver.types.ThreadId.FILE_BACKGROUND:3 of
msgid ""
"All tasks posted after ``CefBrowserProcessHandler::OnContextInitialized()`` and before "
"``CefShutdown`` () are guaranteed to run."
msgstr ""
"``CefBrowserProcessHandler::OnContextInitialized()`` 이후와 ``CefShutdown`` () 이전에 게시된 모든 작업은 실행이 "
"보장됩니다."

#: cefweaver.types.ThreadId.FILE_USER_VISIBLE:1 of
msgid ""
"Used for blocking tasks like file system access that affect UI or responsiveness of future user "
"interactions."
msgstr "이후 사용자 상호작용의 UI나 응답성에 영향을 주는 파일 시스템 접근 같은 블로킹 작업에 사용됩니다."

#: cefweaver.types.ThreadId.FILE_USER_VISIBLE:3 of
msgid ""
"Do not use if an immediate response to a user interaction is expected. All tasks posted after "
"``CefBrowserProcessHandler::OnContextInitialized()`` and before ``CefShutdown`` () are guaranteed"
" to run. Examples:"
msgstr ""
"사용자 상호작용에 즉각적인 응답이 기대되는 경우에는 사용하지 마십시오. ``CefBrowserProcessHandler::OnContextInitialized()`` 이후와 "
"``CefShutdown`` () 이전에 게시된 모든 작업은 실행이 보장됩니다. 예시:"

#: cefweaver.types.ThreadId.FILE_USER_VISIBLE:7 of
msgid "Updating the UI to reflect progress on a long task."
msgstr "오래 걸리는 작업의 진행 상황을 반영하도록 UI를 갱신합니다."

#: cefweaver.types.ThreadId.FILE_USER_VISIBLE:8 of
msgid "Loading data that might be shown in the UI after a future user interaction."
msgstr "이후 사용자 상호작용 뒤에 UI에 표시될 수 있는 데이터를 로드합니다."

#: cefweaver.types.ThreadId.FILE_USER_BLOCKING:1 of
msgid ""
"Used for blocking tasks like file system access that affect UI immediately after a user "
"interaction."
msgstr "사용자 상호작용 직후 UI에 영향을 주는 파일 시스템 접근 같은 블로킹 작업에 사용됩니다."

#: cefweaver.types.ThreadId.FILE_USER_BLOCKING:3 of
msgid ""
"All tasks posted after ``CefBrowserProcessHandler::OnContextInitialized()`` and before "
"``CefShutdown`` () are guaranteed to run. Example: Generating data shown in the UI immediately "
"after a click."
msgstr ""
"``CefBrowserProcessHandler::OnContextInitialized()`` 이후와 ``CefShutdown`` () 이전에 게시된 모든 작업은 실행이 "
"보장됩니다. 예시: 클릭 직후 UI에 표시되는 데이터를 생성합니다."

#: cefweaver.types.ThreadId.PROCESS_LAUNCHER:1 of
msgid "Used to launch and terminate browser processes."
msgstr "브라우저 프로세스를 실행하고 종료하는 데 사용됩니다."

#: cefweaver.types.ThreadId.IO:1 of
msgid "Used to process IPC and network messages."
msgstr "IPC 및 네트워크 메시지를 처리하는 데 사용됩니다."

#: cefweaver.types.ThreadId.IO:3 of
msgid ""
"Do not perform blocking tasks on this thread. All tasks posted after "
"``CefBrowserProcessHandler::OnContextInitialized()`` and before ``CefShutdown`` () are guaranteed"
" to run."
msgstr ""
"이 스레드에서 블로킹 작업을 수행하지 마십시오. ``CefBrowserProcessHandler::OnContextInitialized()`` 이후와 "
"``CefShutdown`` () 이전에 게시된 모든 작업은 실행이 보장됩니다."

#: cefweaver.types.ThreadId.RENDERER:1 of
msgid "The main thread in the renderer."
msgstr "Renderer의 메인 스레드."

#: cefweaver.types.ThreadId.RENDERER:3 of
msgid ""
"Used for all WebKit and V8 interaction. Tasks may be posted to this thread after "
"``CefRenderProcessHandler::OnWebKitInitialized`` but are not guaranteed to run before sub-process"
" termination (sub-processes may be killed at any time without warning)."
msgstr ""
"모든 WebKit 및 V8 상호작용에 사용됩니다. 작업은 ``CefRenderProcessHandler::OnWebKitInitialized`` 이후에 이 스레드에 게시할 수"
" 있지만 하위 프로세스가 종료되기 전에 실행되는 것은 보장되지 않습니다(하위 프로세스는 경고 없이 언제든지 종료될 수 있습니다)."

#: cefweaver.types.enums.ThreadPriority:1 of
msgid "Thread priority values listed in increasing order of importance."
msgstr "중요도가 높아지는 순서로 나열한 스레드 우선순위 값."

#: cefweaver.types.ThreadPriority.BACKGROUND:1 of
msgid "Suitable for threads that shouldn't disrupt high priority work."
msgstr "높은 우선순위의 작업을 방해하지 않아야 하는 스레드에 적합합니다."

#: cefweaver.types.ThreadPriority.NORMAL:1 of
msgid "Default priority level."
msgstr "기본 우선순위 수준."

#: cefweaver.types.ThreadPriority.DISPLAY:1 of
msgid "Suitable for threads which generate data for the display (at ~60Hz)."
msgstr "디스플레이용 데이터를 생성하는(~60Hz) 스레드에 적합합니다."

#: cefweaver.types.ThreadPriority.REALTIME_AUDIO:1 of
msgid "Suitable for low-latency, glitch-resistant audio."
msgstr "지연 시간이 짧고 끊김에 강한 오디오에 적합합니다."

#: cefweaver.types.enums.TouchEventType:1 of
msgid "Touch points states types."
msgstr "터치 포인트 상태 타입."

#: cefweaver.types.enums.TouchHandleStateFlags:1 of
msgid "Values indicating what state of the touch handle is set."
msgstr "터치 핸들이 어떤 상태로 설정되어 있는지를 나타내는 값."

#: cefweaver.types.enums.TransitionType:1 of
msgid "Transition type for a request."
msgstr "요청의 전환 타입."

#: cefweaver.types.enums.TransitionType:3 of
msgid "Made up of one source value and 0 or more qualifiers."
msgstr "하나의 소스 값과 0개 이상의 한정자로 구성됩니다."

#: cefweaver.types.TransitionType.LINK:1 of
msgid "Source is a link click or the JavaScript window.open function."
msgstr "소스는 링크 클릭 또는 JavaScript window.open 함수입니다."

#: cefweaver.types.TransitionType.LINK:3 of
msgid "This is also the default value for requests like sub-resource loads that are not navigations."
msgstr "또한 탐색이 아닌 하위 리소스 로드 같은 요청의 기본값이기도 합니다."

#: cefweaver.types.TransitionType.EXPLICIT:1 of
msgid "Source is some other \"explicit\" navigation."
msgstr "소스는 그 밖의 \"명시적\" 탐색입니다."

#: cefweaver.types.TransitionType.EXPLICIT:3 of
msgid ""
"This is the default value for navigations where the actual type is unknown. See also "
"TT_DIRECT_LOAD_FLAG."
msgstr "실제 타입을 알 수 없는 탐색의 기본값입니다. TT_DIRECT_LOAD_FLAG도 참조하십시오."

#: cefweaver.types.TransitionType.AUTO_BOOKMARK:1 of
msgid "User got to this page through a suggestion in the UI (for example, via the destinations page)."
msgstr "사용자가 UI의 제안(예: 대상 페이지)을 통해 이 페이지에 도달했습니다."

#: cefweaver.types.TransitionType.AUTO_BOOKMARK:3 cefweaver.types.TransitionType.FROM_API_FLAG:3
#: cefweaver.types.TransitionType.HOME_PAGE_FLAG:3 of
msgid "Chrome style only."
msgstr "Chrome 스타일 전용."

#: cefweaver.types.TransitionType.AUTO_SUBFRAME:1 of
msgid "Source is a subframe navigation."
msgstr "소스는 하위 frame 탐색입니다."

#: cefweaver.types.TransitionType.AUTO_SUBFRAME:3 of
msgid ""
"This is any content that is automatically loaded in a non-toplevel frame. For example, if a page "
"consists of several frames containing ads, those ad URLs will have this transition type. The user"
" may not even realize the content in these pages is a separate frame, so may not care about the "
"URL."
msgstr ""
"최상위가 아닌 frame에 자동으로 로드되는 모든 콘텐츠입니다. 예를 들어 페이지가 광고를 담은 여러 frame으로 구성되어 있다면 그 광고 URL은 이 전환 타입을 "
"가집니다. 사용자는 이 페이지들의 콘텐츠가 별도의 frame이라는 것을 알지 못할 수도 있으므로 URL에 신경 쓰지 않을 수 있습니다."

#: cefweaver.types.TransitionType.MANUAL_SUBFRAME:1 of
msgid ""
"Source is a subframe navigation explicitly requested by the user that will generate new "
"navigation entries in the back/forward list."
msgstr "소스는 사용자가 명시적으로 요청한 하위 frame 탐색이며 뒤로/앞으로 목록에 새 탐색 항목을 생성합니다."

#: cefweaver.types.TransitionType.MANUAL_SUBFRAME:3 of
msgid ""
"These are probably more important than frames that were automatically loaded in the background "
"because the user probably cares about the fact that this link was loaded."
msgstr "사용자는 이 링크가 로드되었다는 사실에 관심을 가질 가능성이 높으므로, 이들은 백그라운드에서 자동으로 로드된 frame보다 아마 더 중요할 것입니다."

#: cefweaver.types.TransitionType.GENERATED:1 of
msgid ""
"User got to this page by typing in the URL bar and selecting an entry that did not look like a "
"URL."
msgstr "사용자가 URL 표시줄에 입력한 뒤 URL처럼 보이지 않는 항목을 선택하여 이 페이지에 도달했습니다."

#: cefweaver.types.TransitionType.GENERATED:3 of
msgid ""
"For example, a match might have the URL of a Google search result page, but appear like \"Search "
"Google for ...\". These are not quite the same as EXPLICIT navigations because the user didn't "
"type or see the destination URL. Chrome style only. See also TT_KEYWORD."
msgstr ""
"예를 들어 일치 항목이 Google 검색 결과 페이지의 URL을 갖고 있지만 \"Google에서 ... 검색\"처럼 보일 수 있습니다. 사용자가 대상 URL을 입력하거나 보지"
" 않았으므로 EXPLICIT 탐색과 완전히 같지는 않습니다. Chrome 스타일 전용. TT_KEYWORD도 참조하십시오."

#: cefweaver.types.TransitionType.AUTO_TOPLEVEL:1 of
msgid "This is a toplevel navigation."
msgstr "이것은 최상위 탐색입니다."

#: cefweaver.types.TransitionType.AUTO_TOPLEVEL:3 of
msgid ""
"This is any content that is automatically loaded in a toplevel frame.  For example, opening a tab"
" to show the ASH screen saver, opening the devtools window, opening the NTP after the safe "
"browsing warning, opening web-based dialog boxes are examples of AUTO_TOPLEVEL navigations. "
"Chrome style only."
msgstr ""
"최상위 frame에 자동으로 로드되는 모든 콘텐츠입니다. 예를 들어 ASH 화면 보호기를 표시하기 위해 탭을 여는 것, devtools 창을 여는 것, 세이프 브라우징 경고 "
"후에 NTP를 여는 것, 웹 기반 대화 상자를 여는 것이 AUTO_TOPLEVEL 탐색의 예입니다. Chrome 스타일 전용."

#: cefweaver.types.TransitionType.FORM_SUBMIT:1 of
msgid "Source is a form submission by the user."
msgstr "소스는 사용자의 폼 제출입니다."

#: cefweaver.types.TransitionType.FORM_SUBMIT:3 of
msgid ""
"NOTE: In some situations submitting a form does not result in this transition type. This can "
"happen if the form uses a script to submit the contents."
msgstr "참고: 일부 상황에서는 폼을 제출해도 이 전환 타입이 되지 않습니다. 폼이 스크립트를 사용해 내용을 제출하는 경우에 그럴 수 있습니다."

#: cefweaver.types.TransitionType.RELOAD:1 of
msgid "Source is a \"reload\" of the page via the Reload function or by re-visiting the same URL."
msgstr "소스는 Reload 함수를 통하거나 같은 URL을 다시 방문하는 방식의 페이지 \"reload\"입니다."

#: cefweaver.types.TransitionType.RELOAD:3 of
msgid ""
"NOTE: This is distinct from the concept of whether a particular load uses \"reload semantics\" "
"(i.e. bypasses cached data)."
msgstr "참고: 이것은 특정 로드가 \"reload 의미 체계\"(즉, 캐시된 데이터를 우회)를 사용하는지 여부라는 개념과는 별개입니다."

#: cefweaver.types.TransitionType.KEYWORD:1 of
msgid "The url was generated from a replaceable keyword other than the default search provider."
msgstr "기본 검색 제공자가 아닌 교체 가능한 키워드에서 url이 생성되었습니다."

#: cefweaver.types.TransitionType.KEYWORD:3 of
msgid ""
"If the user types a keyword (which also applies to tab-to-search) in the omnibox this qualifier "
"is applied to the transition type of the generated url. TemplateURLModel then may generate an "
"additional visit with a transition type of TT_KEYWORD_GENERATED against the url 'http://' + "
"keyword. For example, if you do a tab-to-search against wikipedia the generated url has a "
"transition qualifer of TT_KEYWORD, and TemplateURLModel generates a visit for 'wikipedia.org' "
"with a transition type of TT_KEYWORD_GENERATED. Chrome style only."
msgstr ""
"사용자가 omnibox에 키워드(tab-to-search에도 적용됨)를 입력하면 이 한정자가 생성된 url의 전환 타입에 적용됩니다. 그러면 TemplateURLModel이 "
"url 'http://' + keyword에 대해 전환 타입 TT_KEYWORD_GENERATED로 추가 방문을 생성할 수 있습니다. 예를 들어 wikipedia에 대해 "
"tab-to-search를 하면 생성된 url은 전환 한정자 TT_KEYWORD를 가지며, TemplateURLModel은 'wikipedia.org'에 대해 전환 타입 "
"TT_KEYWORD_GENERATED로 방문을 생성합니다. Chrome 스타일 전용."

#: cefweaver.types.TransitionType.KEYWORD_GENERATED:1 of
msgid "Corresponds to a visit generated for a keyword."
msgstr "키워드에 대해 생성된 방문에 해당합니다."

#: cefweaver.types.TransitionType.KEYWORD_GENERATED:3 of
msgid "See description of TT_KEYWORD for more details. Chrome style only."
msgstr "자세한 내용은 TT_KEYWORD의 설명을 참조하십시오. Chrome 스타일 전용."

#: cefweaver.types.TransitionType.SOURCE_MASK:1 of
msgid "General mask defining the bits used for the source values."
msgstr "소스 값에 사용되는 비트를 정의하는 일반 마스크."

#: cefweaver.types.TransitionType.BLOCKED_FLAG:1 of
msgid "Attempted to visit a URL but was blocked."
msgstr "URL 방문을 시도했지만 차단되었습니다."

#: cefweaver.types.TransitionType.FORWARD_BACK_FLAG:1 of
msgid "Used the Forward or Back function to navigate among browsing history."
msgstr "앞으로 또는 뒤로 함수를 사용해 탐색 기록 사이를 이동했습니다."

#: cefweaver.types.TransitionType.FORWARD_BACK_FLAG:3 of
msgid "Will be ORed to the transition type for the original load."
msgstr "원래 로드의 전환 타입에 OR 연산으로 합쳐집니다."

#: cefweaver.types.TransitionType.DIRECT_LOAD_FLAG:1 of
msgid "Loaded a URL directly via CreateBrowser, LoadURL or LoadRequest."
msgstr "CreateBrowser, LoadURL 또는 LoadRequest를 통해 URL을 직접 로드했습니다."

#: cefweaver.types.TransitionType.HOME_PAGE_FLAG:1 of
msgid "User is navigating to the home page."
msgstr "사용자가 홈 페이지로 이동하고 있습니다."

#: cefweaver.types.TransitionType.FROM_API_FLAG:1 of
msgid ""
"The transition originated from an external application; the exact definition of this is embedder "
"dependent."
msgstr "전환이 외부 애플리케이션에서 시작되었습니다. 정확한 정의는 embedder에 따라 다릅니다."

#: cefweaver.types.TransitionType.CHAIN_START_FLAG:1 of
msgid "The beginning of a navigation chain."
msgstr "탐색 체인의 시작."

#: cefweaver.types.TransitionType.CHAIN_END_FLAG:1 of
msgid "The last transition in a redirect chain."
msgstr "리디렉션 체인의 마지막 전환."

#: cefweaver.types.TransitionType.CLIENT_REDIRECT_FLAG:1 of
msgid "Redirects caused by JavaScript or a meta refresh tag on the page."
msgstr "JavaScript 또는 페이지의 meta refresh 태그로 인한 리디렉션."

#: cefweaver.types.TransitionType.SERVER_REDIRECT_FLAG:1 of
msgid "Redirects sent from the server by HTTP headers."
msgstr "서버가 HTTP 헤더로 보낸 리디렉션."

#: cefweaver.types.TransitionType.IS_REDIRECT_MASK:1 of
msgid "Used to test whether a transition involves a redirect."
msgstr "전환에 리디렉션이 포함되어 있는지 테스트하는 데 사용됩니다."

#: cefweaver.types.TransitionType.QUALIFIER_MASK:1 of
msgid "General mask defining the bits used for the qualifiers."
msgstr "한정자에 사용되는 비트를 정의하는 일반 마스크."

#: cefweaver.types.enums.URLRequestStatus:1 of
msgid "Flags that represent :class:`~cefweaver.URLRequest` status."
msgstr ":class:`~cefweaver.URLRequest`\\ 의 상태를 나타내는 플래그."

#: cefweaver.types.URLRequestStatus.UNKNOWN:1 of
msgid "Unknown status."
msgstr "알 수 없는 상태."

#: cefweaver.types.URLRequestStatus.SUCCESS:1 of
msgid "Request succeeded."
msgstr "요청이 성공했습니다."

#: cefweaver.types.URLRequestStatus.IO_PENDING:1 of
msgid "An IO request is pending, and the caller will be informed when it is completed."
msgstr "IO 요청이 보류 중이며 완료되면 호출자에게 알려집니다."

#: cefweaver.types.URLRequestStatus.CANCELED:1 of
msgid "Request was canceled programatically."
msgstr "요청이 프로그램에 의해 취소되었습니다."

#: cefweaver.types.URLRequestStatus.FAILED:1 of
msgid "Request failed for some reason."
msgstr "어떤 이유로 요청이 실패했습니다."

#: cefweaver.types.enums.UriUnescapeRule:1 of
msgid "URI unescape rules passed to ``CefURIDecode`` ()."
msgstr "``CefURIDecode`` ()에 전달되는 URI unescape 규칙."

#: cefweaver.types.UriUnescapeRule.NONE:1 of
msgid "Don't unescape anything at all."
msgstr "아무것도 unescape하지 않습니다."

#: cefweaver.types.UriUnescapeRule.NORMAL:1 of
msgid "Don't unescape anything special, but all normal unescaping will happen."
msgstr "특별한 것은 unescape하지 않지만 모든 일반 unescape는 수행됩니다."

#: cefweaver.types.UriUnescapeRule.NORMAL:3 of
msgid ""
"This is a placeholder and can't be combined with other flags (since it's just the absence of "
"them). All other unescape rules imply \"normal\" in addition to their special meaning. Things "
"like escaped letters, digits, and most symbols will get unescaped with this mode."
msgstr ""
"이것은 자리 표시자이며(단지 다른 플래그가 없다는 의미이므로) 다른 플래그와 결합할 수 없습니다. 다른 모든 unescape 규칙은 고유한 의미에 더해 \"normal\"을 "
"함의합니다. 이스케이프된 문자, 숫자, 대부분의 기호 같은 것들이 이 모드에서 unescape됩니다."

#: cefweaver.types.UriUnescapeRule.SPACES:1 of
msgid "Convert %20 to spaces."
msgstr "%20을 공백으로 변환합니다."

#: cefweaver.types.UriUnescapeRule.SPACES:3 of
msgid ""
"In some places where we're showing URLs, we may want this. In places where the URL may be copied "
"and pasted out, then you wouldn't want this since it might not be interpreted in one piece by "
"other applications."
msgstr ""
"URL을 표시하는 일부 위치에서는 이것이 필요할 수 있습니다. URL이 복사되어 붙여넣어질 수 있는 위치에서는 다른 애플리케이션이 하나의 URL로 해석하지 못할 수 있으므로 "
"이것을 원하지 않을 것입니다."

#: cefweaver.types.UriUnescapeRule.PATH_SEPARATORS:1 of
msgid "Unescapes '/' and '\\\\'."
msgstr "'/'와 '\\\\'를 unescape합니다."

#: cefweaver.types.UriUnescapeRule.PATH_SEPARATORS:3 of
msgid ""
"If these characters were unescaped, the resulting URL won't be the same as the source one. "
"Moreover, they are dangerous to unescape in strings that will be used as file paths or names. "
"This value should only be used when slashes don't have special meaning, like data URLs."
msgstr ""
"이 문자들을 unescape하면 결과 URL이 원본과 같지 않게 됩니다. 게다가 파일 경로나 이름으로 사용될 문자열에서 unescape하는 것은 위험합니다. 이 값은 data"
" URL처럼 슬래시가 특별한 의미를 갖지 않는 경우에만 사용해야 합니다."

#: cefweaver.types.UriUnescapeRule.URL_SPECIAL_CHARS_EXCEPT_PATH_SEPARATORS:1 of
msgid "Unescapes various characters that will change the meaning of URLs, including '%', '+', '&', '#'."
msgstr "'%', '+', '&', '#'를 포함하여 URL의 의미를 바꿀 수 있는 여러 문자를 unescape합니다."

#: cefweaver.types.UriUnescapeRule.URL_SPECIAL_CHARS_EXCEPT_PATH_SEPARATORS:3 of
msgid ""
"Does not unescape path separators. If these characters were unescaped, the resulting URL won't be"
" the same as the source one. This flag is used when generating final output like filenames for "
"URLs where we won't be interpreting as a URL and want to do as much unescaping as possible."
msgstr ""
"경로 구분자는 unescape하지 않습니다. 이 문자들을 unescape하면 결과 URL이 원본과 같지 않게 됩니다. 이 플래그는 URL로 해석하지 않고 가능한 한 많이 "
"unescape하려는 URL의 파일 이름 같은 최종 출력을 생성할 때 사용됩니다."

#: cefweaver.types.UriUnescapeRule.REPLACE_PLUS_WITH_SPACE:1 of
msgid "URL queries use \"+\" for space."
msgstr "URL 쿼리는 공백에 \"+\"를 사용합니다."

#: cefweaver.types.UriUnescapeRule.REPLACE_PLUS_WITH_SPACE:3 of
msgid "This flag controls that replacement."
msgstr "이 플래그가 그 치환을 제어합니다."

#: cefweaver.types.enums.UrlrequestFlags:1 of
msgid "Flags used to customize the behavior of :class:`~cefweaver.URLRequest`."
msgstr ":class:`~cefweaver.URLRequest`\\ 의 동작을 사용자 지정하는 데 사용되는 플래그."

#: cefweaver.types.UrlrequestFlags.SKIP_CACHE:1 of
msgid "If set the cache will be skipped when handling the request."
msgstr "설정하면 요청을 처리할 때 캐시를 건너뜁니다."

#: cefweaver.types.UrlrequestFlags.SKIP_CACHE:3 of
msgid ""
"Setting this value is equivalent to specifying the \"Cache-Control: no-cache\" request header. "
"Setting this value in combination with UR_FLAG_ONLY_FROM_CACHE will cause the request to fail."
msgstr ""
"이 값을 설정하는 것은 \"캐시-Control: no-cache\" 요청 헤더를 지정하는 것과 같습니다. 이 값을 UR_FLAG_ONLY_FROM_CACHE와 함께 설정하면 "
"요청이 실패합니다."

#: cefweaver.types.UrlrequestFlags.ONLY_FROM_CACHE:1 of
msgid ""
"If set the request will fail if it cannot be served from the cache (or some equivalent local "
"store)."
msgstr "설정하면 캐시(또는 이에 상응하는 로컬 저장소)에서 제공할 수 없는 경우 요청이 실패합니다."

#: cefweaver.types.UrlrequestFlags.ONLY_FROM_CACHE:3 of
msgid ""
"Setting this value is equivalent to specifying the \"Cache-Control: only-if-cached\" request "
"header. Setting this value in combination with UR_FLAG_SKIP_CACHE or UR_FLAG_DISABLE_CACHE will "
"cause the request to fail."
msgstr ""
"이 값을 설정하는 것은 \"캐시-Control: only-if-cached\" 요청 헤더를 지정하는 것과 같습니다. 이 값을 UR_FLAG_SKIP_CACHE 또는 "
"UR_FLAG_DISABLE_CACHE와 함께 설정하면 요청이 실패합니다."

#: cefweaver.types.UrlrequestFlags.DISABLE_CACHE:1 of
msgid "If set the cache will not be used at all."
msgstr "설정하면 캐시를 전혀 사용하지 않습니다."

#: cefweaver.types.UrlrequestFlags.DISABLE_CACHE:3 of
msgid ""
"Setting this value is equivalent to specifying the \"Cache-Control: no-store\" request header. "
"Setting this value in combination with UR_FLAG_ONLY_FROM_CACHE will cause the request to fail."
msgstr ""
"이 값을 설정하는 것은 \"캐시-Control: no-store\" 요청 헤더를 지정하는 것과 같습니다. 이 값을 UR_FLAG_ONLY_FROM_CACHE와 함께 설정하면 "
"요청이 실패합니다."

#: cefweaver.types.UrlrequestFlags.ALLOW_STORED_CREDENTIALS:1 of
msgid ""
"If set user name, password, and cookies may be sent with the request, and cookies may be saved "
"from the response."
msgstr "설정하면 사용자 이름, 비밀번호, 쿠키가 요청과 함께 전송될 수 있고, 응답의 쿠키가 저장될 수 있습니다."

#: cefweaver.types.UrlrequestFlags.REPORT_UPLOAD_PROGRESS:1 of
msgid "If set upload progress events will be generated when a request has a body."
msgstr "설정하면 요청에 본문이 있을 때 업로드 진행 이벤트가 생성됩니다."

#: cefweaver.types.UrlrequestFlags.NO_DOWNLOAD_DATA:1 of
msgid "If set the :meth:`~cefweaver.URLRequestClient.on_download_data` method will not be called."
msgstr "설정하면 :meth:`~cefweaver.URLRequestClient.on_download_data` 메서드가 호출되지 않습니다."

#: cefweaver.types.UrlrequestFlags.NO_RETRY_ON_5XX:1 of
msgid "If set 5XX redirect errors will be propagated to the observer instead of automatically re-tried."
msgstr "설정하면 5XX 리디렉션 오류가 자동으로 재시도되지 않고 observer에 전달됩니다."

#: cefweaver.types.UrlrequestFlags.NO_RETRY_ON_5XX:3 of
msgid "This currently only applies for requests originated in the browser process."
msgstr "현재는 브라우저 프로세스에서 시작된 요청에만 적용됩니다."

#: cefweaver.types.UrlrequestFlags.STOP_ON_REDIRECT:1 of
msgid ""
"If set 3XX responses will cause the fetch to halt immediately rather than continue through the "
"redirect."
msgstr "설정하면 3XX 응답이 리디렉션을 따라 계속 진행하지 않고 가져오기를 즉시 중단시킵니다."

#: cefweaver.types.enums.V8Propertyattribute:1 of
msgid "V8 property attribute values."
msgstr "V8 속성 값."

#: cefweaver.types.V8Propertyattribute.NONE:1 of
msgid "Writeable, Enumerable, Configurable"
msgstr "쓰기 가능, 열거 가능, 구성 가능"

#: cefweaver.types.V8Propertyattribute.READONLY:1 of
msgid "Not writeable"
msgstr "쓰기 불가능"

#: cefweaver.types.V8Propertyattribute.DONTENUM:1 of
msgid "Not enumerable"
msgstr "열거 불가능"

#: cefweaver.types.V8Propertyattribute.DONTDELETE:1 of
msgid "Not configurable"
msgstr "구성 불가능"

#: cefweaver.types.enums.ValueType:1 of
msgid "Supported value types."
msgstr "지원되는 값 타입."

#: cefweaver.types.enums.WindowOpenDisposition:1 of
msgid "The manner in which a link click should be opened."
msgstr "링크 클릭을 여는 방식."

#: cefweaver.types.enums.WindowOpenDisposition:3 of
msgid ""
"These constants match their equivalents in Chromium's window_open_disposition.h and should not be"
" renumbered."
msgstr "이 상수들은 Chromium의 window_open_disposition.h에 있는 대응 값과 일치하며 번호를 다시 매기면 안 됩니다."

#: cefweaver.types.WindowOpenDisposition.CURRENT_TAB:1 of
msgid "Current tab."
msgstr "현재 탭."

#: cefweaver.types.WindowOpenDisposition.CURRENT_TAB:3 of
msgid "This is the default in most cases."
msgstr "대부분의 경우 기본값입니다."

#: cefweaver.types.WindowOpenDisposition.SINGLETON_TAB:1 of
msgid "Indicate that only one tab with the url should exist in the same window."
msgstr "같은 창에 해당 url의 탭이 하나만 있어야 함을 나타냅니다."

#: cefweaver.types.WindowOpenDisposition.NEW_FOREGROUND_TAB:1 of
msgid "Shift key + Middle mouse button or meta/ctrl key while clicking."
msgstr "클릭하는 동안 Shift 키 + 마우스 가운데 단추 또는 meta/ctrl 키."

#: cefweaver.types.WindowOpenDisposition.NEW_BACKGROUND_TAB:1 of
msgid "Middle mouse button or meta/ctrl key while clicking."
msgstr "클릭하는 동안 마우스 가운데 단추 또는 meta/ctrl 키."

#: cefweaver.types.WindowOpenDisposition.NEW_POPUP:1 of
msgid "New popup window."
msgstr "새 팝업 창."

#: cefweaver.types.WindowOpenDisposition.NEW_WINDOW:1 of
msgid "Shift key while clicking."
msgstr "클릭하는 동안 Shift 키."

#: cefweaver.types.WindowOpenDisposition.SAVE_TO_DISK:1 of
msgid "Alt key while clicking."
msgstr "클릭하는 동안 Alt 키."

#: cefweaver.types.WindowOpenDisposition.OFF_THE_RECORD:1 of
msgid "New off-the-record (incognito) window."
msgstr "새 off-the-record(incognito) 창."

#: cefweaver.types.WindowOpenDisposition.IGNORE_ACTION:1 of
msgid "Special case error condition from the renderer."
msgstr "renderer에서 발생한 특수한 오류 상태."

#: cefweaver.types.WindowOpenDisposition.SWITCH_TO_TAB:1 of
msgid "Activates an existing tab containing the url, rather than navigating."
msgstr "이동하지 않고 해당 url을 포함한 기존 탭을 활성화합니다."

#: cefweaver.types.WindowOpenDisposition.SWITCH_TO_TAB:3 of
msgid ""
"This is similar to SINGLETON_TAB, but searches across all windows from the current profile and "
"anonymity (instead of just the current one); closes the current tab on switching if the current "
"tab was the NTP with no session history; and behaves like CURRENT_TAB instead of "
"NEW_FOREGROUND_TAB when no existing tab is found."
msgstr ""
"SINGLETON_TAB과 비슷하지만, 현재 창만이 아니라 현재 프로필과 익명성이 같은 모든 창에서 찾습니다. 현재 탭이 세션 기록이 없는 NTP였다면 전환할 때 현재 탭을 "
"닫습니다. 기존 탭을 찾지 못하면 NEW_FOREGROUND_TAB이 아니라 CURRENT_TAB처럼 동작합니다."

#: cefweaver.types.WindowOpenDisposition.NEW_PICTURE_IN_PICTURE:1 of
msgid "Create a new document picture-in-picture window showing a child WebView."
msgstr "자식 WebView를 보여 주는 새 document picture-in-picture 창을 만듭니다."

#: cefweaver.types.WindowOpenDisposition.NEW_SPLIT_VIEW:1 of
msgid "Open a link in a split view alongside the current tab."
msgstr "현재 탭 옆의 split view에서 링크를 엽니다."

#: cefweaver.types.enums.XmlEncodingType:1 of
msgid "Supported XML encoding types."
msgstr "지원되는 XML 인코딩 타입."

#: cefweaver.types.enums.XmlEncodingType:3 of
msgid ""
"The parser supports ASCII, ISO-8859-1, and UTF16 (LE and BE) by default. All other types must be "
"translated to UTF8 before being passed to the parser. If a BOM is detected and the correct "
"decoder is available then that decoder will be used automatically."
msgstr ""
"파서는 기본적으로 ASCII, ISO-8859-1, UTF16(LE와 BE)을 지원합니다. 그 밖의 모든 타입은 파서에 전달하기 전에 UTF8로 변환해야 합니다. BOM이 "
"감지되고 올바른 디코더를 사용할 수 있으면 해당 디코더가 자동으로 사용됩니다."

#: cefweaver.types.enums.XmlNodeType:1 of
msgid "XML node types."
msgstr "XML 노드 타입."

#: cefweaver.types.enums.ZoomCommand:1 of
msgid "Specifies the zoom commands supported by :meth:`~cefweaver.BrowserHost.zoom`."
msgstr ":meth:`~cefweaver.BrowserHost.zoom`\\ 이 지원하는 확대/축소 명령을 지정합니다."

#: cefweaver.types.structs.AcceleratedPaintInfo:1 of
msgid "Structure containing shared texture information for the OnAcceleratedPaint callback."
msgstr "OnAcceleratedPaint 콜백을 위한 공유 텍스처 정보를 담은 구조체."

#: cefweaver.types.structs.AcceleratedPaintInfo:3 of
msgid ""
"Resources will be released to the underlying pool for reuse when the callback returns from client"
" code. The CEF value type ``CefAcceleratedPaintInfo``. Anywhere one is expected, a tuple with the"
" same fields works too."
msgstr ""
"콜백이 클라이언트 코드에서 반환되면 리소스는 재사용을 위해 기반 풀로 반환됩니다. CEF 값 타입 ``CefAcceleratedPaintInfo``\\ 입니다. 이 타입이 "
"필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.AcceleratedPaintInfo.planes:1 cefweaver.types.Insets.top:1
#: cefweaver.types.MediaSinkDeviceInfo.ip_address:1 cefweaver.types.Point.x:1
#: cefweaver.types.PopupFeatures.x:1 cefweaver.types.Range.from_:1 cefweaver.types.Rect.x:1
#: cefweaver.types.Size.width:1 of
msgid "Alias for field number 0"
msgstr "필드 번호 0의 별칭"

#: cefweaver.types.AcceleratedPaintInfo.modifier:1 of
msgid "Modifier could be used with EGL driver."
msgstr "EGL 드라이버와 함께 사용할 수 있는 modifier."

#: cefweaver.types.AcceleratedPaintInfo.format:1 of
msgid "The pixel format of the texture."
msgstr "텍스처의 픽셀 형식."

#: cefweaver.types.AcceleratedPaintInfo.extra:1 of
msgid "The extra common info."
msgstr "추가 공통 정보."

#: cefweaver.types.structs.AcceleratedPaintInfoCommon:1 of
msgid "Structure containing shared texture common metadata."
msgstr "공유 텍스처의 공통 메타데이터를 담은 구조체."

#: cefweaver.types.structs.AcceleratedPaintInfoCommon:3 of
msgid ""
"For documentation on each field, please refer to src/media/base/video_frame_metadata.h for actual"
" details. The CEF value type ``CefAcceleratedPaintInfoCommon``. Anywhere one is expected, a tuple"
" with the same fields works too."
msgstr ""
"각 필드에 대한 설명은 실제 세부 사항이 있는 src/media/base/video_frame_metadata.h를 참고하십시오. CEF 값 타입 "
"``CefAcceleratedPaintInfoCommon``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.AcceleratedPaintInfoCommon.timestamp:1 of
msgid "Timestamp of the frame in microseconds since capture start."
msgstr "캡처 시작 이후 프레임의 타임스탬프(마이크로초 단위)."

#: cefweaver.types.AcceleratedPaintInfoCommon.coded_size:1 of
msgid "The full dimensions of the video frame."
msgstr "비디오 프레임의 전체 크기."

#: cefweaver.types.AcceleratedPaintInfoCommon.visible_rect:1 of
msgid "The visible area of the video frame."
msgstr "비디오 프레임의 보이는 영역."

#: cefweaver.types.AcceleratedPaintInfoCommon.content_rect:1 of
msgid "The region of the video frame that capturer would like to populate."
msgstr "캡처러가 채우려는 비디오 프레임의 영역."

#: cefweaver.types.AcceleratedPaintInfoCommon.source_size:1 of
msgid "Full size of the source frame."
msgstr "원본 프레임의 전체 크기."

#: cefweaver.types.AcceleratedPaintInfoCommon.capture_update_rect:1 of
msgid "Updated area of frame, can be considered as the ``dirty`` area."
msgstr "프레임에서 갱신된 영역이며 ``dirty`` 영역으로 볼 수 있습니다."

#: cefweaver.types.AcceleratedPaintInfoCommon.region_capture_rect:1 of
msgid "May reflects where the frame's contents originate from if region capture is used internally."
msgstr "내부적으로 영역 캡처를 사용하는 경우 프레임의 내용이 어디에서 왔는지를 나타낼 수 있습니다."

#: cefweaver.types.AcceleratedPaintInfoCommon.capture_counter:1 of
msgid "The increamental counter of the frame."
msgstr "프레임의 증가 카운터."

#: cefweaver.types.AcceleratedPaintInfoCommon.has_capture_update_rect:1 of
msgid "Optional flag of capture_update_rect"
msgstr "capture_update_rect의 선택적 플래그"

#: cefweaver.types.AcceleratedPaintInfoCommon.has_region_capture_rect:1 of
msgid "Optional flag of region_capture_rect"
msgstr "region_capture_rect의 선택적 플래그"

#: cefweaver.types.AcceleratedPaintInfoCommon.has_source_size:1 of
msgid "Optional flag of source_size"
msgstr "source_size의 선택적 플래그"

#: cefweaver.types.AcceleratedPaintInfoCommon.has_capture_counter:1 of
msgid "Optional flag of capture_counter"
msgstr "capture_counter의 선택적 플래그"

#: cefweaver.types.structs.AcceleratedPaintNativePixmapPlane:1 of
msgid "Structure containing the plane information of the shared texture."
msgstr "공유 텍스처의 plane 정보를 담은 구조체."

#: cefweaver.types.structs.AcceleratedPaintNativePixmapPlane:3 of
msgid ""
"Sync with native_pixmap_handle.h The CEF value type ``CefAcceleratedPaintNativePixmapPlane``. "
"Anywhere one is expected, a tuple with the same fields works too."
msgstr ""
"native_pixmap_handle.h와 동기화합니다. CEF 값 타입 ``CefAcceleratedPaintNativePixmapPlane``\\ 입니다. 이 타입이 "
"필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.AcceleratedPaintNativePixmapPlane.stride:1 of
msgid "The strides and offsets in bytes to be used when accessing the buffers via a memory mapping."
msgstr "메모리 매핑으로 버퍼에 접근할 때 사용할 stride와 오프셋(바이트 단위)."

#: cefweaver.types.AcceleratedPaintNativePixmapPlane.stride:3 of
msgid "One per plane per entry. Size in bytes of the plane is necessary to map the buffers."
msgstr "항목마다 plane당 하나입니다. 버퍼를 매핑하려면 plane의 크기(바이트 단위)가 필요합니다."

#: cefweaver.types.AcceleratedPaintNativePixmapPlane.offset:1 cefweaver.types.Insets.left:1
#: cefweaver.types.MediaSinkDeviceInfo.port:1 cefweaver.types.Point.y:1
#: cefweaver.types.PopupFeatures.x_set:1 cefweaver.types.Range.to:1 cefweaver.types.Rect.y:1
#: cefweaver.types.Size.height:1 of
msgid "Alias for field number 1"
msgstr "필드 번호 1의 별칭"

#: cefweaver.types.AcceleratedPaintNativePixmapPlane.size:1
#: cefweaver.types.BrowserSettings.fixed_font_family:1 cefweaver.types.Insets.bottom:1
#: cefweaver.types.MediaSinkDeviceInfo.model_name:1 cefweaver.types.PopupFeatures.y:1
#: cefweaver.types.Rect.width:1 of
msgid "Alias for field number 2"
msgstr "필드 번호 2의 별칭"

#: cefweaver.types.AcceleratedPaintNativePixmapPlane.fd:1 of
msgid "File descriptor for the underlying memory object (usually dmabuf)."
msgstr "기반 메모리 객체(대개 dmabuf)의 파일 디스크립터."

#: cefweaver.types.structs.AudioParameters:1 of
msgid "Structure representing the audio parameters for setting up the audio handler."
msgstr "audio 핸들러를 설정하기 위한 오디오 매개변수를 나타내는 구조체."

#: cefweaver.types.structs.AudioParameters:3 of
msgid ""
"The CEF value type ``CefAudioParameters``. Anywhere one is expected, a tuple with the same fields"
" works too."
msgstr "CEF 값 타입 ``CefAudioParameters``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.AudioParameters.channel_layout:1 of
msgid "Layout of the audio channels"
msgstr "오디오 채널의 배치"

#: cefweaver.types.AudioParameters.sample_rate:1 of
msgid "Sample rate"
msgstr "샘플 레이트"

#: cefweaver.types.AudioParameters.frames_per_buffer:1 of
msgid "Number of frames per buffer"
msgstr "버퍼당 프레임 수"

#: cefweaver.types.structs.BoxLayoutSettings:1 of
msgid "Settings used when initializing a :class:`~cefweaver.BoxLayout`."
msgstr ":class:`~cefweaver.BoxLayout`\\ 을 초기화할 때 사용하는 설정."

#: cefweaver.types.structs.BoxLayoutSettings:3 of
msgid ""
"The CEF value type ``CefBoxLayoutSettings``. Anywhere one is expected, a tuple with the same "
"fields works too."
msgstr "CEF 값 타입 ``CefBoxLayoutSettings``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.BoxLayoutSettings.horizontal:1 of
msgid "If ``True`` (1) the layout will be horizontal, otherwise the layout will be vertical."
msgstr "``True``\\ (1)이면 레이아웃이 가로이고, 그렇지 않으면 세로입니다."

#: cefweaver.types.BoxLayoutSettings.inside_border_horizontal_spacing:1 of
msgid "Add additional horizontal space between the child view area and the host view border."
msgstr "자식 view 영역과 호스트 view 테두리 사이에 가로 여백을 추가합니다."

#: cefweaver.types.BoxLayoutSettings.inside_border_vertical_spacing:1 of
msgid "Add additional vertical space between the child view area and the host view border."
msgstr "자식 view 영역과 호스트 view 테두리 사이에 세로 여백을 추가합니다."

#: cefweaver.types.BoxLayoutSettings.inside_border_insets:1 of
msgid "Add additional space around the child view area."
msgstr "자식 view 영역 주위에 여백을 추가합니다."

#: cefweaver.types.BoxLayoutSettings.between_child_spacing:1 of
msgid "Add additional space between child views."
msgstr "자식 view 사이에 여백을 추가합니다."

#: cefweaver.types.BoxLayoutSettings.main_axis_alignment:1 of
msgid "Specifies where along the main axis the child views should be laid out."
msgstr "자식 view를 주축을 따라 어디에 배치할지 지정합니다."

#: cefweaver.types.BoxLayoutSettings.cross_axis_alignment:1 of
msgid "Specifies where along the cross axis the child views should be laid out."
msgstr "자식 view를 교차축을 따라 어디에 배치할지 지정합니다."

#: cefweaver.types.BoxLayoutSettings.minimum_cross_axis_size:1 of
msgid "Minimum cross axis size."
msgstr "교차축의 최소 크기."

#: cefweaver.types.BoxLayoutSettings.default_flex:1 of
msgid "Default flex for views when none is specified via :class:`~cefweaver.BoxLayout` methods."
msgstr ":class:`~cefweaver.BoxLayout` 메서드로 지정하지 않았을 때 view에 적용되는 기본 flex."

#: cefweaver.types.BoxLayoutSettings.default_flex:3 of
msgid ""
"Using the preferred size as the basis, free space along the main axis is distributed to views in "
"the ratio of their flex weights. Similarly, if the views will overflow the parent, space is "
"subtracted in these ratios. A flex of 0 means this view is not resized. Flex values must not be "
"negative."
msgstr ""
"선호 크기를 기준으로 하여 주축의 여유 공간을 flex 가중치의 비율대로 View에 분배합니다. 마찬가지로 View가 부모를 넘치면 같은 비율로 공간을 뺍니다. flex가 "
"0이면 이 View의 크기를 조정하지 않는다는 뜻입니다. flex 값은 음수일 수 없습니다."

#: cefweaver.types.structs.BrowserSettings:1 of
msgid "Browser initialization settings."
msgstr "브라우저 초기화 설정."

#: cefweaver.types.structs.BrowserSettings:3 of
msgid ""
"Specify ``None`` or 0 to get the recommended default values. The consequences of using custom "
"values may not be well tested. Many of these and other settings can also configured using "
"command- line switches. The CEF value type ``CefBrowserSettings``. Anywhere one is expected, a "
"tuple with the same fields works too."
msgstr ""
"권장 기본값을 사용하려면 ``None`` 또는 0을 지정합니다. 사용자 지정 값을 사용했을 때의 결과는 충분히 시험되지 않았을 수 있습니다. 이 설정들과 다른 설정 중 "
"상당수는 명령줄 스위치로도 구성할 수 있습니다. CEF 값 타입 ``CefBrowserSettings``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할"
" 수 있습니다."

#: cefweaver.types.BrowserSettings.windowless_frame_rate:1 of
msgid ""
"The maximum rate in frames per second (fps) that :meth:`~cefweaver.RenderHandler.on_paint` will "
"be called for a windowless browser."
msgstr "windowless 브라우저에서 :meth:`~cefweaver.RenderHandler.on_paint`\\ 가 호출되는 최대 속도(초당 프레임 수, fps)."

#: cefweaver.types.BrowserSettings.windowless_frame_rate:3 of
msgid ""
"The actual fps may be lower if the browser cannot generate frames at the requested rate. The "
"minimum value is 1 and the default value is 30. This value can also be changed dynamically via "
":meth:`~cefweaver.BrowserHost.set_windowless_frame_rate`."
msgstr ""
"브라우저가 요청한 속도로 프레임을 생성하지 못하면 실제 fps는 더 낮을 수 있습니다. 최솟값은 1이고 기본값은 30입니다. 이 값은 "
":meth:`~cefweaver.BrowserHost.set_windowless_frame_rate`\\ 로 동적으로 변경할 수도 있습니다."

#: cefweaver.types.BrowserSettings.standard_font_family:1 of
msgid "Font settings."
msgstr "글꼴 설정."

#: cefweaver.types.BrowserSettings.serif_font_family:1 cefweaver.types.Insets.right:1
#: cefweaver.types.PopupFeatures.y_set:1 cefweaver.types.Rect.height:1 of
msgid "Alias for field number 3"
msgstr "필드 번호 3의 별칭"

#: cefweaver.types.BrowserSettings.sans_serif_font_family:1
#: cefweaver.types.PdfPrintSettings.paper_height:1 cefweaver.types.PopupFeatures.width:1
#: cefweaver.types.RequestContextSettings.cookieable_schemes_exclude_defaults:1
#: cefweaver.types.TouchHandleState.mirror_vertical:1 of
msgid "Alias for field number 4"
msgstr "필드 번호 4의 별칭"

#: cefweaver.types.BrowserSettings.cursive_font_family:1 cefweaver.types.PopupFeatures.width_set:1
#: cefweaver.types.TouchHandleState.mirror_horizontal:1 of
msgid "Alias for field number 5"
msgstr "필드 번호 5의 별칭"

#: cefweaver.types.BrowserSettings.fantasy_font_family:1 cefweaver.types.PopupFeatures.height:1 of
msgid "Alias for field number 6"
msgstr "필드 번호 6의 별칭"

#: cefweaver.types.BrowserSettings.default_font_size:1 cefweaver.types.PopupFeatures.height_set:1 of
msgid "Alias for field number 7"
msgstr "필드 번호 7의 별칭"

#: cefweaver.types.BrowserSettings.default_fixed_font_size:1
#: cefweaver.types.PdfPrintSettings.margin_right:1 of
msgid "Alias for field number 8"
msgstr "필드 번호 8의 별칭"

#: cefweaver.types.BrowserSettings.minimum_font_size:1 cefweaver.types.Cookie.expires:1
#: cefweaver.types.PdfPrintSettings.margin_bottom:1 of
msgid "Alias for field number 9"
msgstr "필드 번호 9의 별칭"

#: cefweaver.types.BrowserSettings.minimum_logical_font_size:1
#: cefweaver.types.PdfPrintSettings.margin_left:1 of
msgid "Alias for field number 10"
msgstr "필드 번호 10의 별칭"

#: cefweaver.types.BrowserSettings.default_encoding:1 of
msgid "Default encoding for Web content."
msgstr "웹 콘텐츠의 기본 인코딩."

#: cefweaver.types.BrowserSettings.default_encoding:3 of
msgid ""
"If empty \"ISO-8859-1\" will be used. Also configurable using the \"default-encoding\" command-"
"line switch."
msgstr "비어 있으면 \"ISO-8859-1\"이 사용됩니다. \"default-encoding\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.remote_fonts:1 of
msgid "Controls the loading of fonts from remote sources."
msgstr "원격 소스에서 글꼴을 로드할지 제어합니다."

#: cefweaver.types.BrowserSettings.remote_fonts:3 of
msgid "Also configurable using the \"disable-remote-fonts\" command-line switch."
msgstr "\"disable-remote-fonts\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.javascript:1 of
msgid "Controls whether JavaScript can be executed."
msgstr "JavaScript를 실행할 수 있는지 제어합니다."

#: cefweaver.types.BrowserSettings.javascript:3 of
msgid "Also configurable using the \"disable-javascript\" command-line switch."
msgstr "\"disable-javascript\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.javascript_close_windows:1 of
msgid "Controls whether JavaScript can be used to close windows that were not opened via JavaScript."
msgstr "JavaScript로 열지 않은 창을 JavaScript로 닫을 수 있는지 제어합니다."

#: cefweaver.types.BrowserSettings.javascript_close_windows:3 of
msgid ""
"JavaScript can still be used to close windows that were opened via JavaScript or that have no "
"back/forward history. Also configurable using the \"disable-javascript-close-windows\" command-"
"line switch."
msgstr ""
"JavaScript로 연 창이나 뒤로/앞으로 기록이 없는 창은 여전히 JavaScript로 닫을 수 있습니다. \"disable-javascript-close-"
"windows\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.javascript_access_clipboard:1 of
msgid "Controls whether JavaScript can access the clipboard."
msgstr "JavaScript가 클립보드에 접근할 수 있는지 제어합니다."

#: cefweaver.types.BrowserSettings.javascript_access_clipboard:3 of
msgid "Also configurable using the \"disable-javascript-access-clipboard\" command-line switch."
msgstr "\"disable-javascript-access-clipboard\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.javascript_dom_paste:1 of
msgid "Controls whether DOM pasting is supported in the editor via execCommand(\"paste\")."
msgstr "편집기에서 execCommand(\"paste\")를 통한 DOM 붙여넣기를 지원할지 제어합니다."

#: cefweaver.types.BrowserSettings.javascript_dom_paste:3 of
msgid ""
"The ``javascript_access_clipboard`` setting must also be enabled. Also configurable using the "
"\"disable-javascript-dom-paste\" command-line switch."
msgstr ""
"``javascript_access_clipboard`` 설정도 함께 활성화해야 합니다. \"disable-javascript-dom-paste\" 명령줄 스위치로도 구성할 "
"수 있습니다."

#: cefweaver.types.BrowserSettings.image_loading:1 of
msgid "Controls whether image URLs will be loaded from the network."
msgstr "이미지 URL을 네트워크에서 로드할지 제어합니다."

#: cefweaver.types.BrowserSettings.image_loading:3 of
msgid ""
"A cached image will still be rendered if requested. Also configurable using the \"disable-image-"
"loading\" command-line switch."
msgstr "캐시된 이미지는 요청되면 여전히 렌더링됩니다. \"disable-image-loading\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.image_shrink_standalone_to_fit:1 of
msgid "Controls whether standalone images will be shrunk to fit the page."
msgstr "단독 이미지를 페이지에 맞게 축소할지 제어합니다."

#: cefweaver.types.BrowserSettings.image_shrink_standalone_to_fit:3 of
msgid "Also configurable using the \"image-shrink-standalone-to-fit\" command-line switch."
msgstr "\"image-shrink-standalone-to-fit\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.text_area_resize:1 of
msgid "Controls whether text areas can be resized."
msgstr "텍스트 영역의 크기를 조절할 수 있는지 제어합니다."

#: cefweaver.types.BrowserSettings.text_area_resize:3 of
msgid "Also configurable using the \"disable-text-area-resize\" command-line switch."
msgstr "\"disable-text-area-resize\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.tab_to_links:1 of
msgid "Controls whether the tab key can advance focus to links."
msgstr "탭 키로 링크에 포커스를 이동할 수 있는지 제어합니다."

#: cefweaver.types.BrowserSettings.tab_to_links:3 of
msgid "Also configurable using the \"disable-tab-to-links\" command-line switch."
msgstr "\"disable-tab-to-links\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.local_storage:1 of
msgid "Controls whether local storage can be used."
msgstr "로컬 저장소를 사용할 수 있는지 제어합니다."

#: cefweaver.types.BrowserSettings.local_storage:3 of
msgid "Also configurable using the \"disable-local-storage\" command-line switch."
msgstr "\"disable-local-storage\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.webgl:1 of
msgid "Controls whether WebGL can be used."
msgstr "WebGL을 사용할 수 있는지 제어합니다."

#: cefweaver.types.BrowserSettings.webgl:3 of
msgid ""
"Note that WebGL requires hardware support and may not work on all systems even when enabled. Also"
" configurable using the \"disable-webgl\" command-line switch."
msgstr "WebGL은 하드웨어 지원이 필요하므로 활성화해도 모든 시스템에서 동작하지는 않을 수 있습니다. \"disable-webgl\" 명령줄 스위치로도 구성할 수 있습니다."

#: cefweaver.types.BrowserSettings.background_color:1 of
msgid ""
"Background color used for the browser before a document is loaded and when no document color is "
"specified."
msgstr "문서가 로드되기 전과 문서 색상이 지정되지 않았을 때 브라우저에 사용하는 배경색."

#: cefweaver.types.BrowserSettings.background_color:3 of
msgid ""
"The alpha component must be either fully opaque (0xFF) or fully transparent (0x00). If the alpha "
"component is fully opaque then the RGB components will be used as the background color. If the "
"alpha component is fully transparent for a windowed browser then the "
"``CefSettings``.background_color value will be used. If the alpha component is fully transparent "
"for a windowless (off-screen) browser then transparent painting will be enabled."
msgstr ""
"알파 구성 요소는 완전 불투명(0xFF) 또는 완전 투명(0x00)이어야 합니다. 알파 구성 요소가 완전 불투명이면 RGB 구성 요소가 배경색으로 사용됩니다. 창이 있는 "
"브라우저에서 알파 구성 요소가 완전 투명이면 ``CefSettings``.background_color 값이 사용됩니다. windowless(오프스크린) 브라우저에서 알파 "
"구성 요소가 완전 투명이면 투명 페인팅이 활성화됩니다."

#: cefweaver.types.BrowserSettings.chrome_status_bubble:1 of
msgid "Controls whether the Chrome status bubble will be used."
msgstr "Chrome 상태 버블을 사용할지 제어합니다."

#: cefweaver.types.BrowserSettings.chrome_status_bubble:3 of
msgid ""
"Only supported with Chrome style. For details about the status bubble see "
"https://www.chromium.org/user-experience/status-bubble/"
msgstr ""
"Chrome 스타일에서만 지원됩니다. 상태 버블에 대한 자세한 내용은 https://www.chromium.org/user-experience/status-bubble/ 을 "
"참고하십시오."

#: cefweaver.types.BrowserSettings.chrome_zoom_bubble:1 of
msgid "Controls whether the Chrome zoom bubble will be shown when zooming."
msgstr "확대/축소할 때 Chrome 확대/축소 버블을 표시할지 제어합니다."

#: cefweaver.types.BrowserSettings.chrome_zoom_bubble:3 of
msgid "Only supported with Chrome style."
msgstr "Chrome 스타일에서만 지원됩니다."

#: cefweaver.types.structs.CompositionUnderline:1 of
msgid "Structure representing IME composition underline information."
msgstr "IME 조합 밑줄 정보를 나타내는 구조체."

#: cefweaver.types.structs.CompositionUnderline:3 of
msgid ""
"This is a thin wrapper around Blink's WebCompositionUnderline class and should be kept in sync "
"with that. The CEF value type ``CefCompositionUnderline``. Anywhere one is expected, a tuple with"
" the same fields works too."
msgstr ""
"Blink의 WebCompositionUnderline 클래스를 얇게 감싼 래퍼이며 그 클래스와 동기화를 유지해야 합니다. CEF 값 타입 "
"``CefCompositionUnderline``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.CompositionUnderline.range:1 of
msgid "Underline character range."
msgstr "밑줄 문자 범위."

#: cefweaver.types.CompositionUnderline.color:1 of
msgid "Text color."
msgstr "텍스트 색상."

#: cefweaver.types.CompositionUnderline.background_color:1 of
msgid "Background color."
msgstr "배경색."

#: cefweaver.types.CompositionUnderline.thick:1 of
msgid "Set to ``True`` (1) for thick underline."
msgstr "굵은 밑줄이면 ``True``\\ (1)로 설정합니다."

#: cefweaver.types.CompositionUnderline.style:1 of
msgid "Style."
msgstr "스타일."

#: cefweaver.types.structs.Cookie:1 of
msgid "Cookie information."
msgstr "쿠키 정보."

#: cefweaver.types.structs.Cookie:3 of
msgid ""
"The CEF value type ``CefCookie``. Anywhere one is expected, a tuple with the same fields works "
"too."
msgstr "CEF 값 타입 ``CefCookie``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.Cookie.name:1 of
msgid "The cookie name."
msgstr "쿠키 이름."

#: cefweaver.types.Cookie.value:1 of
msgid "The cookie value."
msgstr "쿠키 값."

#: cefweaver.types.Cookie.domain:1 of
msgid "If ``domain`` is empty a host cookie will be created instead of a domain cookie."
msgstr "``domain``\\ 이 비어 있으면 도메인 쿠키 대신 호스트 쿠키가 만들어집니다."

#: cefweaver.types.Cookie.domain:3 of
msgid ""
"Domain cookies are stored with a leading \".\" and are visible to sub-domains whereas host "
"cookies are not."
msgstr "도메인 쿠키는 앞에 \".\"을 붙여 저장되며 하위 도메인에서 볼 수 있지만, 호스트 쿠키는 그렇지 않습니다."

#: cefweaver.types.Cookie.path:1 of
msgid "If ``path`` is non-empty only URLs at or below the path will get the cookie value."
msgstr "``path``\\ 가 비어 있지 않으면 해당 경로 또는 그 아래에 있는 URL만 쿠키 값을 받습니다."

#: cefweaver.types.Cookie.secure:1 of
msgid "If ``secure`` is ``True`` the cookie will only be sent for HTTPS requests."
msgstr "``secure``\\ 가 ``True``\\ 이면 쿠키는 HTTPS 요청에만 전송됩니다."

#: cefweaver.types.Cookie.httponly:1 of
msgid "If ``httponly`` is ``True`` the cookie will only be sent for HTTP requests."
msgstr "``httponly``\\ 가 ``True``\\ 이면 쿠키는 HTTP 요청에만 전송됩니다."

#: cefweaver.types.Cookie.creation:1 of
msgid "The cookie creation date."
msgstr "쿠키 생성 날짜."

#: cefweaver.types.Cookie.creation:3 of
msgid "This is automatically populated by the system on cookie creation."
msgstr "쿠키를 생성할 때 시스템이 자동으로 채웁니다."

#: cefweaver.types.Cookie.last_access:1 of
msgid "The cookie last access date."
msgstr "쿠키 마지막 접근 날짜."

#: cefweaver.types.Cookie.last_access:3 of
msgid "This is automatically populated by the system on access."
msgstr "접근할 때 시스템이 자동으로 채웁니다."

#: cefweaver.types.Cookie.has_expires:1 of
msgid "The cookie expiration date is only valid if ``has_expires`` is ``True``."
msgstr "쿠키 만료 날짜는 ``has_expires``\\ 가 ``True``\\ 일 때만 유효합니다."

#: cefweaver.types.Cookie.same_site:1 of
msgid "Same site."
msgstr "Same site."

#: cefweaver.types.Cookie.priority:1 of
msgid "Priority."
msgstr "우선순위."

#: cefweaver.types.structs.DraggableRegion:1 of
msgid "Structure representing a draggable region."
msgstr "드래그할 수 있는 영역을 나타내는 구조체."

#: cefweaver.types.structs.DraggableRegion:3 of
msgid ""
"The CEF value type ``CefDraggableRegion``. Anywhere one is expected, a tuple with the same fields"
" works too."
msgstr "CEF 값 타입 ``CefDraggableRegion``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.DraggableRegion.bounds:1 of
msgid "Bounds of the region."
msgstr "영역의 경계."

#: cefweaver.types.DraggableRegion.draggable:1 of
msgid "True (1) this this region is draggable and ``False`` (0) otherwise."
msgstr "True(1)이면 이 영역은 드래그할 수 있고, 그렇지 않으면 ``False``\\ (0)입니다."

#: cefweaver.types.structs.Insets:1 of
msgid "Structure representing insets."
msgstr "인셋(inset)을 나타내는 구조체."

#: cefweaver.types.structs.Insets:3 of
msgid ""
"The CEF value type ``CefInsets``. Anywhere one is expected, a tuple with the same fields works "
"too."
msgstr "CEF 값 타입 ``CefInsets``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.structs.KeyEvent:1 of
msgid "Structure representing keyboard event information."
msgstr "키보드 이벤트 정보를 나타내는 구조체."

#: cefweaver.types.structs.KeyEvent:3 of
msgid ""
"The CEF value type ``CefKeyEvent``. Anywhere one is expected, a tuple with the same fields works "
"too."
msgstr "CEF 값 타입 ``CefKeyEvent``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.KeyEvent.type:1 of
msgid "The type of keyboard event."
msgstr "키보드 이벤트의 타입."

#: cefweaver.types.KeyEvent.modifiers:1 cefweaver.types.MouseEvent.modifiers:1
#: cefweaver.types.TouchEvent.modifiers:1 of
msgid "Bit flags describing any pressed modifier keys."
msgstr "눌린 modifier 키를 나타내는 비트 플래그."

#: cefweaver.types.KeyEvent.modifiers:3 cefweaver.types.MouseEvent.modifiers:3
#: cefweaver.types.TouchEvent.modifiers:3 of
msgid "See cef_event_flags_t for values."
msgstr "값은 cef_event_flags_t를 참고하십시오."

#: cefweaver.types.KeyEvent.windows_key_code:1 of
msgid "The Windows key code for the key event."
msgstr "키 이벤트의 Windows 키 코드."

#: cefweaver.types.KeyEvent.windows_key_code:3 of
msgid ""
"This value is used by the DOM specification. Sometimes it comes directly from the event (i.e. on "
"Windows) and sometimes it's determined using a mapping function. See "
"WebCore/platform/chromium/KeyboardCodes.h for the list of values."
msgstr ""
"이 값은 DOM 사양에서 사용합니다. 이벤트에서 직접 가져오는 경우(예: Windows)도 있고 매핑 함수로 결정하는 경우도 있습니다. 값 목록은 "
"WebCore/platform/chromium/KeyboardCodes.h를 참고하십시오."

#: cefweaver.types.KeyEvent.native_key_code:1 of
msgid "The actual key code genenerated by the platform."
msgstr "플랫폼이 생성한 실제 키 코드."

#: cefweaver.types.KeyEvent.is_system_key:1 of
msgid ""
"Indicate whether the event is considered a \"system key\" event (see http://msdn.microsoft.com"
"/en-us/library/ms646286(VS.85).aspx for details)."
msgstr ""
"이벤트를 \"system key\" 이벤트로 볼지 나타냅니다(자세한 내용은 http://msdn.microsoft.com/en-"
"us/library/ms646286(VS.85).aspx 참고)."

#: cefweaver.types.KeyEvent.is_system_key:3 of
msgid "This value will always be ``False`` on non-Windows platforms."
msgstr "Windows가 아닌 플랫폼에서는 이 값이 항상 ``False``\\ 입니다."

#: cefweaver.types.KeyEvent.character:1 of
msgid "The character generated by the keystroke."
msgstr "키 입력으로 생성된 문자."

#: cefweaver.types.KeyEvent.unmodified_character:1 of
msgid "Same as ``character`` but unmodified by any concurrently-held modifiers (except shift)."
msgstr "``character``\\ 와 같지만 동시에 눌린 modifier(shift 제외)의 영향을 받지 않은 값입니다."

#: cefweaver.types.KeyEvent.unmodified_character:3 of
msgid "This is useful for working out shortcut keys."
msgstr "단축키를 찾아내는 데 유용합니다."

#: cefweaver.types.KeyEvent.focus_on_editable_field:1 of
msgid "True if the focus is currently on an editable field on the page."
msgstr "현재 포커스가 페이지의 편집 가능한 필드에 있으면 True."

#: cefweaver.types.KeyEvent.focus_on_editable_field:3 of
msgid "This is useful for determining if standard key events should be intercepted."
msgstr "표준 키 이벤트를 가로채야 하는지 판단하는 데 유용합니다."

#: cefweaver.types.structs.LinuxWindowProperties:1 of
msgid "Linux window properties, such as X11's WM_CLASS or Wayland's app_id."
msgstr "X11의 WM_CLASS나 Wayland의 app_id 같은 Linux 창 속성."

#: cefweaver.types.structs.LinuxWindowProperties:3 of
msgid ""
"Those are passed to :class:`~cefweaver.WindowDelegate`, so the client can set them for the "
":class:`~cefweaver.Window`'s top-level. Thus, allowing window managers to correctly display the "
"application's information (e.g., icons). The CEF value type ``CefLinuxWindowProperties``. "
"Anywhere one is expected, a tuple with the same fields works too."
msgstr ""
"이 속성들은 :class:`~cefweaver.WindowDelegate`\\ 에 전달되며, 클라이언트는 이를 :class:`~cefweaver.Window`\\ 의 최상위 "
"창에 설정할 수 있습니다. 그러면 창 관리자가 애플리케이션 정보(예: 아이콘)를 올바르게 표시할 수 있습니다. CEF 값 타입 "
"``CefLinuxWindowProperties``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.LinuxWindowProperties.wayland_app_id:1 of
msgid "Main window's Wayland's app_id"
msgstr "주 창의 Wayland app_id"

#: cefweaver.types.LinuxWindowProperties.wm_class_class:1 of
msgid "Main window's WM_CLASS_CLASS in X11"
msgstr "X11에서 주 창의 WM_CLASS_CLASS"

#: cefweaver.types.LinuxWindowProperties.wm_class_name:1 of
msgid "Main window's WM_CLASS_NAME in X11"
msgstr "X11에서 주 창의 WM_CLASS_NAME"

#: cefweaver.types.LinuxWindowProperties.wm_role_name:1 of
msgid "Main window's WM_WINDOW_ROLE in X11"
msgstr "X11에서 주 창의 WM_WINDOW_ROLE"

#: cefweaver.types.structs.MediaSinkDeviceInfo:1 of
msgid "Device information for a MediaSink object."
msgstr "MediaSink 객체의 장치 정보."

#: cefweaver.types.structs.MediaSinkDeviceInfo:3 of
msgid ""
"The CEF value type ``CefMediaSinkDeviceInfo``. Anywhere one is expected, a tuple with the same "
"fields works too."
msgstr "CEF 값 타입 ``CefMediaSinkDeviceInfo``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.structs.MouseEvent:1 of
msgid "Structure representing mouse event information."
msgstr "마우스 이벤트 정보를 나타내는 구조체."

#: cefweaver.types.structs.MouseEvent:3 of
msgid ""
"The CEF value type ``CefMouseEvent``. Anywhere one is expected, a tuple with the same fields "
"works too."
msgstr "CEF 값 타입 ``CefMouseEvent``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.MouseEvent.x:1 cefweaver.types.TouchEvent.x:1 of
msgid "X coordinate relative to the left side of the view."
msgstr "view의 왼쪽을 기준으로 한 X 좌표."

#: cefweaver.types.MouseEvent.y:1 cefweaver.types.TouchEvent.y:1 of
msgid "Y coordinate relative to the top side of the view."
msgstr "view의 위쪽을 기준으로 한 Y 좌표."

#: cefweaver.types.structs.PdfPrintSettings:1 of
msgid "Structure representing PDF print settings."
msgstr "PDF 인쇄 설정을 나타내는 구조체."

#: cefweaver.types.structs.PdfPrintSettings:3 of
msgid ""
"These values match the parameters supported by the DevTools Page.printToPDF function. See "
"https://chromedevtools.github.io/devtools-protocol/tot/Page/#method-printToPDF The CEF value type"
" ``CefPdfPrintSettings``. Anywhere one is expected, a tuple with the same fields works too."
msgstr ""
"이 값들은 DevTools Page.printToPDF 함수가 지원하는 매개변수와 일치합니다. https://chromedevtools.github.io/devtools-"
"protocol/tot/Page/#method-printToPDF 를 참고하십시오. CEF 값 타입 ``CefPdfPrintSettings``\\ 입니다. 이 타입이 필요한 "
"곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.PdfPrintSettings.landscape:1 of
msgid "Set to ``True`` (1) for landscape mode or ``False`` (0) for portrait mode."
msgstr "가로 모드이면 ``True``\\ (1), 세로 모드이면 ``False``\\ (0)로 설정합니다."

#: cefweaver.types.PdfPrintSettings.print_background:1 of
msgid "Set to ``True`` (1) to print background graphics."
msgstr "배경 그래픽을 인쇄하려면 ``True``\\ (1)로 설정합니다."

#: cefweaver.types.PdfPrintSettings.scale:1 of
msgid "The percentage to scale the PDF by before printing (e.g."
msgstr "인쇄하기 전에 PDF를 확대/축소하는 비율(예:"

#: cefweaver.types.PdfPrintSettings.scale:3 of
msgid ".5 is 50%). If this value is less than or equal to zero the default value of 1.0 will be used."
msgstr ".5는 50%). 이 값이 0 이하이면 기본값 1.0이 사용됩니다."

#: cefweaver.types.PdfPrintSettings.paper_width:1 of
msgid "Output paper size in inches."
msgstr "출력 용지 크기(인치 단위)."

#: cefweaver.types.PdfPrintSettings.paper_width:3 of
msgid ""
"If either of these values is less than or equal to zero then the default paper size (letter, 8.5 "
"x 11 inches) will be used."
msgstr "이 값 중 하나라도 0 이하이면 기본 용지 크기(letter, 8.5 x 11인치)가 사용됩니다."

#: cefweaver.types.PdfPrintSettings.prefer_css_page_size:1 of
msgid "Set to ``True`` (1) to prefer page size as defined by css."
msgstr "css에서 정의한 페이지 크기를 우선하려면 ``True``\\ (1)로 설정합니다."

#: cefweaver.types.PdfPrintSettings.prefer_css_page_size:3 of
msgid "Defaults to ``False`` (0), in which case the content will be scaled to fit the paper size."
msgstr "기본값은 ``False``\\ (0)이며, 이 경우 콘텐츠가 용지 크기에 맞게 확대/축소됩니다."

#: cefweaver.types.PdfPrintSettings.margin_type:1 of
msgid "Margin type."
msgstr "여백 타입."

#: cefweaver.types.PdfPrintSettings.margin_top:1 of
msgid "Margins in inches."
msgstr "여백(인치 단위)."

#: cefweaver.types.PdfPrintSettings.margin_top:3 of
msgid "Only used if ``margin_type`` is set to PDF_PRINT_MARGIN_CUSTOM."
msgstr "``margin_type``\\ 이 PDF_PRINT_MARGIN_CUSTOM으로 설정된 경우에만 사용됩니다."

#: cefweaver.types.PdfPrintSettings.page_ranges:1 of
msgid "Paper ranges to print, one based, e.g., '1-5, 8, 11-13'."
msgstr "인쇄할 용지 범위이며 1부터 시작합니다. 예: '1-5, 8, 11-13'."

#: cefweaver.types.PdfPrintSettings.page_ranges:3 of
msgid ""
"Pages are printed in the document order, not in the order specified, and no more than once. "
"Defaults to empty string, which implies the entire document is printed. The page numbers are "
"quietly capped to actual page count of the document, and ranges beyond the end of the document "
"are ignored. If this results in no pages to print, an error is reported. It is an error to "
"specify a range with start greater than end."
msgstr ""
"페이지는 지정한 순서가 아니라 문서 순서대로, 한 번만 인쇄됩니다. 기본값은 빈 문자열이며, 문서 전체를 인쇄한다는 뜻입니다. 페이지 번호는 문서의 실제 페이지 수를 넘으면 "
"조용히 그 수로 제한되고, 문서 끝을 벗어난 범위는 무시됩니다. 그 결과 인쇄할 페이지가 없으면 오류가 보고됩니다. 시작이 끝보다 큰 범위를 지정하면 오류입니다."

#: cefweaver.types.PdfPrintSettings.display_header_footer:1 of
msgid "Set to ``True`` (1) to display the header and/or footer."
msgstr "머리글과 바닥글 또는 그중 하나를 표시하려면 ``True``\\ (1)로 설정합니다."

#: cefweaver.types.PdfPrintSettings.display_header_footer:3 of
msgid "Modify ``header_template`` and/or ``footer_template`` to customize the display."
msgstr "표시를 사용자 지정하려면 ``header_template``\\ 과 ``footer_template`` 또는 그중 하나를 수정합니다."

#: cefweaver.types.PdfPrintSettings.header_template:1 of
msgid "HTML template for the print header."
msgstr "인쇄 머리글의 HTML 템플릿."

#: cefweaver.types.PdfPrintSettings.header_template:3 of
msgid ""
"Only displayed if ``display_header_footer`` is ``True`` (1). Should be valid HTML markup with the"
" following classes used to inject printing values into them:"
msgstr ""
"``display_header_footer``\\ 가 ``True``\\ (1)일 때만 표시됩니다. 인쇄 값을 주입하기 위해 다음 클래스를 사용하는 유효한 HTML "
"마크업이어야 합니다."

#: cefweaver.types.PdfPrintSettings.header_template:6 of
msgid "date: formatted print date"
msgstr "date: 형식이 지정된 인쇄 날짜"

#: cefweaver.types.PdfPrintSettings.header_template:7 of
msgid "title: document title"
msgstr "title: 문서 제목"

#: cefweaver.types.PdfPrintSettings.header_template:8 of
msgid "url: document location"
msgstr "url: 문서 위치"

#: cefweaver.types.PdfPrintSettings.header_template:9 of
msgid "pageNumber: current page number"
msgstr "pageNumber: 현재 페이지 번호"

#: cefweaver.types.PdfPrintSettings.header_template:10 of
msgid "totalPages: total pages in the document"
msgstr "totalPages: 문서의 전체 페이지 수"

#: cefweaver.types.PdfPrintSettings.header_template:12 of
msgid "For example, \"<span class=title></span>\" would generate a span containing the title."
msgstr "예를 들어 \"<span class=title></span>\"은 제목을 담은 span을 생성합니다."

#: cefweaver.types.PdfPrintSettings.footer_template:1 of
msgid "HTML template for the print footer."
msgstr "인쇄 바닥글의 HTML 템플릿."

#: cefweaver.types.PdfPrintSettings.footer_template:3 of
msgid ""
"Only displayed if ``display_header_footer`` is ``True`` (1). Uses the same format as "
"``header_template``."
msgstr "``display_header_footer``\\ 가 ``True``\\ (1)일 때만 표시됩니다. ``header_template``\\ 과 같은 형식을 사용합니다."

#: cefweaver.types.PdfPrintSettings.generate_tagged_pdf:1 of
msgid "Set to ``True`` (1) to generate tagged (accessible) PDF."
msgstr "태그가 지정된(접근 가능한) PDF를 생성하려면 ``True``\\ (1)로 설정합니다."

#: cefweaver.types.PdfPrintSettings.generate_document_outline:1 of
msgid "Set to ``True`` (1) to generate a document outline."
msgstr "문서 개요를 생성하려면 ``True``\\ (1)로 설정합니다."

#: cefweaver.types.structs.Point:1 of
msgid "Structure representing a point."
msgstr "점을 나타내는 구조체."

#: cefweaver.types.structs.Point:3 of
msgid "The CEF value type ``CefPoint``. Anywhere one is expected, a tuple with the same fields works too."
msgstr "CEF 값 타입 ``CefPoint``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.structs.PopupFeatures:1 of
msgid "Popup window features."
msgstr "팝업 창 기능."

#: cefweaver.types.structs.PopupFeatures:3 of
msgid ""
"The CEF value type ``CefPopupFeatures``. Anywhere one is expected, a tuple with the same fields "
"works too."
msgstr "CEF 값 타입 ``CefPopupFeatures``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.PopupFeatures.is_popup:1 of
msgid "True (1) if browser interface elements should be hidden."
msgstr "True(1)이면 브라우저 인터페이스 요소를 숨겨야 합니다."

#: cefweaver.types.structs.Range:1 of
msgid "Structure representing a range."
msgstr "범위를 나타내는 구조체."

#: cefweaver.types.structs.Range:3 of
msgid "The CEF value type ``CefRange``. Anywhere one is expected, a tuple with the same fields works too."
msgstr "CEF 값 타입 ``CefRange``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.structs.Rect:1 of
msgid "Structure representing a rectangle."
msgstr "사각형을 나타내는 구조체."

#: cefweaver.types.structs.Rect:3 of
msgid "The CEF value type ``CefRect``. Anywhere one is expected, a tuple with the same fields works too."
msgstr "CEF 값 타입 ``CefRect``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.structs.RequestContextSettings:1 of
msgid "Request context initialization settings."
msgstr "요청 컨텍스트 초기화 설정."

#: cefweaver.types.structs.RequestContextSettings:3 of
msgid ""
"Specify ``None`` or 0 to get the recommended default values. The CEF value type "
"``CefRequestContextSettings``. Anywhere one is expected, a tuple with the same fields works too."
msgstr ""
"권장 기본값을 사용하려면 ``None`` 또는 0을 지정합니다. CEF 값 타입 ``CefRequestContextSettings``\\ 입니다. 이 타입이 필요한 곳에는 "
"같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.RequestContextSettings.cache_path:1 of
msgid "The directory where cache data for this request context will be stored on disk."
msgstr "이 요청 컨텍스트의 캐시 데이터가 디스크에 저장되는 디렉터리."

#: cefweaver.types.RequestContextSettings.cache_path:3 of
msgid ""
"If this value is non-empty then it must be an absolute path that is either equal to or a child "
"directory of ``CefSettings``.root_cache_path. If this value is empty then browsers will be "
"created in \"incognito mode\" where in-memory caches are used for storage and no profile-specific"
" data is persisted to disk (installation-specific data will still be persisted in "
"root_cache_path). HTML5 databases such as localStorage will only persist across sessions if a "
"cache path is specified. To share the global browser cache and related configuration set this "
"value to match the ``CefSettings``.cache_path value."
msgstr ""
"이 값이 비어 있지 않으면 ``CefSettings``.root_cache_path와 같거나 그 하위 디렉터리인 절대 경로여야 합니다. 이 값이 비어 있으면 메모리 내 캐시를"
" 저장소로 사용하고 프로필별 데이터를 디스크에 유지하지 않는 \"incognito mode\"로 브라우저가 생성됩니다(설치별 데이터는 여전히 root_cache_path에 "
"유지됩니다). localStorage 같은 HTML5 데이터베이스는 캐시 경로를 지정한 경우에만 세션 간에 유지됩니다. 전역 브라우저 캐시와 관련 구성을 공유하려면 이 값을 "
"``CefSettings``.cache_path 값과 같게 설정합니다."

#: cefweaver.types.RequestContextSettings.persist_session_cookies:1 of
msgid ""
"To persist session cookies (cookies without an expiry date or validity interval) by default when "
"using the global cookie manager set this value to ``True`` (1)."
msgstr "전역 쿠키 관리자를 사용할 때 세션 쿠키(만료 날짜나 유효 기간이 없는 쿠키)를 기본적으로 유지하려면 이 값을 ``True``\\ (1)로 설정합니다."

#: cefweaver.types.RequestContextSettings.persist_session_cookies:3 of
msgid ""
"Session cookies are generally intended to be transient and most Web browsers do not persist them."
" Can be set globally using the ``CefSettings``.persist_session_cookies value. This value will be "
"ignored if ``cache_path`` is empty or if it matches the ``CefSettings``.cache_path value."
msgstr ""
"세션 쿠키는 일반적으로 일시적인 용도이며 대부분의 웹 브라우저는 이를 유지하지 않습니다. ``CefSettings``.persist_session_cookies 값으로 "
"전역에서 설정할 수도 있습니다. ``cache_path``\\ 가 비어 있거나 ``CefSettings``.cache_path 값과 같으면 이 값은 무시됩니다."

#: cefweaver.types.RequestContextSettings.accept_language_list:1 of
msgid ""
"Comma delimited ordered list of language codes without any whitespace that will be used in the "
"\"Accept-Language\" HTTP request header and \"navigator.language\" JS attribute."
msgstr "\"Accept-Language\" HTTP 요청 헤더와 \"navigator.language\" JS 속성에 사용할, 공백 없이 쉼표로 구분한 순서 있는 언어 코드 목록."

#: cefweaver.types.RequestContextSettings.accept_language_list:3 of
msgid ""
"Can be set globally using the ``CefSettings``.accept_language_list value. If all values are empty"
" then \"en-US,en\" will be used. This value will be ignored if ``cache_path`` matches the "
"``CefSettings``.cache_path value."
msgstr ""
"``CefSettings``.accept_language_list 값으로 전역에서 설정할 수도 있습니다. 모든 값이 비어 있으면 \"en-US,en\"이 사용됩니다. "
"``cache_path``\\ 가 ``CefSettings``.cache_path 값과 같으면 이 값은 무시됩니다."

#: cefweaver.types.RequestContextSettings.cookieable_schemes_list:1 of
msgid "Comma delimited list of schemes supported by the associated :class:`~cefweaver.CookieManager`."
msgstr "연결된 :class:`~cefweaver.CookieManager`\\ 가 지원하는 scheme을 쉼표로 구분한 목록."

#: cefweaver.types.RequestContextSettings.cookieable_schemes_list:3 of
msgid ""
"If ``cookieable_schemes_exclude_defaults`` is ``False`` (0) the default schemes (\"http\", "
"\"https\", \"ws\" and \"wss\") will also be supported. Not specifying a "
"``cookieable_schemes_list`` value and setting ``cookieable_schemes_exclude_defaults`` to ``True``"
" (1) will disable all loading and saving of cookies. These values will be ignored if "
"``cache_path`` matches the ``CefSettings``.cache_path value."
msgstr ""
"``cookieable_schemes_exclude_defaults``\\ 가 ``False``\\ (0)이면 기본 scheme(\"http\", \"https\", "
"\"ws\", \"wss\")도 지원됩니다. ``cookieable_schemes_list`` 값을 지정하지 않고 "
"``cookieable_schemes_exclude_defaults``\\ 를 ``True``\\ (1)로 설정하면 쿠키의 로드와 저장이 모두 비활성화됩니다. "
"``cache_path``\\ 가 ``CefSettings``.cache_path 값과 같으면 이 값들은 무시됩니다."

#: cefweaver.types.structs.ScreenInfo:1 of
msgid "Screen information used when window rendering is disabled."
msgstr "창 렌더링이 비활성화되었을 때 사용하는 화면 정보."

#: cefweaver.types.structs.ScreenInfo:3 of
msgid ""
"This structure is passed as a parameter to :meth:`~cefweaver.RenderHandler.get_screen_info` and "
"should be filled in by the client. The CEF value type ``CefScreenInfo``. Anywhere one is "
"expected, a tuple with the same fields works too."
msgstr ""
"이 구조체는 :meth:`~cefweaver.RenderHandler.get_screen_info`\\ 에 매개변수로 전달되며 클라이언트가 채워야 합니다. CEF 값 타입 "
"``CefScreenInfo``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.ScreenInfo.device_scale_factor:1 of
msgid "Device scale factor."
msgstr "장치 배율."

#: cefweaver.types.ScreenInfo.device_scale_factor:3 of
msgid "Specifies the ratio between physical and logical pixels."
msgstr "물리 픽셀과 논리 픽셀의 비율을 지정합니다."

#: cefweaver.types.ScreenInfo.depth:1 of
msgid "The screen depth in bits per pixel."
msgstr "화면 깊이(픽셀당 비트 수)."

#: cefweaver.types.ScreenInfo.depth_per_component:1 of
msgid "The bits per color component."
msgstr "색상 구성 요소당 비트 수."

#: cefweaver.types.ScreenInfo.depth_per_component:3 of
msgid "This assumes that the colors are balanced equally."
msgstr "색상이 균등하게 배분되어 있다고 가정합니다."

#: cefweaver.types.ScreenInfo.is_monochrome:1 of
msgid "This can be ``True`` for black and white printers."
msgstr "흑백 프린터에서는 ``True``\\ 일 수 있습니다."

#: cefweaver.types.ScreenInfo.rect:1 of
msgid ""
"This is set from the rcMonitor member of MONITORINFOEX, to whit: \"A RECT structure that "
"specifies the display monitor rectangle, expressed in virtual-screen coordinates."
msgstr "이 값은 MONITORINFOEX의 rcMonitor 멤버에서 가져오며, 즉 다음과 같습니다. \"가상 화면 좌표로 표현한 디스플레이 모니터 사각형을 지정하는 RECT 구조체."

#: cefweaver.types.ScreenInfo.rect:3 of
msgid ""
"Note that if the monitor is not the primary display monitor, some of the rectangle's coordinates "
"may be negative values.\""
msgstr "모니터가 주 디스플레이 모니터가 아니면 사각형의 일부 좌표가 음수일 수 있습니다.\""

#: cefweaver.types.ScreenInfo.available_rect:8 cefweaver.types.ScreenInfo.rect:6 of
msgid ""
"The ``rect`` and ``available_rect`` properties are used to determine the available surface for "
"rendering popup views."
msgstr "``rect``\\ 와 ``available_rect`` 속성은 팝업 view를 렌더링할 수 있는 사용 가능한 표면을 결정하는 데 사용됩니다."

#: cefweaver.types.ScreenInfo.available_rect:1 of
msgid ""
"This is set from the rcWork member of MONITORINFOEX, to whit: \"A RECT structure that specifies "
"the work area rectangle of the display monitor that can be used by applications, expressed in "
"virtual-screen coordinates."
msgstr ""
"이 값은 MONITORINFOEX의 rcWork 멤버에서 가져오며, 즉 다음과 같습니다. \"애플리케이션이 사용할 수 있는 디스플레이 모니터의 작업 영역 사각형을 가상 화면 "
"좌표로 지정하는 RECT 구조체."

#: cefweaver.types.ScreenInfo.available_rect:3 of
msgid ""
"Windows uses this rectangle to maximize an application on the monitor. The rest of the area in "
"rcMonitor contains system windows such as the task bar and side bars. Note that if the monitor is"
" not the primary display monitor, some of the rectangle's coordinates may be negative values\"."
msgstr ""
"Windows는 이 사각형을 사용해 모니터에서 애플리케이션을 최대화합니다. rcMonitor의 나머지 영역에는 작업 표시줄과 사이드바 같은 시스템 창이 있습니다. 모니터가 주"
" 디스플레이 모니터가 아니면 사각형의 일부 좌표가 음수일 수 있습니다\"."

#: cefweaver.types.structs.Size:1 of
msgid "Structure representing a size."
msgstr "크기를 나타내는 구조체."

#: cefweaver.types.structs.Size:3 of
msgid "The CEF value type ``CefSize``. Anywhere one is expected, a tuple with the same fields works too."
msgstr "CEF 값 타입 ``CefSize``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.structs.TaskInfo:1 of
msgid "Structure representing task information provided by :class:`~cefweaver.TaskManager`."
msgstr ":class:`~cefweaver.TaskManager`\\ 가 제공하는 작업 정보를 나타내는 구조체."

#: cefweaver.types.structs.TaskInfo:3 of
msgid ""
"The CEF value type ``CefTaskInfo``. Anywhere one is expected, a tuple with the same fields works "
"too."
msgstr "CEF 값 타입 ``CefTaskInfo``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 사용할 수 있습니다."

#: cefweaver.types.TaskInfo.id:1 of
msgid "The task ID."
msgstr "작업 ID."

#: cefweaver.types.TaskInfo.type:1 of
msgid "The task type."
msgstr "작업 유형."

#: cefweaver.types.TaskInfo.is_killable:1 of
msgid "Set to ``True`` (1) if the task is killable."
msgstr "작업을 종료할 수 있으면 ``True``\\ (1)로 설정됩니다."

#: cefweaver.types.TaskInfo.title:1 of
msgid "The task title."
msgstr "작업 제목."

#: cefweaver.types.TaskInfo.cpu_usage:1 of
msgid "The CPU usage of the process on which the task is running."
msgstr "작업이 실행 중인 프로세스의 CPU 사용량."

#: cefweaver.types.TaskInfo.cpu_usage:3 of
msgid "The value is in the range zero to number_of_processors ``*`` 100%."
msgstr "값의 범위는 0부터 number_of_processors ``*`` 100%까지입니다."

#: cefweaver.types.TaskInfo.number_of_processors:1 of
msgid "The number of processors available on the system."
msgstr "시스템에서 사용할 수 있는 프로세서 수."

#: cefweaver.types.TaskInfo.memory:1 of
msgid "The memory footprint of the task in bytes."
msgstr "작업의 메모리 사용량(바이트 단위)."

#: cefweaver.types.TaskInfo.gpu_memory:3 cefweaver.types.TaskInfo.memory:3 of
msgid "A value of -1 means no valid value is currently available."
msgstr "-1은 현재 유효한 값이 없다는 뜻입니다."

#: cefweaver.types.TaskInfo.gpu_memory:1 of
msgid "The GPU memory usage of the task in bytes."
msgstr "작업의 GPU 메모리 사용량(바이트 단위)."

#: cefweaver.types.TaskInfo.is_gpu_memory_inflated:1 of
msgid ""
"Set to ``True`` (1) if this task process' GPU resource count is inflated because it is counting "
"other processes' resources (e.g, the GPU process has this value set to ``True`` because it is the"
" aggregate of all processes)."
msgstr ""
"이 작업 프로세스의 GPU 리소스 수가 다른 프로세스의 리소스까지 세고 있어 부풀려져 있으면 ``True``\\ (1)로 설정됩니다(예: GPU 프로세스는 모든 프로세스의 "
"합계이므로 이 값이 ``True``\\ 로 설정됩니다)."

#: cefweaver.types.structs.TouchEvent:1 of
msgid "Structure representing touch event information."
msgstr "터치 이벤트 정보를 나타내는 구조체."

#: cefweaver.types.structs.TouchEvent:3 of
msgid ""
"The CEF value type ``CefTouchEvent``. Anywhere one is expected, a tuple with the same fields "
"works too."
msgstr "CEF 값 타입 ``CefTouchEvent``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 쓸 수 있습니다."

#: cefweaver.types.TouchEvent.id:1 of
msgid "Id of a touch point."
msgstr "터치 지점의 ID."

#: cefweaver.types.TouchEvent.id:3 of
msgid ""
"Must be unique per touch, can be any number except -1. Note that a maximum of 16 concurrent "
"touches will be tracked; touches beyond that will be ignored."
msgstr "터치마다 고유해야 하며 -1을 제외한 임의의 숫자일 수 있습니다. 동시에 최대 16개의 터치만 추적되며, 그 이상은 무시됩니다."

#: cefweaver.types.TouchEvent.radius_x:1 of
msgid "X radius in pixels."
msgstr "X 반지름(픽셀 단위)."

#: cefweaver.types.TouchEvent.pressure:3 cefweaver.types.TouchEvent.radius_x:3
#: cefweaver.types.TouchEvent.radius_y:3 cefweaver.types.TouchEvent.rotation_angle:3 of
msgid "Set to 0 if not applicable."
msgstr "해당하지 않으면 0으로 설정합니다."

#: cefweaver.types.TouchEvent.radius_y:1 of
msgid "Y radius in pixels."
msgstr "Y 반지름(픽셀 단위)."

#: cefweaver.types.TouchEvent.rotation_angle:1 of
msgid "Rotation angle in radians."
msgstr "회전 각도(라디안 단위)."

#: cefweaver.types.TouchEvent.pressure:1 of
msgid "The normalized pressure of the pointer input in the range of [0,1]."
msgstr "포인터 입력의 정규화된 압력으로, [0,1] 범위입니다."

#: cefweaver.types.TouchEvent.type:1 of
msgid "The state of the touch point."
msgstr "터치 지점의 상태."

#: cefweaver.types.TouchEvent.type:3 of
msgid ""
"Touches begin with one CEF_TET_PRESSED event followed by zero or more CEF_TET_MOVED events and "
"finally one CEF_TET_RELEASED or CEF_TET_CANCELLED event. Events not respecting this order will be"
" ignored."
msgstr ""
"터치는 CEF_TET_PRESSED 이벤트 하나로 시작해 CEF_TET_MOVED 이벤트가 0개 이상 이어지고, 마지막으로 CEF_TET_RELEASED 또는 "
"CEF_TET_CANCELLED 이벤트 하나로 끝납니다. 이 순서를 지키지 않는 이벤트는 무시됩니다."

#: cefweaver.types.structs.TouchHandleState:1 of
msgid "The CEF value type ``CefTouchHandleState``."
msgstr "CEF 값 타입 ``CefTouchHandleState``\\ 입니다."

#: cefweaver.types.structs.TouchHandleState:3 of
msgid "Anywhere one is expected, a tuple with the same fields works too."
msgstr "이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 쓸 수 있습니다."

#: cefweaver.types.TouchHandleState.touch_handle_id:1 of
msgid "Touch handle id."
msgstr "터치 핸들 ID."

#: cefweaver.types.TouchHandleState.touch_handle_id:3 of
msgid "Increments for each new touch handle."
msgstr "새 터치 핸들마다 증가합니다."

#: cefweaver.types.TouchHandleState.flags:1 of
msgid "Combination of cef_touch_handle_state_flags_t values indicating what state is set."
msgstr "어떤 상태가 설정되었는지 나타내는 cef_touch_handle_state_flags_t 값의 조합."

#: cefweaver.types.TouchHandleState.enabled:1 of
msgid "Enabled state."
msgstr "활성화 상태."

#: cefweaver.types.TouchHandleState.enabled:3 of
msgid "Only set if ``flags`` contains CEF_THS_FLAG_ENABLED."
msgstr "``flags``\\ 에 CEF_THS_FLAG_ENABLED가 포함된 경우에만 설정됩니다."

#: cefweaver.types.TouchHandleState.orientation:1 of
msgid "Orientation state."
msgstr "방향 상태."

#: cefweaver.types.TouchHandleState.orientation:3 of
msgid "Only set if ``flags`` contains CEF_THS_FLAG_ORIENTATION."
msgstr "``flags``\\ 에 CEF_THS_FLAG_ORIENTATION이 포함된 경우에만 설정됩니다."

#: cefweaver.types.TouchHandleState.origin:1 of
msgid "Origin state."
msgstr "원점 상태."

#: cefweaver.types.TouchHandleState.origin:3 of
msgid "Only set if ``flags`` contains CEF_THS_FLAG_ORIGIN."
msgstr "``flags``\\ 에 CEF_THS_FLAG_ORIGIN이 포함된 경우에만 설정됩니다."

#: cefweaver.types.TouchHandleState.alpha:1 of
msgid "Alpha state."
msgstr "알파 상태."

#: cefweaver.types.TouchHandleState.alpha:3 of
msgid "Only set if ``flags`` contains CEF_THS_FLAG_ALPHA."
msgstr "``flags``\\ 에 CEF_THS_FLAG_ALPHA가 포함된 경우에만 설정됩니다."

#: cefweaver.types.structs.URLParts:1 of
msgid "URL component parts."
msgstr "URL 구성 요소."

#: cefweaver.types.structs.URLParts:3 of
msgid ""
"The CEF value type ``CefURLParts``. Anywhere one is expected, a tuple with the same fields works "
"too."
msgstr "CEF 값 타입 ``CefURLParts``\\ 입니다. 이 타입이 필요한 곳에는 같은 필드를 가진 튜플도 쓸 수 있습니다."

#: cefweaver.types.URLParts.spec:1 of
msgid "The complete URL specification."
msgstr "전체 URL 사양."

#: cefweaver.types.URLParts.scheme:1 of
msgid "Scheme component not including the colon (e.g., \"http\")."
msgstr "콜론을 제외한 scheme 구성 요소(예: \"http\")."

#: cefweaver.types.URLParts.username:1 of
msgid "User name component."
msgstr "사용자 이름 구성 요소."

#: cefweaver.types.URLParts.password:1 of
msgid "Password component."
msgstr "비밀번호 구성 요소."

#: cefweaver.types.URLParts.host:1 of
msgid "Host component."
msgstr "호스트 구성 요소."

#: cefweaver.types.URLParts.host:3 of
msgid ""
"This may be a hostname, an IPv4 address or an IPv6 literal surrounded by square brackets (e.g., "
"\"[2001:db8::1]\")."
msgstr "호스트 이름, IPv4 주소, 또는 대괄호로 둘러싸인 IPv6 리터럴(예: \"[2001:db8::1]\")일 수 있습니다."

#: cefweaver.types.URLParts.port:1 of
msgid "Port number component."
msgstr "포트 번호 구성 요소."

#: cefweaver.types.URLParts.origin:1 of
msgid "Origin contains just the scheme, host, and port from a URL."
msgstr "Origin은 URL의 scheme, 호스트, 포트만 포함합니다."

#: cefweaver.types.URLParts.origin:3 of
msgid ""
"Equivalent to clearing any username and password, replacing the path with a slash, and clearing "
"everything after that. This value will be empty for non-standard URLs."
msgstr "사용자 이름과 비밀번호를 지우고, 경로를 슬래시로 바꾸고, 그 뒤의 모든 것을 지우는 것과 같습니다. 표준이 아닌 URL에서는 이 값이 비어 있습니다."

#: cefweaver.types.URLParts.path:1 of
msgid "Path component including the first slash following the host."
msgstr "호스트 뒤의 첫 번째 슬래시를 포함한 경로 구성 요소."

#: cefweaver.types.URLParts.query:1 of
msgid "Query string component (i.e., everything following the '?')."
msgstr "쿼리 문자열 구성 요소(즉, '?' 뒤의 모든 것)."

#: cefweaver.types.URLParts.fragment:1 of
msgid "Fragment (hash) identifier component (i.e., the string following the '#')."
msgstr "프래그먼트(해시) 식별자 구성 요소(즉, '#' 뒤의 문자열)."

