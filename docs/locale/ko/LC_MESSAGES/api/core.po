msgstr "필드 번호 1의 별칭"

#: cefweaver.FocusedNode.bounds:1 cefweaver.StackFrame.line:1 cefweaver.UncaughtException.script_name:1
#: cefweaver.Version.cef_minor:1 cefweaver.renderer_events.FocusedNode.bounds:1
#: cefweaver.renderer_events.StackFrame.line:1
#: cefweaver.renderer_events.UncaughtException.script_name:1 of
msgid "Alias for field number 2"
msgstr "필드 번호 2의 별칭"

#: cefweaver.StackFrame.column:1 cefweaver.UncaughtException.line:1 cefweaver.Version.cef_patch:1
#: cefweaver.renderer_events.StackFrame.column:1 cefweaver.renderer_events.UncaughtException.line:1 of
msgid "Alias for field number 3"
msgstr "필드 번호 3의 별칭"

#: cefweaver.UncaughtException.start_column:1 cefweaver.Version.cef_commit:1
#: cefweaver.renderer_events.UncaughtException.start_column:1 of
msgid "Alias for field number 4"
msgstr "필드 번호 4의 별칭"

#: cefweaver.UncaughtException.end_column:1 cefweaver.Version.chrome_major:1
#: cefweaver.renderer_events.UncaughtException.end_column:1 of
