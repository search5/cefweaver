#: ../../docstring cefweaver._cefweaver.Textfield.get_text:3 of
msgid "The currently displayed text."
msgstr "현재 표시되는 텍스트."

#: ../../docstring cefweaver._cefweaver.Textfield.has_selection:1 of
msgid "Return ``True`` if there is any selected text."
msgstr "선택된 텍스트가 있으면 ``True``\\ 를 반환합니다."

#: ../../docstring cefweaver._cefweaver.Textfield.has_selection:3 of
msgid "``True`` if there is any selected text."
msgstr "선택된 텍스트가 있으면 ``True``\\ 입니다."

