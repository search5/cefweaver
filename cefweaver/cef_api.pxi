class MenuModelDelegate:
    """Implement this interface to handle menu model events. The methods of this
    class will be called on the browser process UI thread unless otherwise
    indicated.
    """

    def execute_command(self, menu_model, command_id, event_flags):
        """Perform the action associated with the specified |command_id| and
        optional |event_flags|.
        """
        return None

    def mouse_outside_menu(self, menu_model, screen_point):
        """Called when the user moves the mouse outside the menu and over the owning
        window.
        """
        return None

    def unhandled_open_submenu(self, menu_model, is_rtl):
        """Called on unhandled open submenu keyboard commands. |is_rtl| will be true
        if the menu is displaying a right-to-left language.
        """
        return None

    def unhandled_close_submenu(self, menu_model, is_rtl):
        """Called on unhandled close submenu keyboard commands. |is_rtl| will be true
        if the menu is displaying a right-to-left language.
        """
        return None

    def menu_will_show(self, menu_model):
        """The menu is about to show."""
        return None

    def menu_closed(self, menu_model):
        """The menu has closed."""
        return None

    def format_label(self, menu_model):
        """Optionally modify a menu item label. Return true if |label| was modified."""
        return False, ""


